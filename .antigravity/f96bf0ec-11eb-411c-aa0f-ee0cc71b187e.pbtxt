              text: "      heroRect.left +"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      (mantleSlotRect.left - heroRect.left) * smoothT +"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      arcAmplitude * parabola;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const currentY ="
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      heroRect.top + (mantleSlotRect.top - heroRect.top) * smoothT;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // Phase 2 progress: p in [0, 1] while pinned on the Mantle section"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const rawP = Math.min(1, Math.max(0, (scrollY - arrivalScrollY) / pinDuration));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    setFlightProgress(rawT);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    setPinProgress(rawP);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // Determine active screen & 3D orientation"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    let targetRotateX = 4;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    let targetRotateY = -8;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    let targetRotateZ = -2;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    let targetScale = 1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (rawT < 1) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      // In Hero or flying along the parabola behind \"\320\224\320\276\321\201\321\202\321\203\320\277\320\275\320\276 \320\275\320\260 \320\262\321\201\320\265\321\205 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262\320\260\321\205\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      targetRotateZ = shouldReduceMotion ? 0 : -3 * (1 - rawT) - 14 * parabola;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      targetRotateY = shouldReduceMotion ? 0 : -18 * (1 - rawT) - 34 * parabola - 22 * rawT;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      targetRotateX = shouldReduceMotion ? 0 : 8 * (1 - rawT) + 20 * parabola + 10 * rawT;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      targetScale = shouldReduceMotion ? 1 : 1 - 0.04 * parabola;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      // While in Hero / early flight, show \320\223\320\273\320\260\320\262\320\275\320\260\321\217; as it emerges into Mantle, ready step 01"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      setActiveStepIndex(0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      setActiveTab(\'home\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    } else {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      // Landed in Mantle! Step through 01 -> 02 -> 03 while Mantle is pinned"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (rawP < 0.34) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const localP = rawP / 0.34;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        setActiveStepIndex(0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        setActiveTab(\'home\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        targetRotateY = shouldReduceMotion ? 0 : -22 + 38 * localP;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        targetRotateX = shouldReduceMotion ? 0 : 10 - 6 * localP;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        targetRotateZ = shouldReduceMotion ? 0 : -2 + 4 * localP;"
