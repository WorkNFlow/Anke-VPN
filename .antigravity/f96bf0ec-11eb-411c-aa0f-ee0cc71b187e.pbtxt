      thinking_signature: "\022\351\021\n\346\021\001i\024}\023U\330t\177\000\317v\343\200I\366J\200\242\005w$\246V\021w\256\245~\270\270\'\374#F\223\3330\371\272\n\325\266\323\03137\347Z\213\201#\351G\353q\374\370\304\'\336\312\330\323wPK%\277\207\245\273x\366\314\245\364\272]|\026\265D\n\255\003\rN+\203\205\'L\030\206\302\251\005\244\326\v\332\376\35509\353u\333C\275\304I$\327-\364\321\206\366U\336\360\334\237\n\355\\l\254\220s\a\330\272\036\f\206\301\244\033q\310\337\350Xj\217\354hR\236\016\216w\202\001S\360\377\'\b1Wa\327hU@D:w(C\r\205}(\230\306\276\266o\025\257\022\fd\315\024`\032<&\0279Kvp\255\376\033\364\336\262a;8\023\333\210\375\031\r\376\035\022\375B\226Y9\310}\233\244\341.\201 \252\262\272Z+\205H\372,\324\017\032w\251|3W\213\325\261\263\312\354\277\016l\330\223\215\233\2261\315$\217cbXT\261\360x\356BR\205\2221n5\031\272HP\036\316ZH\246\335\311\234_\250\236Z?\n\2168\310\352\230%\366\035!\027\347H\r\202\347\227w\a\276\323\362\241\373\"E\375\354\226\232\340\031,th\344\"\246i\330+p\307\376f\277H\342\327\251r$\371\376f\025\312\037\334;f\252G\237\023\016\231\221\255c\344\231\224B\301\240\376\310)\216!\331\3247\307uy\'W\245\243H\004\345$\313\237\002\323\353o\275\376\325m\3414\371!I\376\302\326\207\262 \r\204Q\331\213K\377xf\361\251\371\304\037\273\344\307\003\2308\364X\215\032\344\335GF\004\372\213\022&5}\\\242\td\305\2168U:Q\362\221Y\244\263\247\361z<\3427\350\275\234\330\302$\300b\352u\"C\325O\326q\205\016\217\267\314\364p\235\360N\254\314\274\005\253\200\267\366\030\305`\2636\356\347\254\211Fy\215a\272\372\037l\001\321\332\036\364\227\347\326\243#8tC\360\016\262\030\205\262\265}\313\215\025\250\246\303\234\274y\206\026\337\260}\235v\242\225\215\016\n\246\204\300\307\022\367+4\310(\344\b\342\024\337\217\024\243\210\323\032\372$j\363x(:Zs\345 \207\276\304G7\305\303\377;\223\352\fE\301S\323A\255\227w\r\351D\275\326\025\345\364\032\277\317\311\317A\227*j\376\271?\3215\256\234\213\365\320r\352\310\365\314i\033\r\3716\231\336.\311i\367\"\303G\b3%\216\f\370\245\264\243\025\003\233\311\267\225\"RY\t,b\352\212\no \303@\033\\+\201\211\277\254NU\243\t\346B\345\346\274\330\370\254\227{\251\003^\351\036\"y\267\252G\340\310j\316m\351\022\031\316-\2759\003&\265#\364\345\021\224n9\374\374h\365N\250\260\225#\274\347e\231\177\347\200\003|\000\373\317\273\312\235\275\364\315kS\\\030\021\364\233b%8\265\231\035U~\247\373\212\344Y\270\277\346\375\365\357\006q\320\345@\002\3255\367\364-\237\2059\220\302\375cq\372\031`J\3263\364S\036\272\270\016\004t\307\224\246F\247O\334\356L\363\243!:>\334\274\234>\2465CU\302V\267\217\257\315\231\0318\366\312\236{\ny\251$\257c T\355L[\343\257\027\356\322\264\235\241U\351\342\254DA\340Y2&\t\377\326|\307\376\3409\234\025\016\326A\374\342w\037~\002\342\365\000\214\373\274\315\327\260\353\267;\245y7\364\225\177\231\n\342\207\02119\266EX\273m\t\v\375t\360\210\\l-w\033\235M v\255\263\335od8\231\356V\202\253`pT\213\351\305\337\373\3461<]\314\345F\373\360\350b\b\316\n\201L\365\a\273\264a\2609\261\214g\365\216\027(\231\201:a)]\tc\330 \304\237B\267|\335\236\025\233u\344\263\037\205\223\372\030\314G\271p\341]\322=\267\322[]\212\224\000\302\267\314\244\364\3065\215V\233*\227J\005aw\310[\360\360\361\252rP\364\231\266\261\374m\034\270\026a\217\341\215u\346\212\302\331\311\362\356\256p\005\303\017\364\"\256\252\033\204L\225\262M@\n\336\f\212\307\313*\376\006\272\271\211o\350\323\263\357\200<\0332l\366\262\235\365v\036t\2142\377\374\036\267\240QIt\356\247\253\346\261\226\244\002c\230\023\004$\356\376\337\250\251\353\377\321\363\360\304D\005f\271\227\215\006\225\206\366\266\257zf\031\266\021\032\037\376\232\026zI\346\230\v5\370\t\373\035\343\253\272Q\003P\366U,\037\261\343\3560\275\n\n1\270e\252J\\Dv\221\002)1D\335p\017\311]\273\262Fg\237g\311\325\2452\313\207\311\2231\250\244-\250\253V41\340\232F\311xY\260\212Q\"\25136\246`\3604\2475\236\257\335\220\212~\030\244\354\a)\222\315\177\201p?\225\205\367\216\231i\027\356}\361Wn*\177c~\260\245\241\320\320\355\332\341W\217tf\252r$(V\233y\027XT:\326\315C\322\317\365)d\2251e\271\352\031(s\236I\035\364*\330\026\217\241-M`g/\232\032\024\312\354\263\364\250\245\263B\2357\251\307_!)a\026[\377\232\323\324\2443\214\335s`2\370\237`a\t\221\241\311\306\2559m\311\332?HQ\2569\240\326\233%*\253\017\244\353CUt4\206b\232\264/\026\032\345M\300\312\304\0312(PW4\376\000\220\224\227\336\"\306L\322\005\324\v\n]\263\264N\022c:\261\024?+\260d]\253\031.y\016M\003\214{\351\254z\025z\241\360\222\273G{\343\254=\365\001\333\241z\217R-7\213&\252\246\353\305\305\304\2302\217\310.\352\017\246r\372\331\261\307\351\246?o\261\267N\226\3163\367\277\267x\\*_s\200\232\031\222y\b\245~\371\004\376\360\025!r\177\262\277f\307\022\322\341\004\275pI/\236N\357\017\252\b\376\256\244\362\001R/\000\262\354(}\242\033\370\204B2\227\330\207\222JB\271\255$J\234\a\227WN9\236\301\363\205\030\277wc\226>\371/\275\314\251\217\272!\263{\321\250v\206\tY\256\361\314\345\202FFdjG\301au\377E\236\035[x2\005\'g\242\323\360s\217\271\037\246\323t\322\312\221XBh2\020\323\276gx\034\334\367\025\017y\311(\257@L%\356v\360\246\324\034~\275s\016\277\317\2775UrV\347*j]\321\300\027\346!\231\005\313u\253\025\362\247R\000\244D\341F\347\242;\216\226\177\n\311\027\322\371\017\261\226\340,\303\000ds\202s\352\251f\213L\344\314\214_\363u\205\021\301\000\2144\373\246\240\224\016)f\003\251\370\233\201\262vLqK\246\273h\r\f\240\227\317\204.\204\247\270\207\211S4\270U,\302)b()\251\322\370#V\370j\251j\312\325\265|\200W\032G\301\226(\022\226\177\355D\226\3736B\245\263\354h\252\277\034\351gvq(]\274\250\310\256h9\036o\235\314U\302\364/(\004\201&+B\252q\335g\036Wdn\206o\374\016\333k>\271\264q\n\347\016\004M\267\267\214[\346\311e,\210\020\002\307.\267\316\311^b\376#\324\233!\232\004@\021a\372S\202\212\255\037!\035\261K\261 \350\216s\032K\000O\276)y{\2615\a*\306\031\316s\317\336XW`#\261\\\306\002E7\232H\370\336\212DAIGX\263\313\242,\225\277T\226\371Iq.\345\005\267\371\307\365\340\347e\352wr)\331\245\214uc\020\254\r\017#\255\231yC,\206\200Dw\337K?H\273\255>J\255\232\301\277\316s\305k\277\211\241\272mx\226\032*\025\261Y\"\355\004\316\2