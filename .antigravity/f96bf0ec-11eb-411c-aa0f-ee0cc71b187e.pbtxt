            lines {
              text: "      targetRotateZ = shouldReduceMotion ? 0 : -3 * (1 - rawT) - 14 * parabola;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      targetRotateY = shouldReduceMotion ? 0 : -18 * (1 - rawT) - 34 * parabola - 22 * rawT;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      targetRotateX = shouldReduceMotion ? 0 : 8 * (1 - rawT) + 20 * parabola + 10 * rawT;"
