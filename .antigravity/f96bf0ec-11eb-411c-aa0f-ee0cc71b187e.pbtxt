        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState } from \'react\';\nimport { Navbar } from \'./components/Navbar\';\nimport { HeroMantleChoreography } from \'./components/HeroMantleChoreography\';\nimport { BentoFeatures } from \'./components/BentoFeatures\';\nimport { PricingSection } from \'./components/PricingSection\';\nimport { SupportChatWidget } from \'./components/SupportChatWidget\';\nimport { OFFICIAL_LINKS } from \'./data/vpnData\';\nimport { AnkeLogo } from \'./components/AnkeLogo\';\n\nexport default function App() {\n  const [chatOpenFromSupport, setChatOpenFromSupport] = useState(false);\n\n  return (\n    <div\n      id=\"top\"\n      className=\"min-h-[100dvh] bg-[#111111] text-[#FAFAFA] flex flex-col selection:bg-[#FDE047] selection:text-black\"\n    >\n      {/* Official 3-Zone Top Bar */}\n      <Navbar />\n\n      {/* Main Content */}\n      <main className=\"flex-1\">\n        {/* UNIFIED CHOREOGRAPHY:\n            1. Hero Section (z-10)\n            2. Single 3D iPhone flying along a parabola (z-20)\n            3. Cross-Platform \"\320\224\320\276\321\201\321\202\321\203\320\277\320\275\320\276 \320\275\320\260 \320\262\321\201\320\265\321\205 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262\320\260\321\205\" deck above the iPhone flight (z-30)\n            4. Pinned \"Mantle \342\200\224 \321\217\320\264\321\200\320\276 Anke\" section (steps 01, 02, 03 while pinned, then normal scroll) + \"VLESS \320\277\321\200\320\276\321\202\320\270\320\262 Mantle\" */}\n        <HeroMantleChoreography />\n\n        {/* BENTO GRID FEATURES & OFFICIAL SERVER LIST */}\n        <BentoFeatures />\n\n        {/* PRICING PLANS, 15-DAY REFUND BANNER & SUPPORT */}\n        <PricingSection onOpenChat={() => setChatOpenFromSupport(true)} />\n      </main>\n\n      {/* OFFICIAL FOOTER */}\n      <footer className=\"bg-[#111111] py-12 text-xs text-[#A1A1AA]\">\n        <div className=\"mx-auto max-w-[1200px] px-4 sm:px-6\">\n          <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 pb-8 border-b border-[#2A2A2A]\">\n            <div className=\"flex items-center gap-3 text-sm font-bold text-[#FAFAFA]\">\n              <AnkeLogo className=\"h-6 w-auto\" />\n              <span>Anke</span>\n            </div>\n\n            <div className=\"flex flex-wrap items-center gap-6 text-xs sm:text-sm\">\n              <a\n                href={OFFICIAL_LINKS.pricingPage}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"hover:text-[#FAFAFA] transition-colors\"\n              >\n                \320\246\320\265\320\275\321\213\n              </a>\n              <a\n                href={OFFICIAL_LINKS.privacyPage}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"hover:text-[#FAFAFA] transition-colors\"\n              >\n                \320\237\320\276\320\273\320\270\321\202\320\270\320\272\320\260 \320\272\320\276\320\275\321\204\320\270\320\264\320\265\320\275\321\206\320\270\320\260\320\273\321\214\320\275\320\276\321\201\321\202\320\270\n              </a>\n              <a\n                href={OFFICIAL_LINKS.termsPage}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"hover:text-[#FAFAFA] transition-colors\"\n              >\n                \320\243\321\201\320\273\320\276\320\262\320\270\321\217 \320\270\321\201\320\277\320\276\320\273\321\214\320\267\320\276\320\262\320\260\320\275\320\270\321\217\n              </a>\n              <a\n                href={OFFICIAL_LINKS.refundPage}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"hover:text-[#FAFAFA] transition-colors\"\n              >\n                \320\222\320\276\320\267\320\262\321\200\320\260\321\202 \321\201\321\200\320\265\320\264\321\201\321\202\320\262\n              </a>\n            </div>\n          </div>\n\n          <div className=\"mt-6 flex items-center justify-between text-xs text-[#A1A1AA]\">\n            <p>\n              \302\251 2026 Anke LLC \302\267{\' \'}\n              <a\n                href={OFFICIAL_LINKS.ankeLabs}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"text-[#FDE047] hover:underline\"\n              >\n                ankelabs.com\n              </a>\n            </p>\n          </div>\n        </div>\n      </footer>\n\n      {/* Global Floating Support Chat Widget */}\n      <SupportChatWidget\n        externalOpen={chatOpenFromSupport}\n        onExternalClose={() => setChatOpenFromSupport(false)}\n      />\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/App.tsx"
        }
        overwrite: true
      }
    }
