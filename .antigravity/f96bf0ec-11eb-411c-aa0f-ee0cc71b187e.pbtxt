  planner_response {
    response: "\320\233\320\265\320\275\320\264\320\270\320\275\320\263 \320\277\320\276\320\273\320\275\320\276\321\201\321\202\321\214\321\216 \320\276\320\261\320\275\320\276\320\262\320\273\320\265\320\275 \321\201\321\202\321\200\320\276\320\263\320\276 \320\277\320\276 \320\264\320\260\320\275\320\275\321\213\320\274 \320\276\321\204\320\270\321\206\320\270\320\260\320\273\321\214\320\275\320\276\320\263\320\276 \321\201\320\260\320\271\321\202\320\260 **anke.dev/vnp/ru/** \320\261\320\265\320\267 \320\262\321\213\320\264\321\203\320\274\320\260\320\275\320\275\320\276\320\271 \321\202\320\265\321\205\320\275\320\270\321\207\320\265\321\201\320\272\320\276\320\271 \321\202\320\265\321\200\320\274\320\270\320\275\320\276\320\273\320\276\320\263\320\270\320\270 \320\270 \321\201 \321\200\320\260\321\201\321\210\320\270\321\200\320\265\320\275\320\275\320\276\320\271 \321\205\320\276\321\200\320\265\320\276\320\263\321\200\320\260\321\204\320\270\320\265\320\271 \320\260\320\275\320\270\320\274\320\260\321\206\320\270\320\271:\n\n1. **\320\236\321\204\320\270\321\206\320\270\320\260\320\273\321\214\320\275\321\213\320\271 \320\273\320\276\320\263\320\276\321\202\320\270\320\277 \320\270 \320\263\321\200\320\260\321\204\320\270\320\272\320\260**:\n   - \320\241\320\272\320\260\321\207\320\260\320\275 \320\276\321\200\320\270\320\263\320\270\320\275\320\260\320\273\321\214\320\275\321\213\320\271 \320\262\320\265\320\272\321\202\320\276\321\200\320\275\321\213\320\271 \320\273\320\276\320\263\320\276\321\202\320\270\320\277 `Logo.svg` (`/public/logo.svg`) \320\270 \321\204\320\273\320\260\320\263\320\270 \320\262\321\201\320\265\321\205 \320\276\321\204\320\270\321\206\320\270\320\260\320\273\321\214\320\275\321\213\321\205 \320\273\320\276\320\272\320\260\321\206\320\270\320\271 (`/public/countries/*.png`).\n2. **\320\242\320\276\321\207\320\275\320\276\320\265 \321\201\320\276\320\276\321\202\320\262\320\265\321\202\321\201\321\202\320\262\320\270\320\265 \321\20