      arguments_json: "{\"CodeContent\":\"export interface OfficialServer {\\n  id: string;\\n  country: string;\\n  city: string;\\n  flagUrl: string;\\n  tag?: {\\n    name: string;\\n    note: string;\\n  };\\n}\\n\\nexport interface OfficialTerm {\\n  months: number;\\n  label: string;\\n  priceDisplay: string;\\n  perMonthDisplay: string;\\n  discountPercent: number;\\n}\\n\\nexport interface MantleBenchmarkRow {\\n  id: string;\\n  metric: string;\\n  subtitle: string;\\n  iphone: {\\n    label: string;\\n    mantlePercent: number;\\n    vlessPercent: number;\\n  };\\n  android: {\\n    label: string;\\n    mantlePercent: number;\\n    vlessPercent: number;\\n  };\\n}\\n\\n// 8 Verified Official Production Servers from anke.dev/vnp/ru/servers\\nexport const OFFICIAL_SERVERS: OfficialServer[] = [\\n  {\\n    id: \'de-nue\',\\n    country: \'\320\223\320\265\321\200\320\274\320\260\320\275\320\270\321\217\',\\n    city: \'\320\235\321\216\321\200\320\275\320\261\320\265\321\200\320\263\',\\n    flagUrl: \'/countries/de.png\',\\n  },\\n  {\\n    id: \'fi-hel\',\\n    country: \'\320\244\320\270\320\275\320\273\321\217\320\275\320\264\320\270\321\217\',\\n    city: \'\320\245\320\265\320\273\321\214\321\201\320\270\320\275\320\272\320\270\',\\n    flagUrl: \'/countries/fi.png\',\\n  },\\n  {\\n    id: \'pl-waw\',\\n    country: \'\320\237\320\276\320\273\321\214\321\210\320\260\',\\n    city: \'\320\222\320\260\321\200\321\210\320\260\320\262\320\260\',\\n    flagUrl: \'/countries/pl.png\',\\n  },\\n  {\\n    id: \'nl-ams\',\\n    country: \'\320\235\320\270\320\264\320\265\321\200\320\273\320\260\320\275\320\264\321\213\',\\n    city: \'\320\220\320\274\321\201\321\202\320\265\321\200\320\264\320\260\320\274\',\\n    flagUrl: \'/countries/nl.png\',\\n  },\\n  {\\n    id: \'ie-dub\',\\n    country: \'\320\230\321\200\320\273\320\260\320\275\320\264\320\270\321\217\',\\n    city: \'\320\224\321\203\320\261\320\273\320\270\320\275\',\\n    flagUrl: \'/countries/irel