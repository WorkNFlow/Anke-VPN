\321\200\320\266\320\272\320\276\320\271 \320\270 \320\260\320\272\321\202\320\270\320\262\320\270\321\200\321\203\320\271\321\202\320\265 \321\202\321\203\320\275\320\275\320\265\320\273\321\214\',\\n    ],\\n  },\\n  {\\n    id: \'android\',\\n    name: \'Google Play\',\\n    subtitle: \'Android-\321\201\320\274\320\260\321\200\321\202\321\204\320\276\320\275\321\213, \320\277\320\273\320\260\320\275\321\210\320\265\321\202\321\213 \320\270 Android TV\',\\n    version: \'v2.8.2\',\\n    requirements: \'Android 9.0+ \302\267 ARM64 / TV\',\\n    badgeText: \'\320\224\320\276\321\201\321\202\321\203\320\277\320\275\320\276 \320\262 Google Play\',\\n    fileName: \'AnkeVPN-Android-arm64-2.8.2.apk\',\\n    fileSize: \'29.1 \320\234\320\221\',\\n    steps: [\\n      \'\320\243\321\201\321\202\320\260\320\275\320\276\320\262\320\270\321\202\320\265 \320\277\321\200\320\270\320\273\320\276\320\266\320\265\320\275\320\270\320\265 \320\270\320\267 Google Play \320\270\320\273\320\270 \320\267\320\260\320\263\321\200\321\203\320\267\320\270\321\202\320\265 \320\277\321\200\321\217\320\274\320\276\320\271 APK-\321\204\320\260\320\271\320\273\',\\n      \'\320\222\320\272\320\273\321\216\321\207\320\270\321\202\320\265 \321\204\321\203\320\275\320\272\321\206\320\270\321\216 \321\200\320\260\320\267\320\264\320\265\320\273\321\214\320\275\320\276\320\263\320\276 \321\202\321\203\320\275\320\275\320\265\320\273\320\270\321\200\320\276\320\262\320\260\320\275\320\270\321\217 \320\264\320\273\321\217 \320\261\320\260\320\275\320\272\320\276\320\262\321\201\320\272\320\270\321\205 \320\277\321\200\320\270\320\273\320\276\320\266\320\265\320\275\320\270\320\271 \320\240\320\244\',\\n      \'\320\237\320\276\320\264\320\272\320\273\321\216\321\207\320\270\321\202\320\265\321\201\321\214 \320\262 \320\276\320\264\320\275\320\276 \320\272\320\260\321\201\320\260\320\275\320\270\320\265 \321\207\320\265\321\200\320\265\320\267 \320\277\321\200\320\276\321\202\320\276\320\272\320\276\32