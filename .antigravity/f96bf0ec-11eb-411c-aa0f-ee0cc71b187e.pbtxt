        instruction: "import React from \'react\';\nimport { AnkeLogo } from \'./AnkeLogo\';\nimport { OFFICIAL_LINKS } from \'../data/vpnData\';\n\ninterface NavbarProps {\n  activeSection: string;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({ activeSection }) => {\n  const navItems = [\n    { id: \'top\', label: \'\320\223\320\273\320\260\320\262\320\275\320\260\321\217\', href: \'#top\' },\n    { id: \'platforms\', label: \'\320\243\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262\320\260\', href: \'#platforms\' },\n    { id: \'mantle\', label: \'\320\257\320\264\321\200\320\276 Mantle\', href: \'#mantle\' },\n    { id: \'features\', label: \'\320\241\320\277\320\270\321\201\320\276\320\272 \321\201\320\265\321\200\320\262\320\265\321\200\320\276\320\262\', href: \'#features\' },\n    { id: \'pricing\', label: \'\320\246\320\265\320\275\321\213\', href: \'#pricing\' },\n    { id: \'support\', label: \'\320\237\320\276\320\264\320\264\320\265\321\200\320\266\320\272\320\260\', href: \'#support\' },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-40 w-full border-b border-[#2A2A2A] bg-[#111111]/85 backdrop-blur-xl\">\n      <div className=\"mx-auto flex max-w-[1200px] items-center justify-between gap-8 px-4 py-3.5 sm:px-6\">\n        {/* Zone 1: Official Brand Lockup */}\n        <a\n          href=\"#top\"\n          className=\"group flex items-center gap-3 text-lg font-bold tracking-tight text-[#FAFAFA] whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-[#FDE047]\"\n        >\n          <AnkeLogo className=\"h-7 w-auto transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110 group-hover:-rotate-6\" />\n          <span>Anke</span>\n        </a>\n\n        {/* Zone 2: Official Navigation Links with Dynamic Scroll Highlighting */}\n        <nav aria-label=\"\320\236\321\201\320\275\320\276\320\262\320\275\320\260\321\217 \320\275\320\260\320\262\320\270\320\263\320\260\321\206\320\270\321\217\" className=\"hidden md:flex items-center gap-7 text-sm font-medium\">\n          {navItems.map((item) => {\n            const isActive = activeSection === item.id;\n            return (\n              <a\n                key={item.id}\n                href={item.href}\n                className={`transition-colors duration-200 whitespace-nowrap shrink-0 underline-offset-4 hover:underline ${\n                  isActive\n                    ? \'text-[#FDE047] font-semibold drop-shadow-[0_0_8px_rgba(253,224,71,0.4)]\'\n                    : \'text-[#A1A1AA] hover:text-[#FAFAFA]\'\n                }`}\n              >\n                {item.label}\n              </a>\n            );\n          })}\n        </nav>\n\n        {/* Zone 3: Official Primary Action (\"\320\222\320\276\320\271\321\202\320\270\") */}\n        <div className=\"flex items-center shrink-0\">\n          <a\n            href={OFFICIAL_LINKS.appLogin}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"tactile-btn rounded-xl bg-[#FDE047] px-5 py-2 text-xs sm:text-sm font-bold text-black hover:bg-[#FDE047]/90 shadow-[0_0_20px_rgba(253,224,71,0.2)] whitespace-nowrap shrink-0 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FDE047]\"\n          >\n            \320\222\320\276\320\271\321\202\320\270\n          </a>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/Navbar.tsx"
        }
        overwrite: true
      }
    }
