              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      title: \'02. \320\237\321\200\320\265\320\274\320\270\321\203\320\274 \321\201\320\265\321\200\320\262\320\265\321\200\321\213 \320\270 YouTube \320\261\320\265\320\267 \321\200\320\265\320\272\320\273\320\260\320\274\321\213\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
