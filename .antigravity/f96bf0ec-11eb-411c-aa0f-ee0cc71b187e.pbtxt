            }
            lines {
              text: "      targetScale = shouldReduceMotion ? 1 : 1 - 0.04 * parabola;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      // While in Hero / early flight, show \320\223\320\273\320\260\320\262\320\275\320\260\321\217; as it emerges into Mantle, ready step 01"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      setActiveStepIndex(0);"
