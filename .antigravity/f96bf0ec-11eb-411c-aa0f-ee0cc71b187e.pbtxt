      thinking_signature: "\022\257\f\n\254\f\001i\024}\023\250h\201\203O\265\240\3651\311>\260\212\023s\006)\226~\301_\033:,>M\374\215lM\343\334n\266\000\024x\037q\223\235}\016\246\004\"\036\227\214\231Y\210\335\250\220\312\017\367T\273!;\371\342\223p\363\245\356[\0368}N\'\240\331$Z\"\024i\322{J\225H\247\033\255\021\316\317\f\260\316\210\245\224+\257\247*\246n\300g\342`<g\223z\257\t\201\224\372\230]\342\221\256\301\337K\320\206\223\234M\r8d\250\222LF\321\371\250EQ,*\257\311\354\330\372\"\312\264\337\371\b.S\376O\326\023\333W \322\356\205S\222mo\375X\262l\276^\375\266\231/.\204\240OX &\333\316\301\237n<\002\234\210\005\250\201\260\324\210\321[\233#\374\022\025\214E\n\305\312\f}\377\322!\027\226\351\343GN\360y{C\361p\330&tU\305\200\205\201\375\306p\213r\345\350\262C\207M\312@\326\272\261\310\200\2068\272\360\021Zf\332$\357\005k\024\255R\27147.*\023\314p66\374\271ND\357X\252qb\217\0311K\254E\347\237\301=H\271\324F\002\177}i\302\211\313\245\023\004\005\373\021\344\300\351k\342\v\340.\343\2478\241\213YzOz\224T<\231B\217l\355\331\036\020\363\353\277\230M\323\220|.\004\263<s\341)\373=zC\364Z\000\310*w\"\361\321v9\206\236EA\257H\333\353wp\201\363\301\367)Nx7\306\272(O\256\331\216\237\205\001\006\233wx\251\304\326\251Q\200gr\017\311\'\205\327\365\360\330S\347\037A\0267\244=\n\3025\b\025\263\00236-\272\231\aXDR\031W\301\256\261R+M\325\3157\'D\373{3\376<n\334<\263\233\317\237\277\210H\021\250C\\Yb\346\217AbY\300\212\375\310\250\306\375\f\240\255\220O\330U\333\006\2676\320Y\3550{\275\371\022~\204\214\365-4E\3635;\365\016c\244\350.\004\355\avM\362\317V\303[\344\372\215\255R\232\300\036\373\362P\231\372\003\216\266C\304\254\204\341m/_w\310=83d\303\376\304S\377d\221\"J\324pe\274.\361\277mA\006\331\035\362\3243\\N\307PC\000\256\214\3527;\221\016\376g\361\300\373\304\275\3137\210\3342\204.\211:C\304\0052\255\001Be\006Y\337\225\fS\031\245\250\324\225*3r\377\331\233\370\326\031\003Z\016\277\314\323\375t\004\352O\344\024\301\304?\003l\377{?\206m\221\273\034r\342W\026m,\225a\351\027\264\274\270\030`;\273\003|\347\005`Y\324\376\375l\374M\317\034d\253\324>w\2065>f\345\206\330\376u\037\212\0231\aS\310\252\324\315I\334x\343\216-\337\321<\033\227~\256\362\227\253H~\fsWP\330\230p\222.V\363N\342X\306Q(8!\363I\035\203X\362!\222\357\310P=\205+\326\373\b\372\001\2506\021\324\370d&\034\026d\344\256\214\265\300r\334\300\271k\320\302\221\367\2109/\202\302\211=9\336\311m\016\001r\227\312\231]\354\277\326\251\2358\354\231\031v\335o\226\330C\275\301\327\363\305\017GD\200e\237\254%Z\346<$1\332v\341\224\te\026\205\372\"\201\3262VN\376F\245y^\271Fg\245s)k=\002\247\022\274p\217f\343\277\232\355\r\361\277\v@\027\271h9\021\276Bw\301\t?/\265N`\a\342\245n\201\214x\265\234\275\375\221\210gN\371-1\217\221\246D\177y8\325Y\276\327\"\307,=\207\234\264\321\016Xi\023\0252\216\274z\252 \247(\265\362\276\243^\004E\307/\330Sw\336!-\345\177\322U\370>\2465\340\\.\034U\352\342+\322\\\255f\332\313\204\t\020(\'\353\346\002\230\247\223\332.\235\316\311b\352\375\002\f\311\374^\2554\343\247N\v2\3150\331\027\213\222\215w>\361\003\272f\034(\206\363\211xT0(\243\021rf\350\332\b\222u9n\246\036\362\017\325\030\375\021dV\033\215s\214\254\330\341\365\242\205L\t\177\fK\371\273]~\201\251\350\211e\034{\261\240\340u]K\203\342\351\260\234\232e\263Bs;\363\235\251\231\346\026\304\374\024o\003_\230\3324\340\371C\207\325\242TS\323\310\030w\335\217\377\204\253\036\032P\314\021\030^\312\262\\\277[>\3673\263]\003%7\2315\346\004T\324\302!\b\224Z\004B\024\241w\177ALz*\205\307\205< \003\'&i\342\315\263\356\253lz\262k\005\372S\003o/n\241J\000\275\2647\025p~\277P*!\320\f\273X\202\252O\310P[\277\372W\235so\350!}b\222\273\030\231+b\232z\324\230\237m<\300\0165/\200\363\225`\255\224!+\032\210\350h\274*\364%\210\215\234\274\215\302\006l\242\320\2246\005f\033mM\255\204\022\204\220\f\267d1\177\335\312\"?C\317\035\3334\206A\203( <\017\352rsO\343K\260\253\356\327\256A#\"G\313\241{\213>\313!\036\244c\357\353\303\020\365Z\211)+\"\a\237}]~3\326M\325\263\3420\372\355l4M\003m\362y\230\3427&\332T\033\347\312\203\037\303\311\266\302lX\255\312\347\215\273,\002WE\t\344\236\226+\003\355\220\307\257\256\227g6\034+\371\3366W\223kb\005\253=D\a\261\272\243\353qS\364\260g\352P\321\377\316\006W\020\210ig\345\003G\a\273\253\361\376VB\023\255{\264\335\320\264g\261=\375*f6\0059\004\033\345\330:85h\263\205\342\200\032whh\253K\320\223\326\r-AR\362M\v?f\300\334\tp\210\320Q\215$\006\304\351\022CQ\225\220R\034g\223[\345\205_F\215-\025\232]\211e:1\316\230\376\343\304\a\0021\366\317/O\350\206\354\3321\237\334\332"
