      thinking_signature: "\022\375\030\n\372\030\001i\024}\023\356&\261\246\216\267\000\350_=\303\226^Tv\221SKm\275\306\300\364\311\213A\022E(\v\223%\026\303\027j}\237\260\343\213\266D\267M\327\375\371\300!n\345\234\351\002\214\263\233\301\270z5\371:\343=\003\327\211\224\3367x\024\3215\342\272\333\316\024\002\256?7\315\273N\005\371\253\271\264\030I\023\200\276|\365\223\022\321B\f\230@\031~ \226p2\263}\341\342\217T\355S2\362%|\335zb\341d:m\322\003\034M\305\322-Y\225\214\241\252\v\333S\036\274u4q\034:-#\226\335\t\027>Dx\357\327,\247\270\277\377\304\312\216Uk\325Y\034\373\263\222\204\376\2131\356[\334\243#\246)\3025\347\213\313H\207\v\304/\314r\260\216\017+\214\337\r\331B\222\fw\204-c\270\305O\'X\251|\332ig*\216\3475\032\227\364\261\273|q\025\317\310\273\221\273\354\3321A+ \241#N\260q\324Cc\022\251\274\245!\206\nE\\\200?\311\275\340\224h\361\327!\321V)\036Y?\336\264\3019\026\252\306\027|O\003\2157B\254\340?\205}\273\303\3625\356W\2362\235nV\"\304\221\003M\324\323I\"\356\365\021\243P\324s\361(\006\261\377\305h\241.%|\332\t\323\037&S\261\366\305Lo\253l\2406~x?%\212*\241\343\227\317\210\371TB\345\244\213\363Rc\373\324m\020\336\003\027\n\226\f\2676\341\327\3362\262\357Y\257\220\v\177\372\352\242\203fU\'\230\'\255\235Z\377\256\351\b\032\037*\365\243\227\242\370\367\322Qu\273\352La6\345%\272\002\325%\254W\246\n8\304\210\030w\272\353ZF?JF\243#\211\025\200\264\352\r\270\241\374\020\305\341\225\245Q\r\tI\270\237\251#!\3426\206J\033\016\000\273\221\245\002\016\311\n\361\270E\343\333,\237/\022W\020\251\3426\260A\277r&\223\212\006cq\270\037y\316\031\2610\315u\277kc6\274\362\215\003\346-\211\364\"\214\370^\353\001\032\307`I\233\024\325\035M5\257\337\261\'\322\024V\227\177\247z\331nx\225d5\334)v.\315\311\253\213o\a#We\245R\'\177(\221\000l\207i+\366\372$\231\222\353\224A\356-\305\3205&@/\335\002+k+b\262\363\371\"\376\214\314\360\274\313y\2732\226\374\373r\221\302\031\341\313\212-\226\311\306p\356\354n\324\327\347\036\261n\036[\263\254^o\020\260\325\350\210\226qs\203\200\034\330\2246