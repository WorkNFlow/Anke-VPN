            }
            lines {
              text: "      setActiveTab(\'home\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    } else {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      // Landed in Mantle! Step through 01 -> 02 -> 03 while Mantle is pinned"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (rawP < 0.34) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const localP = rawP / 0.34;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        setActiveStepIndex(0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
