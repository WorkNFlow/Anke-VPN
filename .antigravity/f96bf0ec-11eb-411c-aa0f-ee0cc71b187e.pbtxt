    command_line: "curl -sL \"https://anke.dev/vnp/ru/pricing\" | grep -A 80 \'id=\"view-\' && mkdir -p public/countries && for f in de.png fi.png pl.png nl.png ireland.png albania.png us.png hk.png; do curl -sL \"https://anke.dev/vpn/countries_icons/$f\" -o \"public/countries/$f\"; done"
