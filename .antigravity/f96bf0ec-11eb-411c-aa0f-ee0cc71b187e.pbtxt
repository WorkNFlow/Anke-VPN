217\320\265\321\202 \321\200\320\276\321\201\321\201\320\270\320\271\321\201\320\272\320\270\320\265 \320\261\320\260\320\275\320\272\320\270 \320\270 \320\273\320\276\320\272\320\260\320\273\321\214\320\275\321\213\320\265 \321\201\320\265\321\200\320\262\320\270\321\201\321\213 \320\275\320\260\320\277\321\200\321\217\320\274\321\203\321\216 \320\261\320\265\320\267 \320\276\321\202\320\272\320\273\321\216\321\207\320\265\320\275\320\270\321\217 \320\267\320\260\321\211\320\270\321\202\321\213.\n                </p>\n              </div>\n\n              <div className=\"mt-8 rounded-xl border border-[#2A2A2A] bg-[#141414] p-4\">\n                <div className=\"text-xs font-mono text-[#A1A1AA] mb-3\">\n                  \320\241\321\205\320\265\320\274\320\260 \321\203\320\274\320\275\320\276\320\271 \320\274\320\260\321\200\321\210\321\200\321\203\321\202\320\270\320\267\320\260\321\206\320\270\320\270 \321\202\321\200\320\260\321\204\320\270\320\272\320\260\n                </div>\n                <div className=\"space-y-2 text-xs font-mono\">\n                  <div className=\"flex items-center justify-between rounded-md bg-[#1A1A1A] px-3 py-2 border border-[#2A2A2A]\">\n                    <span className=\"text-[#FAFAFA]\">YouTube / AI / \320\227\320\260\321\200\321\203\320\261\320\265\320\266\320\275\321\213\320\265 \321\201\320\265\321\200\320\262\320\270\321\201\321\213</span>\n                    <span className=\"text-[#FDE047]\">\342\206\222 \320\242\321\203\320\275\320\275\320\265\320\273\321\214 15G</span>\n                  </div>\n                  <div className=\"flex items-center justify-between rounded-md bg-[#1A1A1A] px-3 py-2 border border-[#2A2A2A]\">\n                    <span className=\"text-[#A1A1AA]\">\320\221\320\260\320\275\320\272\320\270 \320\240\320\244 / \320\223\320\276\321\201\321\203\321\201\320\273\321\203\320\263\320\270 / .ru</span>\n                    <span className=\"text-[#FAFAFA]\">\342\206\222 \320\235\320\260\320\