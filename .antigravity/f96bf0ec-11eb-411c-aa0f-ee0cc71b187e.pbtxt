    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "    if (rawT < 1) {\n      // In Hero or flying along the parabola behind \"\320\224\320\276\321\201\321\202\321\203\320\277\320\275\320\276 \320\275\320\260 \320\262\321\201\320\265\321\205 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262\320\260\321\205\"\n      targetRotateZ = shouldReduceMotion ? 0 : -2 * (1 - rawT) - 12 * parabola;\n      targetRotateY = shouldReduceMotion ? 0 : -8 * (1 - rawT) - 24 * parabola - 12 * rawT;\n      targetRotateX = shouldReduceMotion ? 0 : 4 * (1 - rawT) + 14 * parabola + 6 * rawT;\n      targetScale = shouldReduceMotion ? 1 : 1 - 0.05 * parabola;\n\n      // While in Hero / early flight, show \320\223\320\273\320\260\320\262\320\275\320\260\321\217; as it emerges into Mantle, ready step 01\n      setActiveStepIndex(0);\n      setActiveTab(\'home\');\n    } else {\n      // Landed in Mantle! Step through 01 -> 02 -> 03 while Mantle is pinned\n      if (rawP < 0.34) {\n        const localP = rawP / 0.34;\n        setActiveStepIndex(0);\n        setActiveTab(\'home\');\n        targetRotateY = shouldReduceMotion ? 0 : -12 + 12 * localP;\n        targetRotateX = shouldReduceMotion ? 0 : 6 - 4 * localP;\n        targetRotateZ = 0;\n      } else if (rawP < 0.68) {\n        const localP = (rawP - 0.34) / 0.34;\n        setActiveStepIndex(1);\n        setActiveTab(\'regions\');\n        targetRotateY = shouldReduceMotion ? 0 : 0 + 12 * localP;\n        targetRotateX = shouldReduceMotion ? 0 : 2 - 2 * localP;\n        targetRotateZ = shouldReduceMotion ? 0 : 1.5 * Math.sin(localP * Math.PI);\n      } else {\n        const localP = (rawP - 0.68) / 0.32;\n        setActiveStepIndex(2);\n        setActiveTab(\'settings\');\n        targetRotateY = shouldReduceMotion ? 0 : 12 - 12 * localP;\n        targetRotateX = 0;\n        targetRotateZ = 0;\n      }\n      targetScale = 1;\n    }"
        replacement_content: "    if (rawT < 1) {\n      // In Hero or flying along the parabola behind \"\320\224\320\276\321\201\321\202\321\203\320\277\320\275\320\276 \320\275\320\260 \320\262\321\201\320\265\321\205 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262\320\260\321\205\"\n      targetRotateZ = shouldReduceMotion ? 0 : -3 * (1 - rawT) - 14 * parabola;\n      targetRotateY = shouldReduceMotion ? 0 : -18 * (1 - rawT) - 34 * parabola - 22 * rawT;\n      targetRotateX = shouldReduceMotion ? 0 : 8 * (1 - rawT) + 20 * parabola + 10 * rawT;\n      targetScale = shouldReduceMotion ? 1 : 1 - 0.04 * parabola;\n\n      // While in Hero / early flight, show \320\223\320\273\320\260\320\262\320\275\320\260\321\217; as it emerges into Mantle, ready step 01\n      setActiveStepIndex(0);\n      setActiveTab(\'home\');\n    } else {\n      // Landed in Mantle! Step through 01 -> 02 -> 03 while Mantle is pinned\n      if (rawP < 0.34) {\n        const localP = rawP / 0.34;\n        setActiveStepIndex(0);\n        setActiveTab(\'home\');\n        targetRotateY = shouldReduceMotion ? 0 : -22 + 38 * localP;\n        targetRotateX = shouldReduceMotion ? 0 : 10 - 6 * localP;\n        targetRotateZ = shouldReduceMotion ? 0 : -2 + 4 * localP;\n      } else if (rawP < 0.68) {\n        const localP = (rawP - 0.34) / 0.34;\n        setActiveStepIndex(1);\n        setActiveTab(\'regions\');\n        targetRotateY = shouldReduceMotion ? 0 : 16 - 34 * localP;\n        targetRotateX = shouldReduceMotion ? 0 : 4 + 6 * Math.sin(localP * Math.PI);\n        targetRotateZ = shouldReduceMotion ? 0 : 2 - 4 * localP;\n      } else {\n        const localP = (rawP - 0.68) / 0.32;\n        setActiveStepIndex(2);\n        setActiveTab(\'settings\');\n        targetRotateY = shouldReduceMotion ? 0 : -18 + 6 * localP;\n        targetRotateX = shouldReduceMotion ? 0 : 4 * (1 - localP);\n        targetRotateZ = shouldReduceMotion ? 0 : -2 * (1 - localP);\n      }\n      targetScale = 1;\n    }"
        start_line: 101
