   badgeText: \'\320\237\320\260\320\272\320\265\321\202\321\213 \320\270 CLI\',\\n    fileName: \'anke-vpn_2.8.4_amd64.deb\',\\n    fileSize: \'24.6 \320\234\320\221\',\\n    cliCommand: \'curl -fsSL https://anke.dev/vnp/ru/install.sh | sudo bash\',\\n    steps: [\\n      \'\320\222\321\213\320\277\320\276\320\273\320\275\320\270\321\202\320\265 \320\272\320\276\320\274\320\260\320\275\320\264\321\203 \320\261\321\213\321\201\321\202\321\200\320\276\320\271 \321\203\321\201\321\202\320\260\320\275\320\276\320\262\320\272\320\270 \320\262 \321\202\320\265\321\200\320\274\320\270\320\275\320\260\320\273\320\265 \320\270\320\273\320\270 \321\201\320\272\320\260\321\207\320\260\320\271\321\202\320\265 .deb / .rpm\',\\n      \'\320\220\320\262\321\202\320\276\321\200\320\270\320\267\321\203\320\271\321\202\320\265 \321\203\320\267\320\265\320\273 \320\272\320\276\320\274\320\260\320\275\320\264\320\276\320\271: anke auth <\320\262\320\260\321\210_\320\272\320\273\321\216\321\207>\',\\n      \'\320\227\320\260\320\277\321\203\321\201\321\202\320\270\321\202\320\265 \321\201\320\276\320\265\320\264\320\270\320\275\320\265\320\275\320\270\320\265: anke up --node fi-hel --protocol reality\',\\n    ],\\n  },\\n];\\n\\nexport const FAQ_ITEMS = [\\n  {\\n    question: \'\320\240\320\260\320\261\320\276\321\202\320\260\320\265\321\202 \320\273\320\270 Anke VPN \320\262 \321\203\321\201\320\273\320\276\320\262\320\270\321\217\321\205 \320\266\320\265\321\201\321\202\320\272\320\270\321\205 DPI-\320\261\320\273\320\276\320\272\320\270\321\200\320\276\320\262\320\276\320\272 \320\277\321\200\320\276\320\262\320\260\320\271\320\264\320\265\321\200\320\276\320\262?\',\\n    answer:\\n      \'\320\224\320\260. \320\237\320\276 \321\203\320\274\320\276\320\273\321\207\320\260\320\275\320\270\321\216 \320\270\321\201\320\277\320\276\320\273\321\214\320\267\321\203\320\265\321\202\321\201\321\217 \320\277\321\200\320\276\321\202\320\276\320\272\320\276\320\273 VLESS \321\201 \320\274\320\260\321\201\320\272\320\270\321\200\320\276\320\262\320\272\320\276\320\271 XTLS-Reality (TLS 1.3). \320\224\320\273\321\217 \320\276\320\261\320\276\321\200\321\203\320\264\320\276\320\262\320\260\320\275\320\270\321\217 \320\242\320\241\320\237\320\243 \320\262\320\260\321\210 \321\202\321\200\320\260\321\204\320\270\320\272 \320\262\321\213\320\263\320\273\321\217\320\264\320\270\321\202 \320\272\320\260\320\272 \320\276\320\261\321\213\321\207\320\275\320\276\320\265 \320\277\320\276\321\201\320\265\321\211\320\265\320\275\320\270\320\265 \320\267\320\260\321\200\321\203\320\261\320\265\320\266\320\275\321\213\321\205 \320\272\320\276\321\200\320\277\320\276\321\200\320\260\321\202\320\270\320\262\320\275\321\213\321\205 \321\201\320\260\320\271\321\202\320\276\320\262 \320\277\320\276 HTTPS, \320\277\320\276\321\215\321\202\320\276\320\274\321\203 \321\201\320\276\320\265\320\264\320\270\320\275\320\265\320\275\320\270\320\265 \320\275\320\265 \320\261\320\273\320\276\320\272\320\270\321\200\321\203\320\265\321\202\321\201\321\217 \320\270 \320\275\320\265 \320\277\320\276\320\264\320\262\320\265\321\200\320\263\320\260\320\265\321\202\321\201\321\217 \320\270\321\201\320\272\321\203\321\201\321\201\321\202\320\262\320\265\320\275\320\275\320\276\320\274\321\203 \321\210\320\265\320\271\320\277\320\270\320\275\320\263\321\203 \321\201\320\272\320\276\321\200\320\276\321\201\321\202\320\270.\',\\n  },\\n  {\\n    question: \'\320\235\321\203\320\266\320\275\320\276 \320\273\320\270 \320\276\321\202\320\272\320\273\321\216\321\207\320\260\321\202\321\214 VPN \320\264\320\273\321\217 \320\262\321\205\320\276\320\264\320\260 \320\262 \321\200\320\276\321\201\321\201\320\270\320\271\321\201\320\272\320\270\320\265 \320\261\320\260\320\275\320\272\320\270 \320\270 \320\223\320\276\321\201\321\203\321\201\320\273\321\203\320\263\320\270?\',\\n    answer:\\n      \'\320\235\320\265\321\202. \320\222 \320\277\321\200\320\270\320\273\320\276\320\266\320\265\320\275\320\270\320\270 \320\275\320\260\321\201\321\202\321\200\320\276\320\265\320\275\320\260 \320\274\320\260\321\200\321\210\321\200\321\203\321\202\320\270\320\267\320\260\321\206\320\270\321\217 Split-Tunneling: \321\202\321\200\320\260\321\204\320\270\320\272 \320\272 \320\264\320\276\320\274\320\265\320\275\320\260\320\274 .ru, .\321\200\321\204, \321\200\320\276\321\201\321\201\320\270\320\271\321\201\320\272\320\270\320\274 \320\261\320\260\320\275\320\272\320\260\320\274 \320\270 \320\274\320\260\321\200\320\272\320\265\321\202\320\277\320\273\320\265\320\271\321\201\320\260\320\274 \320\270\320\264\320\265\321\202 \320\275\320\260\320\277\321\200\321\217\320\274\321\203\321\216 \321\207\320\265\321\200\320\265\320\267 \320\262\320\260\321\210\320\265\320\263\320\276 \320\277\321\200\320\276\320\262\320\260\320\271\320\264\320\265\321\200\320\260 \321\201 \320\274\320\270\320\275\320\270\320\274\320\260\320\273\321\214\320\275\321\213\320\274 \320\277\320\270\320\275\320\263\320\276\320\274, \320\260 \320\267\320\260\321\200\321\203\320\261\320\265\320\266\320\275\321\213\320\265 \321\200\320\265\321\201\321\203\321\200\321\201\321\213 \320\270 \321\201\321\202\321\200\320\270\320\274\320\270\320\275\320\263 \342\200\224 \321\207\320\265\321\200\320\265\320\267 \320\267\320\260\321\211\320\270\321\211\320\265\320\275\320\275\321\213\320\271 \320\272\320\260\320\275\320\260\320\273 15 \320\223\320\261\320\270\321\202/\321\201.\',\\n  },\\n  {\\n    question: \'\320\236\321\202\320\272\321\203\320\264\320\260 \320\261\320\265\321\200\320\265\321\202\321\201\321\217 \321\201\320\272\320\276\321\200\320\276\321\201\321\202\321\214 \320\264\320\276 15 \320\223\320\261\320\270\321\202/\321\201?\',\\n    answer:\\n      \'\320\234\321\213 \320\260\321\200\320\265\320\275\320\264\321\203\320\265\320\274 \320\262\321\213\320\264\320\265\320\273\320\265\320\275\320\275\321\213\320\265 \321\204\320\270\320\267\320\270\321\207\320\265\321\201\320\272\320\270\320\265 \321\201\320\265\321\200\320\262\320\265\321\200\321\213 (Bare-Metal) \320\262 \320\264\320\260\321\202\320\260-\321\206\320\265\320\275\321\202\321\200\320\260\321\205 Tier III/IV (Equinix \320\270 Hetzner) \321\201 \320\260\320\263\321\200\320\265\320\263\320\270\321\200\320\276\320\262\320\260\320\275\320\275\321\213\320\274\320\270 \320\277\320\276\321\200\321\202\320\260\320\274\320\270 10G \320\270 25G. \320\234\321\213 \320\275\320\265 \320\270\321\201\320\277\320\276\320\273\321\214\320\267\321\203\320\265\320\274 \320\264\320\265\321\210\320\265\320\262\321\213\320\265 \320\262\320\270\321\200\321\202\321\203\320\260\320\273\321\214\320\275\321\213\320\265 VPS \321\201 \320\276\320\262\320\265\321\200\321\201\320\265\320\273\320\273\320\270\320\275\320\263\320\276\320\274, \320\261\320\273\320\260\320\263\320\276\320\264\320\260\321\200\321\217 \321\207\320\265\320\274\321\203 \320\262\321\213 \320\277\320\276\320\273\321\203\321\207\320\260\320\265\321\202\320\265 \320\274\320\260\320\272\321\201\320\270\320\274\320\260\320\273\321\214\320\275\321\203\321\216 \321\201\320\272\320\276\321\200\320\276\321\201\321\202\321\214 \320\262\320\260\321\210\320\265\320\263\320\276 \320\264\320\276\320\274\320\260\321\210\320\275\320\265\320\263\320\276 \320\270\320\273\320\270 \320\274\320\276\320\261\320\270\320\273\321\214\320\275\320\276\320\263\320\276 \321\202\320\260\321\200\320\270\321\204\320\260.\',\\n  },\\n  {\\n    question: \'\320\232\320\260\320\272 \321\200\320\260\320\261\320\276\321\202\320\260\320\265\321\202 30-\320\264\320\275\320\265\320\262\320\275\320\260\321\217 \320\263\320\260\321\200\320\260\320\275\321\202\320\270\321\217 \320\262\320\276\320\267\320\262\321\200\320\260\321\202\320\260 \321\201\321\200\320\265\320\264\321\201\321\202\320\262?\',\\n    answer:\\n      \'\320\225\321\201\320\273\320\270 \320\262 \321\202\320\265\321\207\320\265\320\275\320\270\320\265 \320\277\320\265\321\200\320\262\321\213\321\205 30 \320\264\320\275\320\265\320\271 \320\277\320\276\321\201\320\273\320\265 \320\277\320\276\320\272\321\203\320\277\320\272\320\270 \321\201\320\272\320\276\321\200\320\276\321\201\321\202\321\214 \320\270\320\273\320\270 \321\201\321\202\320\260\320\261\320\270\320\273\321\214\320\275\320\276\321\201\321\202\321\214 \321\201\320\276\320\265\320\264\320\270\320\275\320\265\320\275\320\270\321\217 \320\262\320\260\321\201 \320\275\320\265 \321\203\321\201\321\202\321\200\320\276\320\270\321\202, \320\275\320\260\320\277\320\270\321\210\320\270\321\202\320\265 \320\262 \321\207\320\260\321\202 \320\277\320\276\320\264\320\264\320\265\321\200\320\266\320\272\320\270 \320\270\320\273\320\270 Telegram-\320\261\320\276\321\202. \320\234\321\213 \320\262\320\265\321\200\320\275\320\265\320\274 100% \321\201\321\202\320\276\320\270\320\274\320\276\321\201\321\202\320\270 \320\277\320\276\320\264\320\277\320\270\321\201\320\272\320\270 \321\202\320\265\320\274 \320\266\320\265 \321\201\320\277\320\276\321\201\320\276\320\261\320\276\320\274 \320\276\320\277\320\273\320\260\321\202\321\213 \320\261\320\265\320\267 \320\261\321\216\321\200\320\276\320\272\321\200\320\260\321\202\320\270\320\270 \320\270 \321\201\320\273\320\276\320\266\320\275\321\213\321\205 \320\260\320\275\320\272\320\265\321\202.\',\\n  },\\n];\\n\",\"Description\":\"Create structured data for Anke VPN nodes, platforms, and FAQs in src/data/vpnData.ts\",\"Overwrite\":true,\"TargetFile\":\"/src/data/vpnData.ts\",\"toolAction\":\"Creating VPN data module\",\"toolSummary\":\"Create VPN data module\"}"
