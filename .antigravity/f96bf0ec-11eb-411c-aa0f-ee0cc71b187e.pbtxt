            }
            lines {
              text: "    window.addEventListener(\'scroll\', onScrollOrResize, { passive: true });"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    window.addEventListener(\'resize\', onScrollOrResize, { passive: true });"
