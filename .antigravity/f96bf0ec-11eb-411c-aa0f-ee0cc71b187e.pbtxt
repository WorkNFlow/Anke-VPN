  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useRef, useEffect } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { ArrowUpRight, Download, ChevronDown } from \'lucide-react\';\nimport { OFFICIAL_LINKS } from \'../data/vpnData\';\nimport { SpotlightShell } from \'./AnkeLogo\';\n\nexport const PlatformCards: React.FC = () => {\n  const [openMenu, setOpenMenu] = useState<\'windows\' | \'linux\' | null>(null);\n  const [showMsiOptions, setShowMsiOptions] = useState(false);\n  const sectionRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    const handleClickOutside = (e: MouseEvent) => {\n      if (sectionRef.current && !sectionRef.current.contains(e.target as Node)) {\n        setOpenMenu(null);\n      }\n    };\n    document.addEventListener(\'mousedown\', handleClickOutside);\n    return () => document.removeEventListener(\'mousedown\', handleClickOutside);\n  }, []);\n\n  return (\n    <section\n      id=\"platforms\"\n      ref={sectionRef}\n      className=\"relative py-20 lg:py-28 border-b border-[#2A2A2A]\"\n    >\n      <div className=\"mx-auto max-w-[1200px] px-4 sm:px-6\">\n        {/* Official Section Heading & Subtitle */}\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true, margin: \'-60px\' }}\n          transition={{ duration: 0.5, ease: [0.16, 1, 0.3, 1] }}\n          className=\"text-center max-w-2xl mx-auto mb-12\"\n        >\n          <h2\n            style={{ fontSize: \'clamp(1.75rem, 3vw, 2.75rem)\' }}\n            className=\"font-bold tracking-tight text-[#FAFAFA]\"\n          >\n            \320\224\320\276\321\201\321\202\321\203\320\277\320\275\320\276 \320\275\320\260 \320\262\321\201\320\265\321\205 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262\320\260\321\205\n          </h2>\n          <p className=\"mt-3 text-base text-[#A1A1AA]\">\n            \320\230\321\201\320\277\320\276\320\273\321\214\320\267\321\203\320\271 Anke \320\275\320\260 \321\201\320\274\320\260\321\200\321\202\321\204\320\276\320\275\320\260\321\205, \320\277\320\273\320\260\320\275\321\210\320\265\321\202\320\260\321\205 \320\270 \320\272\320\276\320\274\320\277\321\214\321\216\321\202\320\265\321\200\320\260\321\205\n          </p>\n        </motion.div>\n\n        {/* 4 Glossy Cards Row: App Store, Google Play, Windows, Linux */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n          {/* 1. App Store */}\n          <motion.a\n            href={OFFICIAL_LINKS.appStore}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true, margin: \'-40px\' }}\n            transition={{ duration: 0.45, delay: 0, ease: [0.16, 1, 0.3, 1] }}\n            whileHover={{ y: -4 }}\n            whileTap={{ scale: 0.98 }}\n            className=\"group block focus-visible:outline-2 focus-visible:outline-[#FDE047]\"\n          >\n            <SpotlightShell\n              className=\"h-full group-hover:border-[#FDE047]/50 group-hover:shadow-[0_0_35px_rgba(253,224,71,0.1)]\"\n              innerClassName=\"p-6 flex items-center justify-between gap-4 bg-gradient-to-b from-white/[0.04] to-transparent\"\n            >\n              <div className=\"flex items-center gap-3.5\">\n                <span className=\"flex h-11 w-11 items-center justify-center rounded-xl border border-[#2A2A2A] bg-[#121212] text-[#FAFAFA] group-hover:border-[#FDE047]/40 group-hover:text-[#FDE047] transition-colors\">\n                  <svg viewBox=\"0 0 24 24\" className=\"h-5 w-5 fill-current\" aria-hidden=\"true\">\n                    <path d=\"M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.96 6.33c.67-.81 1.12-1.94 1-3.08-.96.04-2.13.64-2.82 1.45-.61.7-.15 1.86-1.03 2.97 1.08.08 2.18-.53 2.85-1.34z\" />\n                  </svg>\n                </span>\n                <div>\n                  <div className=\"text-base font-bold text-[#FAFAFA]\">App Store</div>\n                  <div className=\"text-xs text-[#A1A1AA]\">iOS &amp; macOS</div>\n                </div>\n              </div>\n              <span className=\"flex h-9 w-9 items-center justify-center rounded-full bg-white/[0.04] text-[#FAFAFA] group-hover:bg-[#FDE047] group-hover:text-black transition-all duration-200\">\n                <ArrowUpRight className=\"h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5\" />\n              </span>\n            </SpotlightShell>\n          </motion.a>\n\n          {/* 2. Google Play */}\n          <motion.a\n            href={OFFICIAL_LINKS.googlePlay}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true, margin: \'-40px\' }}\n            transition={{ duration: 0.45, delay: 0.06, ease: [0.16, 1, 0.3, 1] }}\n            whileHover={{ y: -4 }}\n            whileTap={{ scale: 0.98 }}\n            className=\"group block focus-visible:outline-2 focus-visible:outline-[#FDE047]\"\n          >\n            <SpotlightShell\n              className=\"h-full group-hover:border-[#FDE047]/50 group-hover:shadow-[0_0_35px_rgba(253,224,71,0.1)]\"\n              innerClassName=\"p-6 flex items-center justify-between gap-4 bg-gradient-to-b from-white/[0.04] to-transparent\"\n            >\n              <div className=\"flex items-center gap-3.5\">\n                <span className=\"flex h-11 w-11 items-center justify-center rounded-xl border border-[#2A2A2A] bg-[#121212] text-[#FAFAFA] group-hover:border-[#FDE047]/40 group-hover:text-[#FDE047] transition-colors\">\n                  <svg viewBox=\"0 0 24 24\" className=\"h-5 w-5 fill-current\" aria-hidden=\"true\">\n                    <path d=\"M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4483-.9993.9993-.9993c.5511 0 .9993.4483.9993.9993.0001.5511-.4482.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4483.9993.9993 0 .5511-.4483.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.2439 13.8533 7.8508 12 7.8508s-3.5902.3931-5.1367 1.0989L4.841 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3435-4.1021-2.6892-7.5743-6.1185-9.4396\" />\n                  </svg>\n                </span>\n                <div>\n                  <div className=\"text-base font-bold text-[#FAFAFA]\">Google Play</div>\n                  <div className=\"text-xs text-[#A1A1AA]\">Android</div>\n                </div>\n              </div>\n              <span className=\"flex h-9 w-9 items-center justify-center rounded-full bg-white/[0.04] text-[#FAFAFA] group-hover:bg-[#FDE047] group-hover:text-black transition-all duration-200\">\n                <ArrowUpRight className=\"h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5\" />\n              </span>\n            </SpotlightShell>\n          </motion.a>\n\n          {/* 3. Windows (with official Microsoft Store + .msi dropdown) */}\n          <div className=\"relative\">\n            <motion.button\n              type=\"button\"\n              onClick={() => setOpenMenu(openMenu === \'windows\' ? null : \'windows\')}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true, margin: \'-40px\' }}\n              transition={{ duration: 0.45, delay: 0.12, ease: [0.16, 1, 0.3, 1] }}\n              whileHover={{ y: -4 }}\n              whileTap={{ scale: 0.98 }}\n              className=\"group w-full text-left cursor-pointer focus-visible:outline-2 focus-visible:outline-[#FDE047]\"\n            >\n              <SpotlightShell\n                className={`h-full group-hover:border-[#FDE047]/50 group-hover:shadow-[0_0_35px_rgba(253,224,71,0.1)] ${\n                  openMenu === \'windows\' ? \'border-[#FDE047]/60\' : \'\'\n                }`}\n                innerClassName=\"p-6 flex items-center justify-between gap-4 bg-gradient-to-b from-white/[0.04] to-transparent\"\n              >\n                <div className=\"flex items-center gap-3.5\">\n                  <span className=\"flex h-11 w-11 items-center justify-center rounded-xl border border-[#2A2A2A] bg-[#121212] text-[#FAFAFA] group-hover:border-[#FDE047]/40 group-hover:text-[#FDE047] transition-colors\">\n                    <svg viewBox=\"0 0 22 22\" className=\"h-5 w-5 fill-current\" aria-hidden=\"true\">\n                      <rect width=\"10\" height=\"10\" />\n                      <rect x=\"12\" width=\"10\" height=\"10\" />\n                      <rect y=\"12\" width=\"10\" height=\"10\" />\n                      <rect x=\"12\" y=\"12\" width=\"10\" height=\"10\" />\n                    </svg>\n                  </span>\n                  <div>\n                    <div className=\"text-base font-bold text-[#FAFAFA]\">Windows</div>\n                    <div className=\"text-xs text-[#A1A1AA]\">Microsoft Store / .msi</div>\n                  </div>\n                </div>\n                <span className=\"flex h-9 w-9 items-center justify-center rounded-full bg-white/[0.04] text-[#FAFAFA] group-hover:bg-[#FDE047] group-hover:text-black transition-all duration-200\">\n                  <Download className=\"h-4 w-4\" />\n                </span>\n              </SpotlightShell>\n            </motion.button>\n\n            {/* Official Windows Dropdown Menu */}\n            <AnimatePresence>\n              {openMenu === \'windows\' && (\n                <motion.div\n                  initial={{ opacity: 0, scale: 0.95, y: 8 }}\n                  animate={{ opacity: 1, scale: 1, y: 0 }}\n                  exit={{ opacity: 0, scale: 0.95, y: 6 }}\n                  transition={{ duration: 0.16, ease: [0.16, 1, 0.3, 1] }}\n                  style={{ transformOrigin: \'top center\' }}\n                  className=\"absolute left-0 right-0 top-full mt-2 z-30 double-bezel-shell shadow-[0_20px_50px_rgba(0,0,0,0.85)]\"\n                >\n                  <div className=\"double-bezel-core p-2.5 space-y-1.5 bg-[#181818]\">\n                    <a\n                      href={OFFICIAL_LINKS.microsoftStore}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"flex items-center justify-between rounded-lg border border-[#2A2A2A] bg-[#121212] hover:border-[#FDE047]/50 p-3 transition-colors\"\n                    >\n                      <div className=\"flex items-center gap-3\">\n                        <svg viewBox=\"0 0 22 22\" width=\"18\" height=\"18\" aria-hidden=\"true\">\n                          <rect width=\"10\" height=\"10\" fill=\"#F25022\" />\n                          <rect x=\"12\" width=\"10\" height=\"10\" fill=\"#7FBA00\" />\n                          <rect y=\"12\" width=\"10\" height=\"10\" fill=\"#00A4EF\" />\n                          <rect x=\"12\" y=\"12\" width=\"10\" height=\"10\" fill=\"#FFB900\" />\n                        </svg>\n                        <div>\n                          <div className=\"text-xs font-bold text-[#FAFAFA]\">Microsoft Store</div>\n                          <div className=\"text-[11px] text-[#FDE047]\">\320\240\320\265\320\272\320\276\320\274\320\265\320\275\320\264\321\203\320\265\321\202\321\201\321\217</div>\n                        </div>\n                      </div>\n                      <ArrowUpRight className=\"h-4 w-4 text-[#A1A1AA]\" />\n                    </a>\n\n                    <button\n                      type=\"button\"\n                      onClick={() => setShowMsiOptions((prev) => !prev)}\n                      className=\"flex w-full items-center justify-between rounded-lg px-3 py-2 text-xs text-[#A1A1AA] hover:bg-white/[0.04] hover:text-[#FAFAFA] cursor-pointer\"\n                    >\n                      <span>\320\221\320\265\320\267 \320\274\320\260\320\263\320\260\320\267\320\270\320\275\320\260 \342\200\224 \321\203\321\201\321\202\320\260\320\275\320\276\320\262\321\211\320\270\320\272 .msi</span>\n                      <ChevronDown\n                        className={`h-3.5 w-3.5 transition-transform ${\n                          showMsiOptions ? \'rotate-180\' : \'\'\n                        }`}\n                      />\n                    </button>\n\n                    {showMsiOptions && (\n                      <div className=\"space-y-1 pl-2 pt-1 border-t border-[#2A2A2A]\">\n                        <a\n                          href={OFFICIAL_LINKS.windowsMsiX64}\n                          target=\"_blank\"\n                          rel=\"noopener noreferrer\"\n                          className=\"block rounded-md px-3 py-2 text-xs text-[#FAFAFA] hover:bg-[#FDE047] hover:text-black font-medium transition-colors\"\n                        >\n                          Windows 10/11 (x64)\n                        </a>\n                        <a\n                          href={OFFICIAL_LINKS.windowsMsiArm64}\n                          target=\"_blank\"\n                          rel=\"noopener noreferrer\"\n                          className=\"block rounded-md px-3 py-2 text-xs text-[#FAFAFA] hover:bg-[#FDE047] hover:text-black font-medium transition-colors\"\n                        >\n                          Windows 10/11 (ARM64)\n                        </a>\n                      </div>\n                    )}\n                  </div>\n                </motion.div>\n              )}\n            </AnimatePresence>\n          </div>\n\n          {/* 4. Linux (with official AppImage, .deb, .rpm dropdown) */}\n          <div className=\"relative\">\n            <motion.button\n              type=\"button\"\n              onClick={() => setOpenMenu(openMenu === \'linux\' ? null : \'linux\')}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true, margin: \'-40px\' }}\n              transition={{ duration: 0.45, delay: 0.18, ease: [0.16, 1, 0.3, 1] }}\n              whileHover={{ y: -4 }}\n              whileTap={{ scale: 0.98 }}\n              className=\"group w-full text-left cursor-pointer focus-visible:outline-2 focus-visible:outline-[#FDE047]\"\n            >\n              <SpotlightShell\n                className={`h-full group-hover:border-[#FDE047]/50 group-hover:shadow-[0_0_35px_rgba(253,224,71,0.1)] ${\n                  openMenu === \'linux\' ? \'border-[#FDE047]/60\' : \'\'\n                }`}\n                innerClassName=\"p-6 flex items-center justify-between gap-4 bg-gradient-to-b from-white/[0.04] to-transparent\"\n              >\n                <div className=\"flex items-center gap-3.5\">\n                  <span className=\"flex h-11 w-11 items-center justify-center rounded-xl border border-[#2A2A2A] bg-[#121212] text-[#FAFAFA] group-hover:border-[#FDE047]/40 group-hover:text-[#FDE047] transition-colors\">\n                    <svg viewBox=\"0 0 24 24\" className=\"h-5 w-5 fill-current\" aria-hidden=\"true\">\n                      <path d=\"M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 00-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139z\" />\n                    </svg>\n                  </span>\n                  <div>\n                    <div className=\"text-base font-bold text-[#FAFAFA]\">Linux</div>\n                    <div className=\"text-xs text-[#A1A1AA]\">AppImage / .deb / .rpm</div>\n                  </div>\n                </div>\n                <span className=\"flex h-9 w-9 items-center justify-center rounded-full bg-white/[0.04] text-[#FAFAFA] group-hover:bg-[#FDE047] group-hover:text-black transition-all duration-200\">\n                  <Download className=\"h-4 w-4\" />\n                </span>\n              </SpotlightShell>\n            </motion.button>\n\n            {/* Official Linux Dropdown Menu */}\n            <AnimatePresence>\n              {openMenu === \'linux\' && (\n                <motion.div\n                  initial={{ opacity: 0, scale: 0.95, y: 8 }}\n                  animate={{ opacity: 1, scale: 1, y: 0 }}\n                  exit={{ opacity: 0, scale: 0.95, y: 6 }}\n                  transition={{ duration: 0.16, ease: [0.16, 1, 0.3, 1] }}\n                  style={{ transformOrigin: \'top center\' }}\n                  className=\"absolute left-0 right-0 top-full mt-2 z-30 double-bezel-shell shadow-[0_20px_50px_rgba(0,0,0,0.85)]\"\n                >\n                  <div className=\"double-bezel-core p-2 space-y-1 bg-[#181818]\">\n                    <a\n                      href={OFFICIAL_LINKS.linuxAppImage}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"flex items-center justify-between rounded-lg px-3.5 py-2.5 text-xs font-semibold text-[#FAFAFA] hover:bg-[#FDE047] hover:text-black transition-colors\"\n                    >\n                      <span>AppImage</span>\n                      <Download className=\"h-3.5 w-3.5\" />\n                    </a>\n                    <a\n                      href={OFFICIAL_LINKS.linuxDeb}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"flex items-center justify-between rounded-lg px-3.5 py-2.5 text-xs font-semibold text-[#FAFAFA] hover:bg-[#FDE047] hover:text-black transition-colors\"\n                    >\n                      <span>.deb</span>\n                      <Download className=\"h-3.5 w-3.5\" />\n                    </a>\n                    <a\n                      href={OFFICIAL_LINKS.linuxRpm}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"flex items-center justify-between rounded-lg px-3.5 py-2.5 text-xs font-semibold text-[#FAFAFA] hover:bg-[#FDE047] hover:text-black transition-colors\"\n                    >\n                      <span>.rpm</span>\n                      <Download className=\"h-3.5 w-3.5\" />\n                    </a>\n                  </div>\n                </motion.div>\n              )}\n            </AnimatePresence>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/PlatformCards.tsx"
        }
        overwrite: true
      }
    }
