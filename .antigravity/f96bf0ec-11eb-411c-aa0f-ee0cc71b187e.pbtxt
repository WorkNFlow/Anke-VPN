  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport {\n  Home,\n  Globe,\n  Settings,\n  Copy,\n  Check,\n  CreditCard,\n  ChevronRight,\n  LogOut,\n  Send,\n  Headphones,\n  Power,\n} from \'lucide-react\';\nimport { OFFICIAL_SERVERS } from \'../data/vpnData\';\nimport { AnkeLogo } from \'./AnkeLogo\';\n\nexport type IPhoneTab = \'home\' | \'regions\' | \'settings\';\n\ninterface IPhone3DModelProps {\n  activeTab: IPhoneTab;\n  onTabChange: (tab: IPhoneTab) => void;\n  customScreenshotUrl?: string | null;\n  className?: string;\n}\n\nexport const IPhone3DModel: React.FC<IPhone3DModelProps> = ({\n  activeTab,\n  onTabChange,\n  customScreenshotUrl,\n  className = \'\',\n}) => {\n  const [selectedServerId, setSelectedServerId] = useState<string>(\'se-sto\');\n  const [isConnected, setIsConnected] = useState<boolean>(true);\n  const [copiedAccount, setCopiedAccount] = useState<boolean>(false);\n\n  const currentServer =\n    OFFICIAL_SERVERS.find((s) => s.id === selectedServerId) || OFFICIAL_SERVERS[1];\n\n  const handleCopyAccount = () => {\n    navigator.clipboard.writeText(\'1234 5678 9012 3456\');\n    setCopiedAccount(true);\n    setTimeout(() => setCopiedAccount(false), 1800);\n  };\n\n  return (\n    <div\n      style={{ transformStyle: \'preserve-3d\' }}\n      className={`relative mx-auto w-[300px] sm:w-[320px] select-none ${className}`}\n    >\n      {/* 3D Titanium Outer Chassis with realistic metallic rim and depth */}\n      <div\n        style={{\n          boxShadow:\n            \'0 30px 70px -10px rgba(0,0,0,0.9), 0 0 0 1px rgba(255,255,255,0.18), inset 0 0 4px 1px rgba(255,255,255,0.22)\',\n        }}\n        className=\"relative rounded-[52px] bg-gradient-to-b from-[#3A3A3C] via-[#242426] to-[#18181A] p-[10px]\"\n      >\n        {/* Physical Side Buttons (Left: Action + Volume, Right: Power) */}\n        <div\n          aria-hidden=\"true\"\n          className=\"absolute -left-[3px] top-[96px] h-7 w-[3px] rounded-l-sm bg-gradient-to-b from-[#525256] to-[#27272A]\"\n        />\n        <div\n          aria-hidden=\"true\"\n          className=\"absolute -left-[3px] top-[140px] h-12 w-[3px] rounded-l-sm bg-gradient-to-b from-[#525256] to-[#27272A]\"\n        />\n        <div\n          aria-hidden=\"true\"\n          className=\"absolute -left-[3px] top-[200px] h-12 w-[3px] rounded-l-sm bg-gradient-to-b from-[#525256] to-[#27272A]\"\n        />\n        <div\n          aria-hidden=\"true\"\n          className=\"absolute -right-[3px] top-[160px] h-16 w-[3px] rounded-r-sm bg-gradient-to-b from-[#525256] to-[#27272A]\"\n        />\n\n        {/* Inner Black Bezel & OLED Screen */}\n        <div className=\"relative h-[615px] w-full overflow-hidden rounded-[42px] bg-[#161618] border border-black flex flex-col justify-between\">\n          {/* Subtle Diagonal Glass Reflection Overlay */}\n          <div\n            aria-hidden=\"true\"\n            className=\"pointer-events-none absolute inset-0 z-30 bg-gradient-to-tr from-transparent via-white/[0.025] to-white/[0.06]\"\n          />\n\n          {/* Dynamic Island */}\n          <div className=\"relative z-20 pt-3 pb-2 flex justify-center bg-[#161618]\">\n            <div className=\"flex h-[25px] w-[96px] items-center justify-between rounded-full bg-black px-2.5 border border-white/[0.06]\">\n              <span className=\"h-2.5 w-2.5 rounded-full bg-[#121214] ring-1 ring-white/10\" />\n              <span className=\"h-2.5 w-2.5 rounded-full bg-[#0E1628] ring-1 ring-white/15\" />\n            </div>\n          </div>\n\n          {/* Screen Content Area */}\n          {customScreenshotUrl ? (\n            <div className=\"flex-1 overflow-hidden bg-[#141414]\">\n              <img\n                src={customScreenshotUrl}\n                alt=\"\320\237\320\276\320\273\321\214\320\267\320\276\320\262\320\260\321\202\320\265\320\273\321\214\321\201\320\272\320\270\320\271 \321\201\320\272\321\200\320\270\320\275\321\210\320\276\321\202 Anke iOS\"\n                referrerPolicy=\"no-referrer\"\n                className=\"h-full w-full object-cover\"\n              />\n            </div>\n          ) : (\n            <div className=\"relative flex-1 overflow-hidden px-4 pt-2 pb-2 flex flex-col\">\n              <AnimatePresence mode=\"wait\">\n                {/* SCREEN 1: \320\223\320\233\320\220\320\222\320\235\320\220\320\257 (Home Connection Screen) */}\n                {activeTab === \'home\' && (\n                  <motion.div\n                    key=\"screen-home\"\n                    initial={{ opacity: 0, x: -16, filter: \'blur(4px)\' }}\n                    animate={{ opacity: 1, x: 0, filter: \'blur(0px)\' }}\n                    exit={{ opacity: 0, x: 16, filter: \'blur(4px)\' }}\n                    transition={{ duration: 0.24, ease: [0.16, 1, 0.3, 1] }}\n                    className=\"flex flex-1 flex-col justify-between py-2\"\n                  >\n                    {/* Header */}\n                    <div className=\"flex items-center justify-between\">\n                      <div className=\"flex items-center gap-2\">\n                        <AnkeLogo className=\"h-5 w-auto\" />\n                        <span className=\"text-sm font-bold text-[#FAFAFA]\">Anke</span>\n                      </div>\n                      <span className=\"rounded-full border border-[#FDE047]/35 bg-[#FDE047]/10 px-2.5 py-0.5 text-[10px] font-mono font-semibold text-[#FDE047]\">\n                        \320\257\320\264\321\200\320\276 Mantle\n                      </span>\n                    </div>\n\n                    {/* Central Connection Button */}\n                    <div className=\"my-auto flex flex-col items-center text-center\">\n                      <div className=\"relative flex items-center justify-center\">\n                        {isConnected && (\n                          <motion.div\n                            animate={{ scale: [1, 1.55], opacity: [0.4, 0] }}\n                            transition={{ duration: 2.2, repeat: Infinity, ease: \'easeOut\' }}\n                            className=\"pointer-events-none absolute h-28 w-28 rounded-full border border-[#FDE047]/50\"\n                          />\n                        )}\n                        <motion.button\n                          type=\"button\"\n                          whileTap={{ scale: 0.93 }}\n                          onClick={() => setIsConnected((prev) => !prev)}\n                          className={`relative z-10 flex h-28 w-28 items-center justify-center rounded-full border-2 transition-all duration-300 cursor-pointer ${\n                            isConnected\n                              ? \'border-[#FDE047] bg-[#FDE047] text-black shadow-[0_0_45px_rgba(253,224,71,0.35)]\'\n                              : \'border-[#2E2E32] bg-[#202024] text-[#A1A1AA]\'\n                          }`}\n                        >\n                          <Power className=\"h-10 w-10 stroke-[2.2]\" />\n                        </motion.button>\n                      </div>\n\n                      <div className=\"mt-5 text-lg font-bold text-[#FAFAFA]\">\n                        {isConnected ? \'\320\237\320\276\320\264\320\272\320\273\321\216\321\207\320\265\320\275\320\276\' : \'\320\236\321\202\320\272\320\273\321\216\321\207\320\265\320\275\320\276\'}\n                      </div>\n                      <div className=\"mt-1 text-xs text-[#A1A1AA]\">\n                        {isConnected\n                          ? \'\320\232\320\260\320\275\320\260\320\273 15 \320\223\320\261\320\270\321\202/\321\201 \302\267 \320\221\320\265\320\267 \320\276\320\263\321\200\320\260\320\275\320\270\321\207\320\265\320\275\320\270\320\271\'\n                          : \'\320\235\320\260\320\266\320\274\320\270\321\202\320\265 \320\264\320\273\321\217 \320\274\320\276\320\274\320\265\320\275\321\202\320\260\320\273\321\214\320\275\320\276\320\263\320\276 \320\277\320\276\320\264\320\272\320\273\321\216\321\207\320\265\320\275\320\270\321\217\'}\n                      </div>\n                    </div>\n\n                    {/* Current Selected Region Card */}\n                    <button\n                      type=\"button\"\n                      onClick={() => onTabChange(\'regions\')}\n                      className=\"flex w-full items-center justify-between rounded-2xl border border-[#2C2C30] bg-[#1E1E22] p-3.5 text-left hover:border-[#FDE047]/50 transition-colors cursor-pointer\"\n                    >\n                      <div className=\"flex items-center gap-3\">\n                        <img\n                          src={currentServer.flagUrl}\n                          alt={currentServer.country}\n                          referrerPolicy=\"no-referrer\"\n                          className=\"h-8 w-8 rounded-full object-cover border border-white/10\"\n                        />\n                        <div>\n                          <div className=\"text-xs font-bold text-[#FAFAFA]\">\n                            {currentServer.country}\n                          </div>\n                          <div className=\"text-[11px] text-[#A1A1AA]\">\n                            {currentServer.city}\n                          </div>\n                        </div>\n                      </div>\n                      <ChevronRight className=\"h-4 w-4 text-[#A1A1AA]\" />\n                    </button>\n                  </motion.div>\n                )}\n\n                {/* SCREEN 2: \320\240\320\225\320\223\320\230\320\236\320\235\320\253 (\"\320\241\320\277\320\270\321\201\320\276\320\272 \321\201\320\265\321\200\320\262\320\265\321\200\320\276\320\262\" \342\200\224 Exact UI from IMG_4396) */}\n                {activeTab === \'regions\' && (\n                  <motion.div\n                    key=\"screen-regions\"\n                    initial={{ opacity: 0, x: 16, filter: \'blur(4px)\' }}\n                    animate={{ opacity: 1, x: 0, filter: \'blur(0px)\' }}\n                    exit={{ opacity: 0, x: -16, filter: \'blur(4px)\' }}\n                    transition={{ duration: 0.24, ease: [0.16, 1, 0.3, 1] }}\n                    className=\"flex flex-1 flex-col overflow-hidden\"\n                  >\n                    <h4 className=\"text-base font-bold text-[#FAFAFA] mb-2\">\n                      \320\241\320\277\320\270\321\201\320\276\320\272 \321\201\320\265\321\200\320\262\320\265\321\200\320\276\320\262\n                    </h4>\n                    <div className=\"text-[11px] font-medium text-[#A1A1AA] mb-2\">\n                      \320\237\321\200\320\265\320\274\320\270\321\203\320\274 \321\201\320\265\321\200\320\262\320\265\321\200\321\213\n                    </div>\n\n                    <div className=\"flex-1 space-y-1 overflow-y-auto pr-1\">\n                      {OFFICIAL_SERVERS.map((server) => {\n                        const isSelected = server.id === selectedServerId;\n                        return (\n                          <button\n                            key={server.id}\n                            type=\"button\"\n                            onClick={() => {\n                              setSelectedServerId(server.id);\n                              setIsConnected(true);\n                            }}\n                            className=\"flex w-full items-center justify-between rounded-xl px-1.5 py-2 text-left hover:bg-white/[0.04] transition-colors cursor-pointer\"\n                          >\n                            <div className=\"flex items-center gap-2.5 min-w-0\">\n                              <span\n                                className={`h-1.5 w-1.5 rounded-full shrink-0 transition-opacity ${\n                                  isSelected ? \'bg-[#FDE047] opacity-100\' : \'opacity-0\'\n                                }`}\n                              />\n                              <img\n                                src={server.flagUrl}\n                                alt={server.country}\n                                referrerPolicy=\"no-referrer\"\n                                className=\"h-7 w-7 rounded-full object-cover shrink-0 border border-white/10\"\n                              />\n                              <div className=\"min-w-0\">\n                                <div className=\"text-xs font-semibold text-[#FAFAFA] truncate\">\n                                  {server.country}\n                                </div>\n                                <div className=\"text-[10px] text-[#8E8E93] truncate\">\n                                  {server.city}\n                                </div>\n                              </div>\n                            </div>\n\n                            {server.tag && (\n                              <span className=\"shrink-0 text-[10px] font-medium\">\n                                <span className=\"text-[#FDE047] font-semibold\">\n                                  {server.tag.name}\n                                </span>{\' \'}\n                                <span className=\"text-[#8E8E93]\">{server.tag.note}</span>\n                              </span>\n                            )}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </motion.div>\n                )}\n\n                {/* SCREEN 3: \320\235\320\220\320\241\320\242\320\240\320\236\320\231\320\232\320\230 (\"\320\235\320\260\321\201\321\202\321\200\320\276\320\271\320\272\320\270\" \342\200\224 Exact UI from IMG_4396) */}\n                {activeTab === \'settings\' && (\n                  <motion.div\n                    key=\"screen-settings\"\n                    initial={{ opacity: 0, x: 16, filter: \'blur(4px)\' }}\n                    animate={{ opacity: 1, x: 0, filter: \'blur(0px)\' }}\n                    exit={{ opacity: 0, x: -16, filter: \'blur(4px)\' }}\n                    transition={{ duration: 0.24, ease: [0.16, 1, 0.3, 1] }}\n                    className=\"flex flex-1 flex-col justify-between overflow-y-auto\"\n                  >\n                    <div className=\"space-y-3\">\n                      {/* Header with red \320\222\321\213\321\205\320\276\320\264 */}\n                      <div className=\"flex items-center justify-between\">\n                        <h4 className=\"text-base font-bold text-[#FAFAFA]\">\320\235\320\260\321\201\321\202\321\200\320\276\320\271\320\272\320\270</h4>\n                        <span className=\"inline-flex items-center gap-1 text-xs font-medium text-[#FF453A]\">\n                          <LogOut className=\"h-3.5 w-3.5\" />\n                          <span>\320\222\321\213\321\205\320\276\320\264</span>\n                        </span>\n                      </div>\n\n                      {/* \320\222\320\260\321\210 \320\275\320\276\320\274\320\265\321\200 */}\n                      <div>\n                        <div className=\"text-[11px] text-[#8E8E93] mb-1.5\">\320\222\320\260\321\210 \320\275\320\276\320\274\320\265\321\200</div>\n                        <button\n                          type=\"button\"\n                          onClick={handleCopyAccount}\n                          className=\"flex w-full items-center justify-between rounded-xl border border-[#2C2C30] bg-[#1E1E22] px-3.5 py-2.5 text-left cursor-pointer hover:border-[#FDE047]/40 transition-colors\"\n                        >\n                          <span className=\"font-mono text-xs font-bold tracking-wider text-[#FDE047]\">\n                            1234 5678 9012 3456\n                          </span>\n                          {copiedAccount ? (\n                            <Check className=\"h-3.5 w-3.5 text-[#FDE047]\" />\n                          ) : (\n                            <Copy className=\"h-3.5 w-3.5 text-[#8E8E93]\" />\n                          )}\n                        </button>\n                      </div>\n\n                      {/* \320\237\320\276\320\264\320\277\320\270\321\201\320\272\320\260 (Yellow Bordered Card) */}\n                      <div>\n                        <div className=\"text-[11px] text-[#8E8E93] mb-1.5\">\320\237\320\276\320\264\320\277\320\270\321\201\320\272\320\260</div>\n                        <div className=\"flex items-center justify-between rounded-2xl border border-[#FDE047] bg-[#1E1E22] p-3.5\">\n                          <div className=\"flex items-center gap-3\">\n                            <span className=\"flex h-8 w-8 items-center justify-center rounded-lg bg-white/[0.06] text-[#A1A1AA]\">\n                              <CreditCard className=\"h-4 w-4\" />\n                            </span>\n                            <div>\n                              <div className=\"text-xs font-bold text-[#FAFAFA]\">\320\237\320\276\320\264\320\277\320\270\321\201\320\272\320\260</div>\n                              <div className=\"text-[10px] text-[#8E8E93]\">\n                                \320\222\320\276\320\267\320\276\320\261\320\275\320\276\320\262\320\270\321\202\321\201\321\217 <span className=\"text-[#FAFAFA] font-semibold\">26 \320\276\320\272\321\202\321\217\320\261\321\200\321\217</span>\n                              </div>\n                            </div>\n                          </div>\n                          <ChevronRight className=\"h-4 w-4 text-[#8E8E93]\" />\n                        </div>\n                      </div>\n\n                      {/* \320\223\320\264\320\265 \320\264\320\276\320\273\320\266\320\265\320\275 \321\200\320\260\320\261\320\276\321\202\320\260\321\202\321\214 Anke? */}\n                      <div className=\"flex items-center justify-between rounded-2xl border border-[#2C2C30] bg-[#1E1E22] p-3.5\">\n                        <div>\n                          <div className=\"text-xs font-bold text-[#FAFAFA]\">\n                            \320\223\320\264\320\265 \320\264\320\276\320\273\320\266\320\265\320\275 \321\200\320\260\320\261\320\276\321\202\320\260\321\202\321\214 Anke?\n                          </div>\n                          <div className=\"text-[10px] text-[#8E8E93] mt-0.5\">\n                            \320\222\320\276 \320\262\321\201\320\265\321\205 \320\274\320\265\321\201\321\202\320\260\321\205 \302\267 1 \320\277\321\200\320\260\320\262\320\270\320\273\320\276\n                          </div>\n                        </div>\n                        <ChevronRight className=\"h-4 w-4 text-[#8E8E93]\" />\n                      </div>\n                    </div>\n\n                    {/* Bottom Utility Rows (\320\241\320\260\320\271\321\202 + 3 Action Buttons) */}\n                    <div className=\"space-y-2 pt-3\">\n                      <div className=\"flex items-center justify-between rounded-xl border border-[#2C2C30] bg-[#1E1E22] px-3.5 py-2.5 text-xs text-[#FAFAFA]\">\n                        <div className=\"flex items-center gap-2\">\n                          <Globe className=\"h-3.5 w-3.5 text-[#8E8E93]\" />\n                          <span>\320\241\320\260\320\271\321\202</span>\n                        </div>\n                        <ChevronRight className=\"h-3.5 w-3.5 text-[#8E8E93]\" />\n                      </div>\n\n                      <div className=\"grid grid-cols-3 gap-2\">\n                        <div className=\"flex items-center justify-center rounded-xl border border-[#2C2C30] bg-[#1E1E22] py-2.5 text-[#8E8E93]\">\n                          <Settings className=\"h-4 w-4\" />\n                        </div>\n                        <div className=\"flex items-center justify-center rounded-xl border border-[#2C2C30] bg-[#1E1E22] py-2.5 text-[#FAFAFA]\">\n                          <Send className=\"h-4 w-4\" />\n                        </div>\n                        <div className=\"flex items-center justify-center rounded-xl border border-[#2C2C30] bg-[#1E1E22] py-2.5 text-[#8E8E93]\">\n                          <Headphones className=\"h-4 w-4\" />\n                        </div>\n                      </div>\n                    </div>\n                  </motion.div>\n                )}\n              </AnimatePresence>\n            </div>\n          )}\n\n          {/* Authentic Bottom Tab Bar (\"\320\223\320\273\320\260\320\262\320\275\320\260\321\217\" | \"\320\240\320\265\320\263\320\270\320\276\320\275\321\213\" | \"\320\235\320\260\321\201\321\202\321\200\320\276\320\271\320\272\320\270\") */}\n          <div className=\"relative z-20 border-t border-white/[0.06] bg-[#161618] px-4 pt-2 pb-4\">\n            <div className=\"grid grid-cols-3 gap-1\">\n              <button\n                type=\"button\"\n                onClick={() => onTabChange(\'home\')}\n                className={`flex flex-col items-center gap-1 py-1 text-[10px] font-medium transition-colors cursor-pointer ${\n                  activeTab === \'home\' ? \'text-[#FDE047]\' : \'text-[#8E8E93] hover:text-[#FAFAFA]\'\n                }`}\n              >\n                <Home className=\"h-4 w-4\" />\n                <span>\320\223\320\273\320\260\320\262\320\275\320\260\321\217</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => onTabChange(\'regions\')}\n                className={`flex flex-col items-center gap-1 py-1 text-[10px] font-medium transition-colors cursor-pointer ${\n                  activeTab === \'regions\'\n                    ? \'text-[#FDE047]\'\n                    : \'text-[#8E8E93] hover:text-[#FAFAFA]\'\n                }`}\n              >\n                <Globe className=\"h-4 w-4\" />\n                <span>\320\240\320\265\320\263\320\270\320\276\320\275\321\213</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => onTabChange(\'settings\')}\n                className={`flex flex-col items-center gap-1 py-1 text-[10px] font-medium transition-colors cursor-pointer ${\n                  activeTab === \'settings\'\n                    ? \'text-[#FDE047]\'\n                    : \'text-[#8E8E93] hover:text-[#FAFAFA]\'\n                }`}\n              >\n                <Settings className=\"h-4 w-4\" />\n                <span>\320\235\320\260\321\201\321\202\321\200\320\276\320\271\320\272\320\270</span>\n              </button>\n            </div>\n            {/* iOS Home Indicator Bar */}\n            <div className=\"mx-auto mt-2 h-1 w-28 rounded-full bg-white/25\" />\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
