      create_file {
        instruction: "import React, { useState, useRef } from \'react\';\nimport { motion, useReducedMotion } from \'motion/react\';\nimport { Zap, Lock, Globe, Check } from \'lucide-react\';\nimport { OFFICIAL_SERVERS, OfficialServer } from \'../data/vpnData\';\nimport { SpotlightShell } from \'./AnkeLogo\';\n\nexport const BentoFeatures: React.FC = () => {\n  const shouldReduceMotion = useReducedMotion();\n  const [activeServer, setActiveServer] = useState<OfficialServer>(OFFICIAL_SERVERS[5]); // \320\220\320\273\320\261\320\260\320\275\320\270\321\217 YouTube \320\261\320\265\320\267 \321\200\320\265\320\272\320\273\320\260\320\274\321\213\n  const [isSpeedBoosted, setIsSpeedBoosted] = useState(false);\n  const [isPrivacyMasked, setIsPrivacyMasked] = useState(true);\n\n  return (\n    <section id=\"features\" className=\"relative py-24 lg:py-32 border-b border-[#2A2A2A]\">\n      <div className=\"mx-auto max-w-[1200px] px-4 sm:px-6\">\n        {/* Asymmetric Bento Grid with Official 3 Pillars + Server List */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">\n          {/* BENTO CARD 1: \320\241\320\272\320\276\321\200\320\276\321\201\321\202\321\214 (15 \320\223\320\261\320\270\321\202/\321\201) */}\n          <motion.div\n            initial={{ opacity: 0, y: 24 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: false, margin: \'-60px\' }}\n            transition={{ duration: 0.55, ease: [0.16, 1, 0.3, 1] }}\n            onMouseEnter={() => setIsSpeedBoosted(true)}\n            onMouseLeave={() => setIsSpeedBoosted(false)}\n            className=\"lg:col-span-7\"\n          >\n            <SpotlightShell\n              className=\"h-full hover:border-[#FDE047]/45\"\n              innerClassName=\"h-full p-6 sm:p-9 flex flex-col justify-between bg-gradient-to-br from-[#FDE047]/[0.05] via-transparent to-transparent\"\n            >\n              <div>\n                <div className=\"flex h-12 w-12 items-center justify-center rounded-xl border border-[#2A2A2A] bg-[#121212] text-[#FDE047]\">\n                  <Zap className=\"h-6 w-6\" />\n                </div>\n\n                <h3 className=\"mt-5 text-2xl sm:text-3xl font-bold tracking-tight text-[#FAFAFA]\">\n                  \320\241\320\272\320\276\321\200\320\276\321\201\321\202\321\214\n                </h3>\n                <p className=\"mt-2 text-base sm:text-lg text-[#A1A1AA] leading-relaxed\">\n                  \320\241\320\265\321\200\320\262\320\265\321\200\321\213 \321\201 \320\272\320\260\320\275\320\260\320\273\320\276\320\274 15 \320\223\320\261\320\270\321\202/\321\201. \320\235\320\270\320\272\320\260\320\272\320\270\321\205 \320\276\320\263\321\200\320\260\320\275\320\270\321\207\320\265\320\275\320\270\320\271 \320\277\320\276 \321\202\321\200\320\260\321\204\320\270\320\272\321\203\n                </p>\n              </div>\n\n              {/* Animated 15 Gbit/s Visualizer */}\n              <div className=\"mt-8 rounded-2xl border border-[#2A2A2A] bg-[#121212] p-5 overflow-hidden relative\">\n                <div className=\"flex items-baseline justify-between gap-4 mb-4\">\n                  <div>\n                    <span className=\"text-xs text-[#A1A1AA]\">\320\237\321\200\320\276\320\277\321\203\321\201\320\272\320\275\320\260\321\217 \321\201\320\277\320\276\321\201\320\276\320\261\320\275\320\276\321\201\321\202\321\214</span>\n                    <div className=\"text-3xl sm:text-4xl font-bold font-mono text-[#FDE047] tabular-nums mt-0.5\">\n                      15 \320\223\320\261\320\270\321\202/\321\201\n                    </div>\n                  </div>\n                  <span className=\"text-xs font-medium text-[#FAFAFA]/80\">\n                    \320\221\320\265\320\267\320\273\320\270\320\274\320\270\321\202\320\275\321\213\320\271 \321\202\321\200\320\260\321\204\320\270\320\272\n                  </span>\n                </div>\n\n                {/* Animated High-Speed Light Streams */}\n                <div className=\"space-y-2.5\">\n                  {[0.92, 1, 0.85].map((widthRatio, idx) => (\n                    <div\n                      key={idx}\n                      className=\"relative h-2.5 w-full overflow-hidden rounded-full bg-[#1E1E1E]\"\n                    >\n                      <motion.div\n                        initial={{ width: \'35%\' }}\n                        whileInView={{ width: `${widthRatio * 100}%` }}\n                        viewport={{ once: false }}\n                        animate={{\n                          width: isSpeedBoosted ? \'100%\' : `${widthRatio * 100}%`,\n                        }}\n                        transition={{ duration: 0.7, delay: idx * 0.1, ease: [0.16, 1, 0.3, 1] }}\n                        className=\"h-full rounded-full bg-gradient-to-r from-[#FDE047]/40 via-[#FDE047] to-[#FAFAFA]\"\n                      />\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </SpotlightShell>\n          </motion.div>\n\n          {/* BENTO CARD 2: \320\237\321\200\320\270\320\262\320\260\321\202\320\275\320\276\321\201\321\202\321\214 */}\n          <motion.div\n            initial={{ opacity: 0, y: 24 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: false, margin: \'-60px\' }}\n            transition={{ duration: 0.55, delay: 0.08, ease: [0.16, 1, 0.3, 1] }}\n            className=\"lg:col-span-5\"\n          >\n            <SpotlightShell\n              className=\"h-full hover:border-[#FDE047]/45\"\n              innerClassName=\"h-full p-6 sm:p-9 flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex h-12 w-12 items-center justify-center rounded-xl border border-[#2A2A2A] bg-[#121212] text-[#FDE047]\">\n                  <Lock className=\"h-6 w-6\" />\n                </div>\n\n                <h3 className=\"mt-5 text-2xl sm:text-3xl font-bold tracking-tight text-[#FAFAFA]\">\n                  \320\237\321\200\320\270\320\262\320\260\321\202\320\275\320\276\321\201\321\202\321\214\n                </h3>\n                <p className=\"mt-2 text-base sm:text-lg text-[#A1A1AA] leading-relaxed\">\n                  \320\222\320\260\321\210\320\270 \320\264\320\260\320\275\320\275\321\213\320\265 \320\270 \320\260\320\272\321\202\320\270\320\262\320\275\320\276\321\201\321\202\321\214 \320\275\320\265 \321\201\320\276\321\205\321\200\320\260\320\275\321\217\321\216\321\202\321\201\321\217\n                </p>\n              </div>\n\n              {/* Interactive Animated Privacy Shield Demo */}\n              <div\n                onClick={() => setIsPrivacyMasked((prev) => !prev)}\n                className=\"mt-8 rounded-2xl border border-[#2A2A2A] bg-[#121212] p-5 cursor-pointer select-none group\"\n              >\n                <div className=\"flex items-center justify-between text-xs text-[#A1A1AA] mb-3\">\n                  <span>\320\241\321\202\320\260\321\202\321\203\321\201 \320\260\320\272\321\202\320\270\320\262\320\275\320\276\321\201\321\202\320\270</span>\n                  <span className=\"text-[#FDE047] group-hover:underline\">\n                    {isPrivacyMasked ? \'\320\241\320\272\321\200\321\213\321\202\320\276\' : \'\320\235\320\260\320\266\320\274\320\270\321\202\320\265 \320\264\320\273\321\217 \320\267\320\260\321\211\320\270\321\202\321\213\'}\n                  </span>\n                </div>\n\n                <div className=\"space-y-2 font-mono text-xs\">\n                  {[\n                    { label: \'IP-\320\260\320\264\321\200\320\265\321\201\', raw: \'185.220.101.42\', masked: \'\342\200\242\342\200\242\342\200\242.\342\200\242\342\200\242\342\200\242.\342\200\242\342\200\242\342\200\242.\342\200\242\342\200\242\342\200\242\' },\n                    { label: \'\320\230\321\201\321\202\320\276\321\200\320\270\321\217 \320\277\320\276\321\201\320\265\321\211\320\265\320\275\320\270\320\271\', raw: \'\320\235\320\265 \320\267\320\260\320\277\320\270\321\201\321\213\320\262\320\260\320\265\321\202\321\201\321\217\', masked: \'\320\235\320\265 \321\201\320\276\321\205\321\200\320\260\320\275\321\217\320\265\321\202\321\201\321\217\' },\n                    { label: \'\320\233\320\270\321\207\320\275\321\213\320\265 \320\264\320\260\320\275\320\275\321\213\320\265\', raw: \'\320\227\320\260\321\211\320\270\321\211\320\265\320\275\321\213\', masked: \'\320\220\320\275\320\276\320\275\320\270\320\274\320\275\320\276\' },\n                  ].map((row, idx) => (\n                    <div\n                      key={idx}\n                      className=\"flex items-center justify-between rounded-xl border border-[#2A2A2A]/80 bg-[#181818] px-3.5 py-2.5\"\n                    >\n                      <span className=\"text-[#A1A1AA]\">{row.label}</span>\n                      <motion.span\n                        key={isPrivacyMasked ? \'masked\' : \'raw\'}\n                        initial={{ opacity: 0, filter: \'blur(4px)\' }}\n                        animate={{ opacity: 1, filter: \'blur(0px)\' }}\n                        transition={{ duration: 0.2 }}\n                        className=\"text-[#FDE047] font-semibold\"\n                      >\n                        {isPrivacyMasked ? row.masked : row.raw}\n                      </motion.span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </SpotlightShell>\n          </motion.div>\n\n          {/* BENTO CARD 3: \320\224\320\276\321\201\321\202\321\203\320\277\320\275\320\276\321\201\321\202\321\214 & Exact Official Server List (Col Span 7) */}\n          <motion.div\n            initial={{ opacity: 0, y: 24 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: false, margin: \'-60px\' }}\n            transition={{ duration: 0.55, delay: 0.14, ease: [0.16, 1, 0.3, 1] }}\n            className=\"lg:col-span-7\"\n          >\n            <SpotlightShell\n              className=\"h-full hover:border-[#FDE047]/45\"\n              innerClassName=\"h-full p-6 sm:p-7 flex flex-col justify-start\"\n            >\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"flex h-10 w-10 items-center justify-center rounded-xl border border-[#2A2A2A] bg-[#121212] text-[#FDE047] shrink-0\">\n                    <Globe className=\"h-5 w-5\" />\n                  </div>\n                  <div>\n                    <h3 className=\"text-xl sm:text-2xl font-bold tracking-tight text-[#FAFAFA]\">\n                      \320\224\320\276\321\201\321\202\321\203\320\277\320\275\320\276\321\201\321\202\321\214\n                    </h3>\n                    <p className=\"text-xs sm:text-sm text-[#A1A1AA]\">\n                      \320\234\320\276\320\274\320\265\320\275\321\202\320\260\320\273\321\214\320\275\320\276\320\265 \320\277\320\276\320\264\320\272\320\273\321\216\321\207\320\265\320\275\320\270\320\265 \320\272 \321\201\320\265\321\200\320\262\320\265\321\200\320\260\320\274\n                    </p>\n                  </div>\n                </div>\n                <span className=\"text-xs font-semibold text-[#FDE047] self-start sm:self-center\">\n                  \320\237\321\200\320\265\320\274\320\270\321\203\320\274 \321\201\320\265\321\200\320\262\320\265\321\200\321\213\n                </span>\n              </div>\n\n              {/* Exact 8 Official Production Servers */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                {OFFICIAL_SERVERS.map((server, idx) => {\n                  const isSelected = activeServer.id === server.id;\n                  return (\n                    <motion.button\n                      key={server.id}\n                      type=\"button\"\n                      onClick={() => setActiveServer(server)}\n                      initial={{ opacity: 0, y: 12 }}\n                      whileInView={{ opacity: 1, y: 0 }}\n                      viewport={{ once: false }}\n                      transition={{\n                        duration: 0.35,\n                        delay: idx * 0.04,\n                        ease: [0.16, 1, 0.3, 1],\n                      }}\n                      whileHover={{ y: -2 }}\n                      whileTap={{ scale: 0.98 }}\n                      className={`flex items-center justify-between gap-2 rounded-xl border p-2.5 text-left transition-all cursor-pointer ${\n                        isSelected\n                          ? \'border-[#FDE047] bg-[#FDE047]/[0.09] shadow-[0_0_24px_rgba(253,224,71,0.12)]\'\n                          : \'border-[#2A2A2A] bg-[#121212] hover:border-[#FAFAFA]/30\'\n                      }`}\n                    >\n                      <div className=\"flex items-center gap-3 min-w-0\">\n                        <img\n                          src={server.flagUrl}\n                          alt={server.country}\n                          referrerPolicy=\"no-referrer\"\n                          className=\"h-8 w-8 rounded-full object-cover shrink-0 border border-white/10\"\n                        />\n                        <div className=\"min-w-0\">\n                          <div className=\"text-xs sm:text-sm font-bold text-[#FAFAFA] truncate\">\n                            {server.country}\n                          </div>\n                          <div className=\"text-[11px] text-[#A1A1AA] truncate\">\n                            {server.city}\n                          </div>\n                        </div>\n                      </div>\n\n                      {server.tag ? (\n                        <span className=\"shrink-0 rounded-lg border border-[#FDE047]/40 bg-[#FDE047]/15 px-2 py-0.5 text-[10px] font-medium text-[#FAFAFA]\">\n                          <strong className=\"text-[#FDE047]\">{server.tag.name}</strong>{\' \'}\n                          <span className=\"text-[#A1A1AA]\">{server.tag.note}</span>\n                        </span>\n                      ) : (\n                        isSelected && (\n                          <span className=\"flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#FDE047] text-black\">\n                            <Check className=\"h-3 w-3 stroke-[2.5]\" />\n                          </span>\n                        )\n                      )}\n                    </motion.button>\n                  );\n                })}\n              </div>\n            </SpotlightShell>\n          </motion.div>\n\n          {/* BENTO CARD 4: \320\243\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262\320\260 \320\270 \320\263\320\270\320\261\320\272\320\270\320\265 \320\277\321\200\320\260\320\262\320\270\320\273\320\260 \321\200\320\260\320\261\320\276\321\202\321\213 Anke (Col Span 5) */}\n          <motion.div\n            initial={{ opacity: 0, y: 24 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: false, margin: \'-60px\' }}\n            transition={{ duration: 0.55, delay: 0.2, ease: [0.16, 1, 0.3, 1] }}\n            className=\"lg:col-span-5\"\n          >\n            <SpotlightShell\n              className=\"h-full hover:border-[#FDE047]/45\"\n              innerClassName=\"h-full p-6 sm:p-9 flex flex-col justify-between gap-6\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between gap-3\">\n                  <span className=\"rounded-full border border-[#FDE047]/35 bg-[#FDE047]/10 px-3 py-1 text-xs font-mono font-semibold text-[#FDE047]\">\n                    \320\224\320\276 5 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262\n                  </span>\n                  <span className=\"text-xs font-mono text-[#A1A1AA]\">\n                    \320\225\320\264\320\270\320\275\320\260\321\217 \320\277\320\276\320\264\320\277\320\270\321\201\320\272\320\260\n                  </span>\n                </div>\n\n                <h3 className=\"mt-4 text-2xl sm:text-3xl font-bold tracking-tight text-[#FAFAFA]\">\n                  \320\243\320\274\320\275\321\213\320\265 \320\277\321\200\320\260\320\262\320\270\320\273\320\260 \320\270 \321\200\320\260\320\261\320\276\321\202\320\260 \320\275\320\260 \320\262\321\201\320\265\321\205 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262\320\260\321\205\n                </h3>\n                <p className=\"mt-2 text-sm sm:text-base text-[#A1A1AA] leading-relaxed\">\n                  \320\235\320\260\321\201\321\202\321\200\320\260\320\270\320\262\320\260\320\271\321\202\320\265, \320\263\320\264\320\265 \320\264\320\276\320\273\320\266\320\265\320\275 \321\200\320\260\320\261\320\276\321\202\320\260\321\202\321\214 Anke, \320\270 \320\277\320\276\320\264\320\272\320\273\321\216\321\207\320\260\320\271\321\202\320\265 \321\201\320\274\320\260\321\200\321\202\321\204\320\276\320\275\321\213, \320\277\320\273\320\260\320\275\321\210\320\265\321\202\321\213 \320\270 \320\272\320\276\320\274\320\277\321\214\321\216\321\202\320\265\321\200\321\213 \320\276\320\264\320\275\320\276\320\262\321\200\320\265\320\274\320\265\320\275\320\275\320\276 \320\261\320\265\320\267 \320\277\320\276\321\202\320\265\321\200\320\270 \321\201\320\272\320\276\321\200\320\276\321\201\321\202\320\270.\n                </p>\n              </div>\n\n              {/* Interactive App Rules & Connected Devices Panel */}\n              <div className=\"flex-1 flex flex-col justify-between gap-3 rounded-2xl border border-[#2A2A2A] bg-[#121212] p-4 sm:p-5\">\n                {/* Rule Selector Card from Official App UI */}\n                <div className=\"rounded-xl border border-[#FDE047]/50 bg-[#18181B] p-3.5\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-xs font-bold text-[#FAFAFA]\">\n                      \320\223\320\264\320\265 \320\264\320\276\320\273\320\266\320\265\320\275 \321\200\320\260\320\261\320\276\321\202\320\260\321\202\321\214 Anke?\n                    </span>\n                    <span className=\"h-2 w-2 rounded-full bg-[#FDE047]\" />\n                  </div>\n                  <div className=\"mt-1 text-[11px] text-[#A1A1AA]\">\n                    \320\222\320\276 \320\262\321\201\320\265\321\205 \320\274\320\265\321\201\321\202\320\260\321\205 \302\267 YouTube \320\261\320\265\320\267 \321\200\320\265\320\272\320\273\320\260\320\274\321\213 \302\267 \320\237\321\200\321\217\320\274\320\276\320\271 \320\264\320\276\321\201\321\202\321\203\320\277 \320\272 \320\273\320\276\320\272\320\260\320\273\321\214\320\275\321\213\320\274 \321\201\320\260\320\271\321\202\320\260\320\274\n                  </div>\n                </div>\n\n                {/* Connected Devices List with Animated Traffic Bars */}\n                <div className=\"space-y-2 my-1\">\n                  <div className=\"flex items-center justify-between text-[11px] font-mono text-[#A1A1AA] px-1\">\n                    <span>\320\220\320\272\321\202\320\270\320\262\320\275\321\213\320\265 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262\320\260 (4 \320\270\320\267 5)</span>\n                    <span className=\"text-[#FDE047]\">\320\257\320\264\321\200\320\276 Mantle</span>\n                  </div>\n\n                  {[\n                    { name: \'iPhone 15 Pro Max\', os: \'iOS \302\267 5 \320\234\320\221 \320\236\320\227\320\243\', region: \'\320\250\320\262\320\265\321\206\320\270\321\217\', load: 78 },\n                    { name: \'MacBook Pro 16\"\', os: \'macOS \302\267 App Store\', region: \'\320\223\320\265\321\200\320\274\320\260\320\275\320\270\321\217\', load: 92 },\n                    { name: \'Windows 11 PC\', os: \'Windows \302\267 x64\', region: \'\320\220\320\273\320\261\320\260\320\275\320\270\321\217 (YouTube)\', load: 64 },\n                    { name: \'Samsung Galaxy\', os: \'Android \302\267 21 \320\234\320\221 \320\236\320\227\320\243\', region: \'\320\244\320\270\320\275\320\273\321\217\320\275\320\264\320\270\321\217\', load: 52 },\n                  ].map((dev, i) => (\n                    <motion.div\n                      key={dev.name}\n                      initial={{ opacity: 0, x: 12 }}\n                      whileInView={{ opacity: 1, x: 0 }}\n                      viewport={{ once: false }}\n                      transition={{ duration: 0.35, delay: i * 0.06 }}\n                      whileHover={{ x: 3 }}\n                      className=\"rounded-xl border border-[#2A2A2A] bg-[#181818] p-3 transition-colors hover:border-[#FDE047]/40\"\n                    >\n                      <div className=\"flex items-center justify-between gap-2\">\n                        <div>\n                          <div className=\"text-xs font-bold text-[#FAFAFA]\">{dev.name}</div>\n                          <div className=\"text-[11px] text-[#8E8E93]\">{dev.os}</div>\n                        </div>\n                        <span className=\"rounded-lg bg-white/[0.04] border border-white/[0.06] px-2.5 py-1 text-[11px] font-medium text-[#FDE047]\">\n                          {dev.region}\n                        </span>\n                      </div>\n                      <div className=\"mt-2.5 h-1.5 w-full overflow-hidden rounded-full bg-[#242428]\">\n                        <motion.div\n                          initial={{ width: \'15%\' }}\n                          whileInView={{ width: `${dev.load}%` }}\n                          viewport={{ once: false }}\n                          transition={{\n                            duration: 0.9,\n                            delay: 0.15 + i * 0.1,\n                            ease: [0.16, 1, 0.3, 1],\n                          }}\n                          className=\"h-full rounded-full bg-gradient-to-r from-[#FDE047]/50 to-[#FDE047]\"\n                        />\n                      </div>\n                    </motion.div>\n                  ))}\n                </div>\n\n                {/* Bottom Status Strip */}\n                <div className=\"flex items-center justify-between border-t border-[#2A2A2A] pt-3 text-xs\">\n                  <span className=\"text-[#A1A1AA]\">\320\236\320\263\321\200\320\260\320\275\320\270\321\207\320\265\320\275\320\270\321\217 \320\277\320\276 \321\202\321\200\320\260\321\204\320\270\320\272\321\203</span>\n                  <span className=\"font-mono font-bold text-[#FDE047]\">\320\236\321\202\321\201\321\203\321\202\321\201\321\202\320\262\321\203\321\216\321\202 (\342\210\236)</span>\n                </div>\n              </div>\n            </SpotlightShell>\n          </motion.div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
