              text: "    question: \'\320\240\320\260\320\261\320\276\321\202\320\260\320\265\321\202 \320\273\320\270 Anke VPN \320\262 \321\203\321\201\320\273\320\276\320\262\320\270\321\217\321\205 \320\266\320\265\321\201\321\202\320\272\320\270\321\205 DPI-\320\261\320\273\320\276\320\272\320\270\321\200\320\276\320\262\320\276\320\272 \320\277\321\200\320\276\320\262\320\260\320\271\320\264\320\265\321\200\320\276\320\262?\',"
