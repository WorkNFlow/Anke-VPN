            }
            lines {
              text: "    // Smoothstep easing for vertical/horizontal base interpolation"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const smoothT = rawT * rawT * (3 - 2 * rawT);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // Symmetric parabola 4 * t * (1 - t), peaking at 1.0 when passing behind #platforms"
