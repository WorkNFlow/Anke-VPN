            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // Horizontal parabolic arc amplitude (sweeps inward toward center on desktop, then back out to right slot)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const arcAmplitude = shouldReduceMotion ? 0 : vw >= 1024 ? -210 : vw >= 640 ? -70 : 0;"
