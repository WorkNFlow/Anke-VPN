  code_action {
    action_spec {
      create_file {
        instruction: "@import \"tailwindcss\";\n@custom-variant dark (&:where(.dark, .dark *));\n\n:root {\n  --background: #111111;\n  --foreground: #FAFAFA;\n  --muted: #161616;\n  --muted-foreground: #A1A1AA;\n  --primary: #FDE047;\n  --primary-foreground: #000000;\n  --card: #1A1A1A;\n  --card-foreground: #FAFAFA;\n  --border: #2A2A2A;\n  --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);\n  --ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1);\n  --ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);\n}\n\n@theme {\n  --font-sans: \"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace;\n  --color-background: var(--background);\n  --color-foreground: var(--foreground);\n  --color-muted: var(--muted);\n  --color-muted-foreground: var(--muted-foreground);\n  --color-primary: var(--primary);\n  --color-primary-foreground: var(--primary-foreground);\n  --color-card: var(--card);\n  --color-card-foreground: var(--card-foreground);\n  --color-border: var(--border);\n}\n\nhtml {\n  scroll-behavior: smooth;\n  background-color: var(--background);\n  color: var(--foreground);\n  font-family: var(--font-sans);\n}\n\n/* Tactile button and interactive surface transitions */\n.tactile-btn {\n  transition: transform 150ms var(--ease-out-expo), background-color 150ms ease-out, border-color 150ms ease-out, box-shadow 150ms ease-out;\n}\n\n.tactile-btn:active {\n  transform: scale(0.98);\n}\n\n/* Double-bezel (Doppelrand) hardware card shell */\n.double-bezel-shell {\n  background-color: rgba(255, 255, 255, 0.02);\n  border: 1px solid var(--border);\n  border-radius: 1rem; /* rounded-2xl */\n  padding: 0.375rem; /* p-1.5 */\n  transition: border-color 250ms var(--ease-out-expo), transform 250ms var(--ease-out-expo);\n}\n\n.double-bezel-core {\n  background-color: var(--card);\n  border-radius: 0.625rem; /* concentric inner radius: 16px - 6px = 10px */\n  box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.07);\n}\n\n/* Subtle structural grid pattern inspired by Subframe / Linear / Schema */\n.bg-structural-grid {\n  background-size: 48px 48px;\n  background-image: \n    linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);\n}\n\n/* Reduced motion accessibility */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n"
        path {
          absolute_uri: "file:///src/index.css"
        }
        overwrite: true
      }
    }
