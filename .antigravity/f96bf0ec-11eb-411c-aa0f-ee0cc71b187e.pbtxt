  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useRef } from \'react\';\nimport {\n  motion,\n  useScroll,\n  useTransform,\n  useMotionValue,\n  useSpring,\n  useReducedMotion,\n  AnimatePresence,\n} from \'motion/react\';\nimport { Power, Image as ImageIcon, Upload, ChevronRight, Sparkles } from \'lucide-react\';\nimport { OFFICIAL_SERVERS, OfficialServer } from \'../data/vpnData\';\nimport { AnkeLogo } from \'./AnkeLogo\';\n\nexport const HeroMockup: React.FC = () => {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n  const shouldReduceMotion = useReducedMotion();\n\n  const [isConnected, setIsConnected] = useState(true);\n  const [selectedServer, setSelectedServer] = useState<OfficialServer>(OFFICIAL_SERVERS[0]);\n  const [viewMode, setViewMode] = useState<\'interactive\' | \'placeholder\'>(\'interactive\');\n  const [customScreenshotUrl, setCustomScreenshotUrl] = useState<string | null>(null);\n\n  // Scroll parallax\n  const { scrollYProgress } = useScroll({\n    target: containerRef,\n    offset: [\'start end\', \'end start\'],\n  });\n  const yParallax = useTransform(\n    scrollYProgress,\n    [0, 1],\n    shouldReduceMotion ? [0, 0] : [20, -28]\n  );\n\n  // 3D Mouse-tracking spring physics (inspired by Legend.xyz & Subframe)\n  const mouseX = useMotionValue(0);\n  const mouseY = useMotionValue(0);\n\n  const rotateX = useSpring(useTransform(mouseY, [-0.5, 0.5], shouldReduceMotion ? [0, 0] : [7, -7]), {\n    stiffness: 150,\n    damping: 18,\n  });\n  const rotateY = useSpring(useTransform(mouseX, [-0.5, 0.5], shouldReduceMotion ? [0, 0] : [-9, 9]), {\n    stiffness: 150,\n    damping: 18,\n  });\n\n  const handleMouseMove = (e: React.MouseEvent<HTMLDivElement>) => {\n    if (!containerRef.current || shouldReduceMotion) return;\n    const rect = containerRef.current.getBoundingClientRect();\n    const xPct = (e.clientX - rect.left) / rect.width - 0.5;\n    const yPct = (e.clientY - rect.top) / rect.height - 0.5;\n    mouseX.set(xPct);\n    mouseY.set(yPct);\n  };\n\n  const handleMouseLeave = () => {\n    mouseX.set(0);\n    mouseY.set(0);\n  };\n\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    setCustomScreenshotUrl(URL.createObjectURL(file));\n    setViewMode(\'placeholder\');\n  };\n\n  return (\n    <motion.div\n      ref={containerRef}\n      style={{ y: yParallax, perspective: 1100 }}\n      onMouseMove={handleMouseMove}\n      onMouseLeave={handleMouseLeave}\n      className=\"relative w-full max-w-[520px] mx-auto lg:ml-auto\"\n    >\n      {/* Animated Floating Official Anke Logo Watermark / Glow in background */}\n      <motion.div\n        aria-hidden=\"true\"\n        animate={\n          shouldReduceMotion\n            ? {}\n            : {\n                y: [0, -12, 0],\n                scale: [1, 1.04, 1],\n              }\n        }\n        transition={{ duration: 6, repeat: Infinity, ease: \'easeInOut\' }}\n        className=\"pointer-events-none absolute -top-10 -right-6 z-0 opacity-20 blur-[1px]\"\n      >\n        <AnkeLogo className=\"h-36 w-auto\" />\n      </motion.div>\n\n      <div\n        aria-hidden=\"true\"\n        className=\"pointer-events-none absolute -inset-6 rounded-3xl bg-gradient-to-tr from-[#FDE047]/[0.12] via-[#FDE047]/[0.03] to-transparent blur-2xl\"\n      />\n\n      {/* Mode Switcher Bar */}\n      <div className=\"relative z-10 mb-3 flex items-center justify-between gap-2 text-xs text-[#A1A1AA]\">\n        <span>Anke Connect</span>\n        <div className=\"flex items-center gap-1 rounded-lg border border-[#2A2A2A] bg-[#161616] p-0.5\">\n          <button\n            type=\"button\"\n            onClick={() => setViewMode(\'interactive\')}\n            className={`tactile-btn rounded-md px-2.5 py-1 text-xs font-medium cursor-pointer ${\n              viewMode === \'interactive\'\n                ? \'bg-[#2A2A2A] text-[#FAFAFA]\'\n                : \'text-[#A1A1AA] hover:text-[#FAFAFA]\'\n            }`}\n          >\n            \320\230\320\275\321\202\320\265\321\200\320\260\320\272\321\202\320\270\320\262\320\275\320\276\320\265 \320\277\321\200\320\265\320\262\321\214\321\216\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setViewMode(\'placeholder\')}\n            className={`tactile-btn rounded-md px-2.5 py-1 text-xs font-medium cursor-pointer ${\n              viewMode === \'placeholder\'\n                ? \'bg-[#2A2A2A] text-[#FAFAFA]\'\n                : \'text-[#A1A1AA] hover:text-[#FAFAFA]\'\n            }`}\n          >\n            \320\241\320\262\320\276\320\271 \321\201\320\272\321\200\320\270\320\275\321\210\320\276\321\202\n          </button>\n        </div>\n      </div>\n\n      {/* 3D Tilted Double-Bezel App Frame */}\n      <motion.div\n        style={{\n          rotateX,\n          rotateY,\n          transformStyle: \'preserve-3d\',\n        }}\n        className=\"relative z-10 double-bezel-shell lg:-rotate-[1.5deg] shadow-[0_28px_70px_rgba(0,0,0,0.8)] border-[#2A2A2A] hover:border-[#FDE047]/45 transition-colors duration-300\"\n      >\n        <div className=\"double-bezel-core overflow-hidden border border-white/[0.06] bg-[#161616]\">\n          {/* App Top Bar with Official Logo */}\n          <div className=\"flex items-center justify-between border-b border-[#2A2A2A] bg-[#121212] px-5 py-3.5\">\n            <div className=\"flex items-center gap-2.5\">\n              <img\n                src=\"/logo.svg\"\n                alt=\"Anke Logo\"\n                referrerPolicy=\"no-referrer\"\n                className=\"h-5 w-auto\"\n              />\n              <span className=\"text-sm font-bold tracking-tight text-[#FAFAFA]\">\n                Anke Connect\n              </span>\n            </div>\n            <span className=\"text-xs font-mono text-[#FDE047] tabular-nums\">\n              15 \320\223\320\261\320\270\321\202/\321\201\n            </span>\n          </div>\n\n          {viewMode === \'placeholder\' ? (\n            <div className=\"relative flex min-h-[410px] flex-col items-center justify-center bg-[#141414] p-6 text-center\">\n              <input\n                ref={fileInputRef}\n                type=\"file\"\n                accept=\"image/*\"\n                onChange={handleFileUpload}\n                className=\"hidden\"\n              />\n              {customScreenshotUrl ? (\n                <div className=\"w-full overflow-hidden rounded-xl border border-[#2A2A2A]\">\n                  <img\n                    src={customScreenshotUrl}\n                    alt=\"\320\241\320\272\321\200\320\270\320\275\321\210\320\276\321\202 \320\277\321\200\320\270\320\273\320\276\320\266\320\265\320\275\320\270\321\217 Anke\"\n                    referrerPolicy=\"no-referrer\"\n                    className=\"h-auto w-full object-cover\"\n                  />\n                  <div className=\"flex items-center justify-between bg-[#1A1A1A] px-3.5 py-2.5 text-xs text-[#A1A1AA] border-t border-[#2A2A2A]\">\n                    <span>\320\222\320\260\321\210 \321\201\320\272\321\200\320\270\320\275\321\210\320\276\321\202 \321\203\321\201\321\202\320\260\320\275\320\276\320\262\320\273\320\265\320\275</span>\n                    <button\n                      type=\"button\"\n                      onClick={() => fileInputRef.current?.click()}\n                      className=\"tactile-btn text-[#FDE047] hover:underline cursor-pointer\"\n                    >\n                      \320\227\320\260\320\274\320\265\320\275\320\270\321\202\321\214\n                    </button>\n                  </div>\n                </div>\n              ) : (\n                <div className=\"flex max-w-xs flex-col items-center\">\n                  <div className=\"mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-[#2A2A2A] bg-[#1A1A1A] text-[#FDE047]\">\n                    <ImageIcon className=\"h-6 w-6\" />\n                  </div>\n                  <p className=\"text-base font-bold text-[#FAFAFA]\">\n                    \320\234\320\265\321\201\321\202\320\276 \320\264\320\273\321\217 \320\262\320\260\321\210\320\265\320\263\320\276 \321\201\320\272\321\200\320\270\320\275\321\210\320\276\321\202\320\260\n                  </p>\n                  <p className=\"mt-1.5 text-xs leading-relaxed text-[#A1A1AA]\">\n                    \320\227\320\260\320\263\321\200\321\203\320\267\320\270\321\202\320\265 \321\201\320\272\321\200\320\270\320\275\321\210\320\276\321\202 \320\270\320\275\321\202\320\265\321\200\321\204\320\265\320\271\321\201\320\260 \320\277\321\200\320\270\320\273\320\276\320\266\320\265\320\275\320\270\321\217, \321\207\321\202\320\276\320\261\321\213 \320\277\320\276\321\201\320\274\320\276\321\202\321\200\320\265\321\202\321\214, \320\272\320\260\320\272 \320\276\320\275 \321\201\320\274\320\276\321\202\321\200\320\270\321\202\321\201\321\217 \320\262 3D-\321\200\320\260\320\274\320\272\320\265.\n                  </p>\n                  <div className=\"mt-5 flex flex-wrap items-center justify-center gap-2.5\">\n                    <button\n                      type=\"button\"\n                      onClick={() => fileInputRef.current?.click()}\n                      className=\"tactile-btn inline-flex items-center gap-2 rounded-xl bg-[#FDE047] px-4 py-2.5 text-xs font-bold text-black hover:bg-[#FDE047]/90 cursor-pointer\"\n                    >\n                      <Upload className=\"h-3.5 w-3.5\" />\n                      <span>\320\222\321\213\320\261\321\200\320\260\321\202\321\214 \321\204\320\260\320\271\320\273</span>\n                    </button>\n                  </div>\n                </div>\n              )}\n            </div>\n          ) : (\n            <div className=\"p-5 sm:p-6 bg-[#181818]\">\n              {/* Center Animated Power Button & Connection Status */}\n              <div className=\"relative flex flex-col items-center justify-center rounded-2xl border border-[#2A2A2A] bg-[#121212] py-7 px-4 overflow-hidden\">\n                {/* Animated glowing pulse rings when connected */}\n                <AnimatePresence>\n                  {isConnected && !shouldReduceMotion && (\n                    <motion.div\n                      key=\"pulse-ring\"\n                      initial={{ scale: 0.8, opacity: 0.5 }}\n                      animate={{ scale: 1.75, opacity: 0 }}\n                      transition={{ duration: 2.2, repeat: Infinity, ease: \'easeOut\' }}\n                      className=\"pointer-events-none absolute h-20 w-20 rounded-full border border-[#FDE047]/40\"\n                    />\n                  )}\n                </AnimatePresence>\n\n                <motion.button\n                  type=\"button\"\n                  onClick={() => setIsConnected((prev) => !prev)}\n                  whileHover={{ scale: 1.05 }}\n                  whileTap={{ scale: 0.94 }}\n                  aria-label={isConnected ? \'\320\236\321\202\320\272\320\273\321\216\321\207\320\270\321\202\321\214 \321\201\320\276\320\265\320\264\320\270\320\275\320\265\320\275\320\270\320\265\' : \'\320\237\320\276\320\264\320\272\320\273\321\216\321\207\320\270\321\202\321\214\'}\n                  className={`relative z-10 flex h-20 w-20 items-center justify-center rounded-full border-2 transition-colors duration-300 cursor-pointer ${\n                    isConnected\n                      ? \'border-[#FDE047] bg-[#FDE047] text-black shadow-[0_0_40px_rgba(253,224,71,0.35)]\'\n                      : \'border-[#2A2A2A] bg-[#1E1E1E] text-[#A1A1AA] hover:border-[#FAFAFA]/40 hover:text-[#FAFAFA]\'\n                  }`}\n                >\n                  <Power className=\"h-8 w-8 stroke-[2.3]\" />\n                </motion.button>\n\n                <div className=\"mt-4 text-center\">\n                  <div className=\"text-base font-bold text-[#FAFAFA]\">\n                    {isConnected ? \'\320\241\320\276\320\265\320\264\320\270\320\275\320\265\320\275\320\270\320\265 \320\267\320\260\321\211\320\270\321\211\320\265\320\275\320\276\' : \'\320\235\320\260\320\266\320\274\320\270\321\202\320\265 \320\264\320\273\321\217 \320\277\320\276\320\264\320\272\320\273\321\216\321\207\320\265\320\275\320\270\321\217\'}\n                  </div>\n                  <div className=\"mt-0.5 text-xs text-[#A1A1AA]\">\n                    {isConnected\n                      ? `${selectedServer.country}, ${selectedServer.city} \302\267 \320\234\320\276\320\274\320\265\320\275\321\202\320\260\320\273\321\214\320\275\320\276\320\265 \320\277\320\276\320\264\320\272\320\273\321\216\321\207\320\265\320\275\320\270\320\265`\n                      : \'\320\222\321\213\320\261\320\265\321\200\320\270\321\202\320\265 \321\201\320\265\321\200\320\262\320\265\321\200 \320\275\320\270\320\266\320\265\'}\n                  </div>\n                </div>\n              </div>\n\n              {/* Official Servers Quick Switcher inside the App Mockup */}\n              <div className=\"mt-4\">\n                <div className=\"mb-2.5 flex items-center justify-between text-xs text-[#A1A1AA]\">\n                  <span>\320\237\321\200\320\265\320\274\320\270\321\203\320\274 \321\201\320\265\321\200\320\262\320\265\321\200\321\213</span>\n                  <span>\320\232\320\260\320\275\320\260\320\273 15 \320\223\320\261\320\270\321\202/\321\201</span>\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                  {OFFICIAL_SERVERS.slice(0, 4).map((srv) => {\n                    const active = selectedServer.id === srv.id;\n                    return (\n                      <motion.button\n                        key={srv.id}\n                        type=\"button\"\n                        whileHover={{ y: -2 }}\n                        whileTap={{ scale: 0.98 }}\n                        onClick={() => {\n                          setSelectedServer(srv);\n                          setIsConnected(true);\n                        }}\n                        className={`flex items-center justify-between rounded-xl border p-2.5 text-left transition-colors cursor-pointer ${\n                          active\n                            ? \'border-[#FDE047]/65 bg-[#FDE047]/[0.09] text-[#FAFAFA]\'\n                            : \'border-[#2A2A2A] bg-[#121212] text-[#A1A1AA] hover:border-[#FAFAFA]/25 hover:text-[#FAFAFA]\'\n                        }`}\n                      >\n                        <div className=\"flex items-center gap-2.5 min-w-0\">\n                          <img\n                            src={srv.flagUrl}\n                            alt={srv.country}\n                            referrerPolicy=\"no-referrer\"\n                            className=\"h-7 w-7 rounded-full object-cover shrink-0 border border-white/10\"\n                          />\n                          <div className=\"min-w-0\">\n                            <div className=\"text-xs font-bold text-[#FAFAFA] truncate\">\n                              {srv.country}\n                            </div>\n                            <div className=\"text-[11px] text-[#A1A1AA] truncate\">\n                              {srv.city}\n                            </div>\n                          </div>\n                        </div>\n                        <ChevronRight\n                          className={`h-4 w-4 shrink-0 transition-transform ${\n                            active ? \'text-[#FDE047] translate-x-0.5\' : \'text-[#A1A1AA]/40\'\n                          }`}\n                        />\n                      </motion.button>\n                    );\n                  })}\n                </div>\n              </div>\n            </div>\n          )}\n        </div>\n      </motion.div>\n    </motion.div>