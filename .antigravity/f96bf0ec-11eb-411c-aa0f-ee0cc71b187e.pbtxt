  view_file {
    absolute_path_uri: "file:///src/components/HeroMantleChoreography.tsx"
    end_line: 651
    content: "import React, { useState, useRef, useEffect, useCallback } from \'react\';\nimport { motion, useSpring, useReducedMotion } from \'motion/react\';\nimport { ArrowUpRight, Upload } from \'lucide-react\';\nimport { OFFICIAL_LINKS, MANTLE_BENCHMARKS } from \'../data/vpnData\';\nimport { SpotlightShell } from \'./AnkeLogo\';\nimport { PlatformCards } from \'./PlatformCards\';\nimport { IPhone3DModel, IPhoneTab } from \'./IPhone3DModel\';\n\nexport const HeroMantleChoreography: React.FC = () => {\n  const shouldReduceMotion = useReducedMotion();\n\n  const heroSlotRef = useRef<HTMLDivElement>(null);\n  const mantleTrackRef = useRef<HTMLDivElement>(null);\n  const mantleSlotRef = useRef<HTMLDivElement>(null);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  const [activeTab, setActiveTab] = useState<IPhoneTab>(\'home\');\n  const [activeStepIndex, setActiveStepIndex] = useState<number>(0);\n  const [pinProgress, setPinProgress] = useState<number>(0);\n  const [flightProgress, setFlightProgress] = useState<number>(0);\n  const [customScreenshotUrl, setCustomScreenshotUrl] = useState<string | null>(null);\n\n  // Direct pixel coordinates for the single unified 3D iPhone\n  const [phoneCoords, setPhoneCoords] = useState<{\n    x: number;\n    y: number;\n    rotateX: number;\n    rotateY: number;\n    rotateZ: number;\n    scale: number;\n    ready: boolean;\n  }>({\n    x: 0,\n    y: 0,\n    rotateX: 4,\n    rotateY: -8,\n    rotateZ: -2,\n    scale: 1,\n    ready: false,\n  });\n\n  // Smooth spring values for 3D rotations so switching steps & parabolic flight feel silky\n  const springRotateX = useSpring(4, { stiffness: 180, damping: 24 });\n  const springRotateY = useSpring(-8, { stiffness: 180, damping: 24 });\n  const springRotateZ = useSpring(-2, { stiffness: 180, damping: 24 });\n  const springScale = useSpring(1, { stiffness: 180, damping: 24 });\n\n  const updateChoreography = useCallback(() => {\n    const heroEl = heroSlotRef.current;\n    const mantleTrackEl = mantleTrackRef.current;\n    const mantleSlotEl = mantleSlotRef.current;\n\n    if (!heroEl || !mantleTrackEl || !mantleSlotEl) return;\n\n    const scrollY = window.scrollY;\n    const vh = window.innerHeight;\n    const vw = window.innerWidth;\n    const stickyTopOffset = 64; // height of sticky navbar\n\n    const heroRect = heroEl.getBoundingClientRect();\n    const mantleTrackRect = mantleTrackEl.getBoundingClientRect();\n    const mantleSlotRect = mantleSlotEl.getBoundingClientRect();\n\n    // Document Y where the Mantle section locks onto the screen\n    const mantleTrackDocTop = mantleTrackRect.top + scrollY;\n    const arrivalScrollY = Math.max(1, mantleTrackDocTop - stickyTopOffset);\n\n    // Total scroll distance while the Mantle section stays pinned\n    const pinDuration = Math.max(1, mantleTrackRect.height - (vh - stickyTopOffset));\n\n    // Phase 1 progress: t in [0, 1] from Hero (0) to Mantle Lock (1)\n    const rawT = Math.min(1, Math.max(0, scrollY / arrivalScrollY));\n    // Smoothstep easing for vertical/horizontal base interpolation\n    const smoothT = rawT * rawT * (3 - 2 * rawT);\n    // Symmetric parabola 4 * t * (1 - t), peaking at 1.0 when passing behind #platforms\n    const parabola = 4 * rawT * (1 - rawT);\n\n    // Horizontal parabolic arc amplitude (sweeps inward toward center on desktop, then back out to right slot)\n    const arcAmplitude = shouldReduceMotion ? 0 : vw >= 1024 ? -210 : vw >= 640 ? -70 : 0;\n\n    // Exact interpolated viewport X and Y\n    const currentX =\n      heroRect.left +\n      (mantleSlotRect.left - heroRect.left) * smoothT +\n      arcAmplitude * parabola;\n\n    const currentY =\n      heroRect.top + (mantleSlotRect.top - heroRect.top) * smoothT;\n\n    // Phase 2 progress: p in [0, 1] while pinned on the Mantle section\n    const rawP = Math.min(1, Math.max(0, (scrollY - arrivalScrollY) / pinDuration));\n\n    setFlightProgress(rawT);\n    setPinProgress(rawP);\n\n    // Determine active screen & 3D orientation\n    let targetRotateX = 4;\n    let targetRotateY = -8;\n    let targetRotateZ = -2;\n    let targetScale = 1;\n\n    if (rawT < 1) {\n      // In Hero or flying along the parabola behind \"\320\224\320\276\321\201\321\202\321\203\320\277\320\275\320\276 \320\275\320\260 \320\262\321\201\320\265\321\205 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262\320\260\321\205\"\n      targetRotateZ = shouldReduceMotion ? 0 : -3 * (1 - rawT) - 14 * parabola;\n      targetRotateY = shouldReduceMotion ? 0 : -18 * (1 - rawT) - 34 * parabola - 22 * rawT;\n      targetRotateX = shouldReduceMotion ? 0 : 8 * (1 - rawT) + 20 * parabola + 10 * rawT;\n      targetScale = shouldReduceMotion ? 1 : 1 - 0.04 * parabola;\n\n      // While in Hero / early flight, show \320\223\320\273\320\260\320\262\320\275\320\260\321\217; as it emerges into Mantle, ready step 01\n      setActiveStepIndex(0);\n      setActiveTab(\'home\');\n    } else {\n      // Landed in Mantle! Step through 01 -> 02 -> 03 while Mantle is pinned\n      if (rawP < 0.34) {\n        const localP = rawP / 0.34;\n        setActiveStepIndex(0);\n        setActiveTab(\'home\');\n        targetRotateY = shouldReduceMotion ? 0 : -22 + 38 * localP;\n        targetRotateX = shouldReduceMotion ? 0 : 10 - 6 * localP;\n        targetRotateZ = shouldReduceMotion ? 0 : -2 + 4 * localP;\n      } else if (rawP < 0.68) {\n        const localP = (rawP - 0.34) / 0.34;\n        setActiveStepIndex(1);\n        setActiveTab(\'regions\');\n        targetRotateY = shouldReduceMotion ? 0 : 16 - 34 * localP;\n        targetRotateX = shouldReduceMotion ? 0 : 4 + 6 * Math.sin(localP * Math.PI);\n        targetRotateZ = shouldReduceMotion ? 0 : 2 - 4 * localP;\n      } else {\n        const localP = (rawP - 0.68) / 0.32;\n        setActiveStepIndex(2);\n        setActiveTab(\'settings\');\n        targetRotateY = shouldReduceMotion ? 0 : -18 + 6 * localP;\n        targetRotateX = shouldReduceMotion ? 0 : 4 * (1 - localP);\n        targetRotateZ = shouldReduceMotion ? 0 : -2 * (1 - localP);\n      }\n      targetScale = 1;\n    }\n\n    springRotateX.set(targetRotateX);\n    springRotateY.set(targetRotateY);\n    springRotateZ.set(targetRotateZ);\n    springScale.set(targetScale);\n\n    setPhoneCoords({\n      x: currentX,\n      y: currentY,\n      rotateX: targetRotateX,\n      rotateY: targetRotateY,\n      rotateZ: targetRotateZ,\n      scale: targetScale,\n      ready: true,\n    });\n  }, [shouldReduceMotion, springRotateX, springRotateY, springRotateZ, springScale]);\n\n  useEffect(() => {\n    updateChoreography();\n    let rafId: number | null = null;\n\n    const onScrollOrResize = () => {\n      if (rafId !== null) return;\n      rafId = window.requestAnimationFrame(() => {\n        updateChoreography();\n        rafId = null;\n      });\n    };\n\n    window.addEventListener(\'scroll\', onScrollOrResize, { passive: true });\n    window.addEventListener(\'resize\', onScrollOrResize, { passive: true });\n    return () => {\n      window.removeEventListener(\'scroll\', onScrollOrResize);\n      window.removeEventListener(\'resize\', onScrollOrResize);\n      if (rafId !== null) window.cancelAnimationFrame(rafId);\n    };\n  }, [updateChoreography]);\n\n  // Jump to a specific step in the pinned Mantle track when clicking 01, 02, or 03\n  const handleJumpToStep = (stepIdx: number, tab: IPhoneTab) => {\n    setActiveStepIndex(stepIdx);\n    setActiveTab(tab);\n\n    const mantleTrackEl = mantleTrackRef.current;\n    if (!mantleTrackEl) return;\n\n    const stickyTopOffset = 64;\n    const vh = window.innerHeight;\n    const mantleTrackDocTop = mantleTrackEl.getBoundingClientRect().top + window.scrollY;\n    const arrivalScrollY = Math.max(1, mantleTrackDocTop - stickyTopOffset);\n    const pinDuration = Math.max(1, mantleTrackEl.offsetHeight - (vh - stickyTopOffset));\n\n    const targetRatio = stepIdx === 0 ? 0.12 : stepIdx === 1 ? 0.5 : 0.85;\n    window.scrollTo({\n      top: arrivalScrollY + pinDuration * targetRatio,\n      behavior: \'smooth\',\n    });\n  };\n\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    setCustomScreenshotUrl(URL.createObjectURL(file));\n  };\n\n  const steps: {\n    tab: IPhoneTab;\n    num: string;\n    title: string;\n    desc: string;\n  }[] = [\n    {\n      tab: \'home\',\n      num: \'01\',\n      title: \'01. \320\234\320\276\320\274\320\265\320\275\321\202\320\260\320\273\321\214\320\275\320\276\320\265 \320\277\320\276\320\264\320\272\320\273\321\216\321\207\320\265\320\275\320\270\320\265\',\n      desc: \'\320\227\320\260\320\277\321\203\321\201\320\272 \321\202\321\203\320\275\320\275\320\265\320\273\321\217 \320\262 \320\276\320\264\320\275\320\276 \320\272\320\260\321\201\320\260\320\275\320\270\320\265 \320\261\320\265\320\267 \320\267\320\260\320\264\320\265\321\200\320\266\320\265\320\272 \320\270 \320\273\320\270\321\210\320\275\320\270\321\205 \320\275\320\260\321\201\321\202\321\200\320\276\320\265\320\272.\',\n    },\n    {\n      tab: \'regions\',\n      num: \'02\',\n      title: \'02. \320\237\321\200\320\265\320\274\320\270\321\203\320\274 \321\201\320\265\321\200\320\262\320\265\321\200\321\213 \320\270 YouTube \320\261\320\265\320\267 \321\200\320\265\320\272\320\273\320\260\320\274\321\213\',\n      desc: \'\320\221\321\213\321\201\321\202\321\200\320\276\320\265 \320\277\320\265\321\200\320\265\320\272\320\273\321\216\321\207\320\265\320\275\320\270\320\265 \320\274\320\265\320\266\320\264\321\203 \320\273\320\276\320\272\320\260\321\206\320\270\321\217\320\274\320\270 \320\262 \320\225\320\262\321\200\320\276\320\277\320\265, \320\241\320\250\320\220 \320\270 \320\220\320\267\320\270\320\270 \320\277\321\200\321\217\320\274\320\276 \320\270\320\267 \321\201\320\277\320\270\321\201\320\272\320\260 \321\200\320\265\320\263\320\270\320\276\320\275\320\276\320\262.\',\n    },\n    {\n      tab: \'settings\',\n      num: \'03\',\n      title: \'03. \320\237\321\200\320\276\320\267\321\200\320\260\321\207\320\275\320\276\320\265 \321\203\320\277\321\200\320\260\320\262\320\273\320\265\320\275\320\270\320\265 \320\277\320\276\320\264\320\277\320\270\321\201\320\272\320\276\320\271\',\n      desc: \'\320\224\320\276\321\201\321\202\321\203\320\277 \320\277\320\276 \320\277\320\265\321\200\321\201\320\276\320\275\320\260\320\273\321\214\320\275\320\276\320\274\321\203 \320\275\320\276\320\274\320\265\321\200\321\203 \320\260\320\272\320\272\320\260\321\203\320\275\321\202\320\260, \320\263\320\270\320\261\320\272\320\270\320\265 \320\277\321\200\320\260\320\262\320\270\320\273\320\260 \321\200\320\260\320\261\320\276\321\202\321\213 \320\270 \321\201\320\262\321\217\320\267\321\214 \321\201 \320\277\320\276\320\264\320\264\320\265\321\200\320\266\320\272\320\276\320\271 \320\262 \320\276\320\264\320\270\320\275 \320\272\320\273\320\270\320\272.\',\n    },\n  ];\n\n  return (\n    <div className=\"relative\">\n      <input\n        ref={fileInputRef}\n        type=\"file\"\n        accept=\"image/*\"\n        onChange={handleFileUpload}\n        className=\"hidden\"\n      />\n\n      {/* =====================================================================\n          SINGLE UNIFIED 3D IPHONE LAYER (z-20)\n          Sits ABOVE Hero (z-10) & Mantle (z-10), and UNDERNEATH Platforms (z-30)!\n         ===================================================================== */}\n      <div\n        style={{ perspective: 1400 }}\n        className={`fixed inset-0 z-20 pointer-events-none transition-opacity duration-200 ${\n          phoneCoords.ready ? \'opacity-100\' : \'opacity-0\'\n        }`}\n      >\n        <motion.div\n          style={{\n            x: phoneCoords.x,\n            y: phoneCoords.y,\n            rotateX: springRotateX,\n            rotateY: springRotateY,\n            rotateZ: springRotateZ,\n            scale: springScale,\n            transformStyle: \'preserve-3d\',\n          }}\n          className=\"absolute top-0 left-0 w-[300px] sm:w-[320px] pointer-events-auto will-change-transform\"\n        >\n          {/* Ambient golden aura following the single 3D iPhone */}\n          <div\n            aria-hidden=\"true\"\n            className=\"pointer-events-none absolute -inset-8 -z-10 rounded-full bg-[#FDE047]/[0.1] blur-3xl\"\n          />\n          <IPhone3DModel\n            activeTab={activeTab}\n            onTabChange={(tab) => {\n              setActiveTab(tab);\n              const idx = tab === \'home\' ? 0 : tab === \'regions\' ? 1 : 2;\n              setActiveStepIndex(idx);\n            }}\n            customScreenshotUrl={customScreenshotUrl}\n          />\n        </motion.div>\n      </div>\n\n      {/* =====================================================================\n          SECTION 1: HERO (z-10)\n         ===================================================================== */}\n      <section className=\"relative z-10 overflow-hidden border-b border-[#2A2A2A] bg-structural-grid py-16 sm:py-24 lg:py-28\">\n        <motion.div\n          aria-hidden=\"true\"\n          animate={{\n            opacity: [0.04, 0.08, 0.04],\n            scale: [1, 1.08, 1],\n          }}\n          transition={{ duration: 8, repeat: Infinity, ease: \'easeInOut\' }}\n          className=\"pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 h-[480px] w-[920px] rounded-full bg-[#FDE047] blur-[130px]\"\n        />\n\n        <div className=\"relative mx-auto max-w-[1200px] px-4 sm:px-6\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center\">\n            {/* Left Column: Expanded to fill available space up to the 3D iPhone */}\n            <div className=\"lg:col-span-7 xl:col-span-8\">\n              <motion.h1\n                initial={{ opacity: 0, y: 24, filter: \'blur(8px)\' }}\n                animate={{ opacity: 1, y: 0, filter: \'blur(0px)\' }}\n                transition={{ duration: 0.65, ease: [0.16, 1, 0.3, 1] }}\n                style={{ fontSize: \'clamp(2.75rem, 5.6vw, 5.25rem)\' }}\n                className=\"w-full font-bold tracking-tight text-[#FAFAFA] leading-[1.04]\"\n              >\n                \320\221\321\213\321\201\321\202\321\200\320\276\320\265 \320\270 <span className=\"text-[#FDE047]\">\320\277\321\200\320\270\320\262\320\260\321\202\320\275\320\276\320\265</span> \321\201\320\276\320\265\320\264\320\270\320\275\320\265\320\275\320\270\320\265\n              </motion.h1>\n\n              <motion.p\n                initial={{ opacity: 0, y: 20, filter: \'blur(6px)\' }}\n                animate={{ opacity: 1, y: 0, filter: \'blur(0px)\' }}\n                transition={{ duration: 0.65, delay: 0.1, ease: [0.16, 1, 0.3, 1] }}\n                className=\"mt-6 w-full max-w-2xl text-xl sm:text-2xl text-[#A1A1AA] leading-relaxed\"\n              >\n                \320\241\321\202\320\260\320\261\320\270\320\273\321\214\320\275\320\260\321\217 \321\200\320\260\320\261\320\276\321\202\320\260, \320\274\320\276\320\274\320\265\320\275\321\202\320\260\320\273\321\214\320\275\320\276\320\265 \320\277\320\276\320\264\320\272\320\273\321\216\321\207\320\265\320\275\320\270\320\265\n              </motion.p>\n\n              <motion.div\n                initial={{ opacity: 0, y: 20 }}\n                animate={{ opacity: 1, y: 0 }}\n                transition={{ duration: 0.6, delay: 0.2, ease: [0.16, 1, 0.3, 1] }}\n                className=\"mt-10 flex flex-wrap items-center gap-4\"\n              >\n                <motion.a\n                  href={OFFICIAL_LINKS.appLogin}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  whileHover={{ scale: 1.03 }}\n                  whileTap={{ scale: 0.97 }}\n                  className=\"group inline-flex items-center gap-4 rounded-full bg-[#FDE047] pl-8 pr-3.5 py-4 text-base sm:text-lg font-bold text-black shadow-[0_0_35px_rgba(253,224,71,0.25)] transition-shadow hover:shadow-[0_0_50px_rgba(253,224,71,0.4)] whitespace-nowrap shrink-0\"\n                >\n                  <span>\320\232\321\203\320\277\320\270\321\202\321\214 \320\277\320\276\320\264\320\277\320\270\321\201\320\272\321\203</span>\n                  <span className=\"flex h-10 w-10 items-center justify-center rounded-full bg-black/15 text-black transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5\">\n                    <ArrowUpRight className=\"h-5 w-5\" />\n                  </span>\n                </motion.a>\n              </motion.div>\n\n              <div className=\"mt-8 flex items-center gap-3 text-xs sm:text-sm text-[#A1A1AA]\">\n                <span>\320\233\320\270\321\201\321\202\320\260\320\271\321\202\320\265 \320\262\320\275\320\270\320\267 \342\200\224 \321\201\320\274\320\260\321\200\321\202\321\204\320\276\320\275 \320\277\321\200\320\276\321\201\320\273\320\265\320\264\321\203\320\265\321\202 \320\267\320\260 \320\262\320\260\320\274\320\270</span>\n                <span aria-hidden=\"true\">\302\267</span>\n                {customScreenshotUrl ? (\n                  <button\n                    type=\"button\"\n                    onClick={() => setCustomScreenshotUrl(null)}\n                    className=\"text-[#FDE047] hover:underline cursor-pointer\"\n                  >\n                    \320\241\320\261\321\200\320\276\321\201\320\270\321\202\321\214 \321\201\320\272\321\200\320\270\320\275\321\210\320\276\321\202\n                  </button>\n                ) : (\n                  <button\n                    type=\"button\"\n                    onClick={() => fileInputRef.current?.click()}\n                    className=\"inline-flex items-center gap-1 text-[#FDE047] hover:underline cursor-pointer\"\n                  >\n                    <Upload className=\"h-3.5 w-3.5\" />\n                    <span>\320\241\320\262\320\276\320\271 \321\201\320\272\321\200\320\270\320\275\321\210\320\276\321\202</span>\n                  </button>\n                )}\n              </div>\n            </div>\n\n            {/* Right Column: Hero Launch Anchor Slot for the Single 3D iPhone */}\n            <div className=\"lg:col-span-5 xl:col-span-4 relative flex justify-center lg:justify-end\">\n              {/* Parabolic Trajectory Hint Arc (visible as phone starts flying) */}\n              <svg\n                aria-hidden=\"true\"\n                viewBox=\"0 0 320 635\"\n                className=\"pointer-events-none absolute w-[300px] sm:w-[320px] h-[635px] opacity-25\"\n              >\n                <rect\n                  x=\"8\"\n                  y=\"8\"\n                  width=\"304\"\n                  height=\"619\"\n                  rx=\"48\"\n                  fill=\"none\"\n                  stroke=\"#FDE047\"\n                  strokeWidth=\"1\"\n                  strokeDasharray=\"6 6\"\n                  style={{ opacity: flightProgress > 0.05 ? 0.5 : 0 }}\n                />\n              </svg>\n\n              {/* Exact Bounding Box Anchor for Hero iPhone Start Position */}\n              <div\n                ref={heroSlotRef}\n                className=\"w-[300px] sm:w-[320px] h-[635px] shrink-0\"\n              />\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* =====================================================================\n          SECTION 2: PLATFORMS (\"\320\224\320\276\321\201\321\202\321\203\320\277\320\275\320\276 \320\275\320\260 \320\262\321\201\320\265\321\205 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262\320\260\321\205\") \342\200\224 z-30!\n          The z-20 3D iPhone physically passes UNDERNEATH this section!\n         ===================================================================== */}\n      <PlatformCards />\n\n      {/* =====================================================================\n          SECTION 3: MANTLE CORE STICKY PIN TRACK & BENCHMARKS (z-10)\n         ===================================================================== */}\n      <section id=\"mantle\" className=\"relative z-10 border-b border-[#2A2A2A]\">\n        {/* Tall Sticky Track (320vh) \342\200\224 locks scroll while stepping through 01, 02, 03 */}\n        <div ref={mantleTrackRef} className=\"relative h-[320vh]\">\n          <div className=\"sticky top-[64px] min-h-[calc(100dvh-64px)] flex items-center py-10 overflow-hidden\">\n            <div className=\"mx-auto w-full max-w-[1200px] px-4 sm:px-6\">\n              <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center\">\n                {/* Left Column: Header + Pinned Scroll Progress + Steps 01, 02, 03 */}\n                <div className=\"lg:col-span-6\">\n                  <div className=\"mb-8\">\n                    <h2\n                      style={{ fontSize: \'clamp(2rem, 3.8vw, 3.25rem)\' }}\n                      className=\"font-bold tracking-tight text-[#FAFAFA] leading-[1.08]\"\n                    >\n                      Mantle \342\200\224 \321\217\320\264\321\200\320\276 <span className=\"text-[#FDE047]\">Anke</span>\n                    </h2>\n                    <p className=\"mt-2.5 text-base sm:text-lg text-[#A1A1AA]\">\n                      \320\235\320\265 VLESS \320\270 \320\275\320\265 \320\263\320\276\321\202\320\276\320\262\320\260\321\217 \321\201\320\261\320\276\321\200\320\272\320\260 \342\200\224 \321\201\320\262\320\276\321\221 \321\217\320\264\321\200\320\276, \320\275\320\260\320\277\320\270\321\201\320\260\320\275\320\275\320\276\320\265 \321\201 \320\275\321\203\320\273\321\217\n                    </p>\n                  </div>\n\n                  {/* Steps List with Continuous Scroll Progress Bar */}\n                  <div className=\"relative pl-5 space-y-3.5\">\n                    {/* Vertical Track Line */}\n                    <div\n                      aria-hidden=\"true\"\n                      className=\"absolute left-0 top-2 bottom-2 w-1 rounded-full bg-[#2A2A2A] overflow-hidden\"\n                    >\n                      <div\n                        style={{ height: `${Math.round(pinProgress * 100)}%` }}\n                        className=\"w-full bg-[#FDE047] shadow-[0_0_12px_#FDE047] transition-all duration-75\"\n                      />\n                    </div>\n\n                    {steps.map((step, idx) => {\n                      const isActive = activeStepIndex === idx;\n                      return (\n                        <button\n                          key={step.tab}\n                          type=\"button\"\n                          onClick={() => handleJumpToStep(idx, step.tab)}\n                          className=\"w-full text-left cursor-pointer focus-visible:outline-2 focus-visible:outline-[#FDE047]\"\n                        >\n                          <SpotlightShell\n                            className={`transition-all duration-300 ${\n                              isActive\n                                ? \'border-[#FDE047] shadow-[0_0_35px_rgba(253,224,71,0.12)] translate-x-1\'\n                                : \'opacity-60 hover:opacity-90 hover:border-[#FAFAFA]/25\'\n                            }`}\n                            innerClassName={`p-5 sm:p-6 transition-colors ${\n                              isActive\n                                ? \'bg-gradient-to-r from-[#FDE047]/[0.08] to-transparent\'\n                                : \'\'\n                            }`}\n                          >\n                            <div className=\"flex items-center justify-between gap-3\">\n                              <h3\n                                className={`text-base sm:text-lg font-bold tracking-tight transition-colors ${\n                                  isActive ? \'text-[#FDE047]\' : \'text-[#FAFAFA]\'\n                                }`}\n                              >\n                                {step.title}\n                              </h3>\n                              <span\n                                className={`text-xs font-mono px-2 py-0.5 rounded-md ${\n                                  isActive\n                                    ? \'bg-[#FDE047] text-black font-bold\'\n                                    : \'bg-[#222226] text-[#A1A1AA]\'\n                                }`}\n                              >\n                                {step.num} / 03\n                              </span>\n                            </div>\n                            <p className=\"mt-1.5 text-xs sm:text-sm text-[#A1A1AA] leading-relaxed\">\n                              {step.desc}\n                            </p>\n                          </SpotlightShell>\n                        </button>\n                      );\n                    })}\n                  </div>\n                </div>\n\n                {/* Right Column: Mantle Landing Anchor Slot for the Single 3D iPhone */}\n                <div className=\"lg:col-span-6 relative flex justify-center\">\n                  {/* Subtle Landing Dock Ring */}\n                  <div\n                    aria-hidden=\"true\"\n                    className={`pointer-events-none absolute inset-0 m-auto w-[308px] sm:w-[328px] h-[643px] rounded-[56px] border border-dashed transition-opacity duration-500 ${\n                      flightProgress < 0.98\n                        ? \'border-[#FDE047]/35 opacity-60\'\n                        : \'border-transparent opacity-0\'\n                    }`}\n                  />\n\n                  <div\n                    ref={mantleSlotRef}\n                    className=\"w-[300px] sm:w-[320px] h-[635px] shrink-0\"\n                  />\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* PART 2: Exact \"VLESS \320\277\321\200\320\276\321\202\320\270\320\262 Mantle\" Benchmark Comparison (scrolls normally after step 03!) */}\n        <div className=\"mx-auto max-w-[1200px] px-4 sm:px-6 pb-24 lg:pb-32 pt-8\">\n          <motion.div\n            initial={{ opacity: 0, y: 28 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true, margin: \'-60px\' }}\n            transition={{ duration: 0.6, ease: [0.16, 1, 0.3, 1] }}\n          >\n            <SpotlightShell\n              className=\"border-[#2A2A2A] hover:border-[#FDE047]/35\"\n              innerClassName=\"p-6 sm:p-10 lg:p-12 bg-[#161616]\"\n            >\n              <div className=\"max-w-2xl\">\n                <h3\n                  style={{ fontSize: \'clamp(1.85rem, 3.5vw, 3rem)\' }}\n                  className=\"font-bold tracking-tight text-[#FAFAFA] leading-[1.1]\"\n                >\n                  VLESS \320\277\321\200\320\276\321\202\320\270\320\262 <span className=\"text-[#FDE047]\">Mantle</span>\n                </h3>\n                <p className=\"mt-2.5 text-sm sm:text-base text-[#A1A1AA]\">\n                  Anke \320\270 Happ \320\275\320\260 \320\276\320\264\320\270\320\275\320\260\320\272\320\276\320\262\320\276\320\271 \320\275\320\260\320\263\321\200\321\203\320\267\320\272\320\265: \321\207\320\265\320\274 \320\272\320\276\321\200\320\276\321\207\320\265 \320\277\320\276\320\273\320\276\321\201\320\272\320\260, \321\202\320\265\320\274 \320\273\321\203\321\207\321\210\320\265\n                </p>\n\n                <div className=\"mt-6 flex flex-wrap items-center gap-6 text-xs sm:text-sm font-medium text-[#FAFAFA]\">\n                  <div className=\"flex items-center gap-2.5\">\n                    <span className=\"h-3 w-7 rounded-full bg-[#FDE047]\" />\n                    <span>Anke \302\267 Mantle</span>\n                  </div>\n                  <div className=\"flex items-center gap-2.5\">\n                    <span className=\"h-3 w-7 rounded-full bg-[#52555E]\" />\n                    <span className=\"text-[#A1A1AA]\">Happ \302\267 VLESS</span>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"hidden md:grid md:grid-cols-12 gap-6 mt-10 pb-3 border-b border-[#2A2A2A] text-sm font-semibold text-[#A1A1AA]\">\n                <div className=\"md:col-span-4\" />\n                <div className=\"md:col-span-4\">iPhone</div>\n                <div className=\"md:col-span-4\">Android</div>\n              </div>\n\n              <div className=\"divide-y divide-[#2A2A2A]\">\n                {MANTLE_BENCHMARKS.map((row, idx) => (\n                  <div\n                    key={row.id}\n                    className=\"py-6 grid grid-cols-1 md:grid-cols-12 gap-6 items-center\"\n                  >\n                    <div className=\"md:col-span-4\">\n                      <div className=\"text-base sm:text-lg font-bold text-[#FAFAFA]\">\n                        {row.metric}\n                      </div>\n                      <div className=\"text-xs sm:text-sm text-[#8E8E93] mt-0.5\">\n                        {row.subtitle}\n                      </div>\n                    </div>\n\n                    <div className=\"md:col-span-4\">\n                      <div className=\"flex items-center justify-between md:block mb-2\">\n                        <span className=\"text-xs font-medium text-[#8E8E93] md:hidden\">\n                          iPhone\n                        </span>\n                        <span className=\"text-sm sm:text-base font-bold text-[#FDE047] tabular-nums\">\n                          {row.iphone.label}\n                        </span>\n                      </div>\n                      <div className=\"space-y-2\">\n                        <div className=\"h-3 w-full rounded-full bg-transparent overflow-hidden\">\n                          <motion.div\n                            initial={{ width: 0 }}\n                            whileInView={{ width: `${row.iphone.mantlePercent}%` }}\n                            viewport={{ once: true, margin: \'-40px\' }}\n                            transition={{\n                              duration: 0.75,\n                              delay: idx * 0.08,\n                              ease: [0.16, 1, 0.3, 1],\n                            }}\n                            className=\"h-full min-w-[12px] rounded-full bg-[#FDE047] shadow-[0_0_16px_rgba(253,224,71,0.35)]\"\n                          />\n                        </div>\n                        <div className=\"h-3 w-full rounded-full bg-transparent overflow-hidden\">\n                          <motion.div\n                            initial={{ width: 0 }}\n                            whileInView={{ width: `${row.iphone.vlessPercent}%` }}\n                            viewport={{ once: true, margin: \'-40px\' }}\n                            transition={{\n                              duration: 0.85,\n                              delay: idx * 0.08 + 0.05,\n                              ease: [0.16, 1, 0.3, 1],\n                            }}\n                            className=\"h-full rounded-full bg-[#4A4D55]\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n\n                    <div className=\"md:col-span-4\">\n                      <div className=\"flex items-center justify-between md:block mb-2\">\n                        <span className=\"text-xs font-medium text-[#8E8E93] md:hidden\">\n                          Android\n                        </span>\n                        <span className=\"text-sm sm:text-base font-bold text-[#FDE047] tabular-nums\">\n                          {row.android.label}\n                        </span>\n                      </div>\n                      <div className=\"space-y-2\">\n                        <div className=\"h-3 w-full rounded-full bg-transparent overflow-hidden\">\n                          <motion.div\n                            initial={{ width: 0 }}\n                            whileInView={{ width: `${row.android.mantlePercent}%` }}\n                            viewport={{ once: true, margin: \'-40px\' }}\n                            transition={{\n                              duration: 0.75,\n                              delay: idx * 0.08 + 0.1,\n                              ease: [0.16, 1, 0.3, 1],\n                            }}\n                            className=\"h-full min-w-[12px] rounded-full bg-[#FDE047] shadow-[0_0_16px_rgba(253,224,71,0.35)]\"\n                          />\n                        </div>\n                        <div className=\"h-3 w-full rounded-full bg-transparent overflow-hidden\">\n                          <motion.div\n                            initial={{ width: 0 }}\n                            whileInView={{ width: `${row.android.vlessPercent}%` }}\n                            viewport={{ once: true, margin: \'-40px\' }}\n                            transition={{\n                              duration: 0.85,\n                              delay: idx * 0.08 + 0.15,\n                              ease: [0.16, 1, 0.3, 1],\n                            }}\n                            className=\"h-full rounded-full bg-[#4A4D55]\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                ))}\n              </div>\n\n              <div className=\"mt-6 pt-4 border-t border-[#2A2A2A] text-xs text-[#8E8E93]\">\n                iPhone 15 Pro Max \320\270 Samsung Galaxy S10 \302\267 Happ 4.3.0 \302\267 \321\201\320\265\321\200\320\262\320\265\321\200 \320\262\320\276 \320\244\321\200\320\260\320\275\320\272\321\204\321\203\321\200\321\202\320\265\n              </div>\n            </SpotlightShell>\n          </motion.div>\n        </div>\n      </section>\n    </div>\n  );\n};\n"
