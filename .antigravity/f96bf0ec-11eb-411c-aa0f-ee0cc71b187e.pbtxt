 data-i18n=\"custom_feat2\">\320\241\321\200\320\276\320\272 \320\270 \321\203\321\201\320\273\320\276\320\262\320\270\321\217 \342\200\224 \320\277\320\276\320\264 \320\262\320\260\321\210\321\203 \320\267\320\260\320\264\320\260\321\207\321\203</span></li>                            </ul>                            <div class=\"price-box\">                                <span class=\"price text-yellow\" data-i18n=\"custom_price\">\320\230\320\275\320\264\320\270\320\262\320\270\320\264\321\203\320\260\320\273\321\214\320\275\320\276</span>                            </div>                            <a class=\"custom-cta\" href=\"/vnp/ru/support\">                                <span data-i18n=\"custom_cta\">\320\236\320\261\321\201\321\203\320\264\320\270\321\202\321\214 \320\262 \320\277\320\276\320\264\320\264\320\265\321\200\320\266\320\272\320\265</span>                                <span class=\"svg-icon icon-pointer icon-yellow\"></span>                            </a>                        </div>                    </div>                    <a class=\"refund-banner\" href=\"/vnp/ru/refund\">                        <span class=\"refund-banner-icon\">                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FAED5D\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"2.5\" y=\"5\" width=\"19\" height=\"14\" rx=\"2.6\"/><path d=\"M2.5 9.2h19\"/><path d=\"M17 14.8H8.6m0 0 2.4-2.4m-2.4 2.4 2.4 2.4\"/></svg>                        </span>                        <span class=\"refund-banner-text\">                            <strong data-i18n=\"refund_banner_title\">\320\222\320\276\320\267\320\262\321\200\320\260\321\202 \320\262 \321\202\320\265\321\207\320\265\320\275\320\270\320\265 15 \320\264\320\275\320\265\320\271</strong>                            <span data-i18n=\"refund_banner_desc\">\320\247\320\265\321\201\321\202\320\275\320\276 \320\270 \320\277\321\200\320\276\320\267\321\200\320\260\321\207\320\275\320\276: \320\275\320\265 \320\277\320\276\320\264\320\276\321\210\320\273\320\276 \342\200\224 \320\262\320\265\321\200\320\275\321\221\320\274 \320\264\320\265\320\275\321\214\320\263\320\270 \320\277\320\276\320\273\320\275\320\276\321\201\321\202\321\214\321\216, \320\261\320\265\320\267 \320\276\320\261\321\212\321\217\321\201\320\275\320\265\320\275\320\270\320\271 \320\270 \320\262\320\276\320\277\321\200\320\276\321\201\320\276\320\262</span>                        </span>                        <span class=\"refund-banner-arrow\"><span class=\"svg-icon icon-pointer icon-yellow\"></span></span>                    </a>                    <section class=\"features-grid\">                        <div class=\"feature-item\">                            <div class=\"svg-icon icon-lightning icon-yellow\"></div>                            <div class=\"feature-text\">                                <h4 data-i18n=\"speed_title\">\320\241\320\272\320\276\321\200\320\276\321\201\321\202\321\214</h4>                                <p data-i18n=\"speed_desc\">\320\241\320\265\321\200\320\262\320\265\321\200\321\213 \321\201 \320\272\320\260\320\275\320\260\320\273\320\276\320\274 15 \320\223\320\261\320\270\321\202/\321\201<br>\320\235\320\270\320\272\320\260\320\272\320\270\321\205 \320\276\320\263\321\200\320\260\320\275\320\270\321\207\320\265\320\275\320\270\320\271 \320\277\320\276 \321\202\321\200\320\260\321\204\320\270\320\272\321\203</p>                            </div>                        </div>                        <div class=\"feature-item\">                            <div class=\"svg-icon icon-lock icon-yellow\"></div>                            <div class=\"feature-text\">                                <h4 data-i18n=\"priv_title\">\320\237\321\200\320\270\320\262\320\260\321\202\320\275\320\276\321\201\321\202\321\214</h4>                                <p data-i18n=\"priv_desc\">\320\222\320\260\321\210\320\270 \320\264\320\260\320\275\320\275\321\213\320\265 \320\270 \320\260\320\272\321\202\320\270\320\262\320\275\320\276\321\201\321\202\321\214 <br> \320\275\320\265 \321\201\320\276\321\205\321\200\320\260\320\275\321\217\321\216\321\202\321\201\321\217</p>                            </div>                        </div>                        <div class=\"feature-item\">                            <div class=\"svg-icon icon-globe icon-yellow\"></div>                            <div class=\"feature-text\">                                <h4 data-i18n=\"avail_title\">\320\224\320\276\321\201\321\202\321\203\320\277\320\275\320\276\321\201\321\202\321\214</h4>                                <p data-i18n=\"avail_desc\">\320\234\320\276\320\274\320\265\320\275\321\202\320\260\320\273\321\214\320\275\320\276\320\265 \320\277\320\276\320\264\320\272\320\273\321\216\321\207\320\265\320\275\320\270\320\265 <br> \320\272 \321\201\320\265\321\200\320\262\320\265\321\200\320\260\320\274</p>                            </div>                        </div>                    </section>            </main>        </div>        <div id=\"live-chat\" class=\"live-chat\" aria-live=\"polite\"></div>        <footer class=\"footer\">            <div class=\"footer-links\">                <a href=\"/vnp/ru/pricing\" data-i18n=\"footer_pricing\">\320\246\320\265\320\275\321\213</a>"
