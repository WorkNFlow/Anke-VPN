Features */}\n                  <ul className=\"mt-7 space-y-3.5 text-sm sm:text-base text-[#FAFAFA]\">\n                    <li className=\"flex items-center gap-3\">\n                      <span className=\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#FDE047]/15\">\n                        <svg width=\"14\" height=\"14\" viewBox=\"0 0 12 12\" fill=\"none\" aria-hidden=\"true\">\n                          <path\n                            d=\"M1.9 6.4 L4.6 9.1 L10.1 3.1\"\n                            stroke=\"#FDE047\"\n                            strokeWidth=\"2.1\"\n                            strokeLinecap=\"round\"\n                            strokeLinejoin=\"round\"\n                          />\n                        </svg>\n                      </span>\n                      <span>\320\221\320\276\320\273\321\214\321\210\320\265 \320\277\321\217\321\202\320\270 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262 \342\200\224 \320\277\320\276 \320\267\320\260\320\277\321\200\320\276\321\201\321\203</span>\n                    </li>\n                    <li className=\"flex items-center gap-3\">\n                      <span className=\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#FDE047]/15\">\n                        <svg width=\"14\" height=\"14\" viewBox=\"0 0 12 12\" fill=\"none\" aria-hidden=\"true\">\n                          <path\n                            d=\"M1.9 6.4 L4.6 9.1 L10.1 3.1\"\n                            stroke=\"#FDE047\"\n                            strokeWidth=\"2.1\"\n                            strokeLinecap=\"round\"\n                            strokeLinejoin=\"round\"\n                          />\n                        </svg>\n                      </span>\n                      <span>\320\241\321\200\320\276\320\272 \320\270 \321\203\321\201\320\273\320\276\320\262\320\270\321\217 \342\200\224 \320\277\320\276\320\264 \320\262\320\260\321\210\321\203 \320\267\320\260\320\264\320\260\321\207\321\203</span>\n                    </li>\n                  </ul>\n\n                  <div className=\"mt-8 pt-6 border-t border-[#2A2A2A]\">\n                    <span className=\"text-3xl sm:text-4xl font-bold tracking-tight text-[#FDE047]\">\n                      \320\230\320\275\320\264\320\270\320\262\320\270\320\264\321\203\320\260\320\273\321\214\320\275\320\276\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"mt-8 pt-6 border-t border-[#2A2A2A]\">\n                  <a\n                    href=\"#support\"\n                    className=\"group tactile-btn w-full flex items-center justify-between rounded-full border border-[#2A2A2A] bg-[#121212] hover:border-[#FDE047]/60 pl-6 pr-2.5 py-3 text-sm font-bold text-[#FAFAFA]\"\n                  >\n                    <span>\320\236\320\261\321\201\321\203\320\264\320\270\321\202\321\214 \320\262 \320\277\320\276\320\264\320\264\320\265\321\200\320\266\320\272\320\265</span>\n                    <span className=\"flex h-8 w-8 items-center justify-center rounded-full bg-white/[0.06] text-[#FDE047] group-hover:bg-[#FDE047] group-hover:text-black transition-all\">\n                      <ArrowUpRight className=\"h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5\" />\n                    </span>\n                  </a>\n                </div>\n              </SpotlightShell>\n            </motion.div>\n          </div>\n\n          {/* Official 15-Day Refund Banner (\"\320\222\320\276\320\267\320\262\321\200\320\260\321\202 \320\262 \321\202\320\265\321\207\320\265\320\275\320\270\320\265 15 \320\264\320\275\320\265\320\271\") */}\n          <motion.a\n            href={OFFICIAL_LINKS.refundPage}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: false, margin: \'-40px\' }}\n            transition={{ duration: 0.45, delay: 0.14, ease: [0.16, 1, 0.3, 1] }}\n            whileHover={{ y: -3 }}\n            whileTap={{ scale: 0.99 }}\n            className=\"group mt-6 block\"\n          >\n            <SpotlightShell\n              className=\"group-hover:border-[#FDE047]/50\"\n              innerClassName=\"p-6 sm:px-8 sm:py-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4\"\n            >\n              <div className=\"flex items-start sm:items-center gap-4\">\n                <span className=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#2A2A2A] bg-[#121212] text-[#FDE047]\">\n                  <RotateCcw className=\"h-5 w-5\" />\n                </span>\n                <div>\n                  <strong className=\"block text-base sm:text-lg font-bold text-[#FAFAFA]\">\n                    \320\222\320\276\320\267\320\262\321\200\320\260\321\202 \320\262 \321\202\320\265\321\207\320\265\320\275\320\270\320\265 15 \320\264\320\275\320\265\320\271\n                  </strong>\n                  <span className=\"mt-0.5 block text-sm text-[#A1A1AA]\">\n                    \320\247\320\265\321\201\321\202\320\275\320\276 \320\270 \320\277\321\200\320\276\320\267\321\200\320\260\321\207\320\275\320\276: \320\275\320\265 \320\277\320\276\320\264\320\276\321\210\320\273\320\276 \342\200\224 \320\262\320\265\321\200\320\275\321\221\320\274 \320\264\320\265\320\275\321\214\320\263\320\270 \320\277\320\276\320\273\320\275\320\276\321\201\321\202\321\214\321\216, \320\261\320\265\320\267 \320\276\320\261\321\212\321\217\321\201\320\275\320\265\320\275\320\270\320\271 \320\270 \320\262\320\276\320\277\321\200\320\276\321\201\320\276\320\262\n                  </span>\n                </div>\n              </div>\n              <span className=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/[0.04] text-[#FDE047] group-hover:bg-[#FDE047] group-hover:text-black transition-all self-end sm:self-center\">\n                <ArrowUpRight className=\"h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5\" />\n              </span>\n            </SpotlightShell>\n          </motion.a>\n        </div>\n      </section>\n\n      {/* OFFICIAL SUPPORT SECTION (\"\320\237\320\276\320\264\320\264\320\265\321\200\320\266\320\272\320\260\") */}\n      <section id=\"support\" className=\"relative py-24 lg:py-28 border-b border-[#2A2A2A]\">\n        <div className=\"mx-auto max-w-[1200px] px-4 sm:px-6\">\n          <motion.div\n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: false, margin: \'-60px\' }}\n            transition={{ duration: 0.5, ease: [0.16, 1, 0.3, 1] }}\n            className=\"max-w-2xl mb-10\"\n          >\n            <h2\n              style={{ fontSize: \'clamp(1.75rem, 3vw, 2.5rem)\' }}\n              className=\"font-bold tracking-tight text-[#FAFAFA]\"\n            >\n              \320\237\320\276\320\264\320\264\320\265\321\200\320\266\320\272\320\260\n            </h2>\n            <p className=\"mt-3 text-base text-[#A1A1AA] leading-relaxed\">\n              \320\222\320\276\320\267\320\275\320\270\320\272\320\273\320\270 \320\262\320\276\320\277\321\200\320\276\321\201\321\213? \320\235\320\260\320\277\320\270\321\210\320\270\321\202\320\265 \320\275\320\260\320\274 \342\200\224 \320\276\321\202\320\262\320\265\321\207\320\260\320\265\320\274 \320\262 \321\202\320\265\321\207\320\265\320\275\320\270\320\265 \320\276\320\264\320\275\320\276\320\263\320\276 \321\200\320\260\320\261\320\276\321\207\320\265\320\263\320\276 \320\264\320\275\321\217. \320\243\320\272\320\260\320\266\320\270\321\202\320\265 \320\275\320\276\320\274\320\265\321\200 \320\260\320\272\320\272\320\260\321\203\320\275\321\202\320\260, \321\202\320\260\320\272 \321\200\320\265\321\210\320\270\320\274 \320\261\321\213\321\201\321\202\321\200\320\265\320\265.\n            </p>\n          </motion.div>\n\n          {/* 3 Official Support Channels */}\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n            {/* 1. \320\247\320\260\321\202 \320\275\320\260 \321\201\320\260\320\271\321\202\320\265 */}\n            <motion.button\n              type=\"button\"\n              onClick={onOpenChat}\n              initial={{ opacity: 0, y: 18 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: false }}\n              transition={{ duration: 0.4, delay: 0, ease: [0.16, 1, 0.3, 1] }}\n              whileHover={{ y: -4 }}\n              whileTap={{ scale: 0.98 }}\n              className=\"group text-left cursor-pointer\"\n            >\n              <SpotlightShell\n                className=\"h-full group-hover:border-[#FDE047]/50\"\n                innerClassName=\"p-6 flex items-center justify-between gap-4\"\n              >\n                <div className=\"flex items-center gap-3.5\">\n                  <span className=\"flex h-11 w-11 items-center justify-center rounded-xl border border-[#2A2A2A] bg-[#121212] text-[#FDE047]\">\n                    <MessageSquare className=\"h-5 w-5\" />\n                  </span>\n                  <div>\n                    <div className=\"text-base font-bold text-[#FAFAFA]\">\320\247\320\260\321\202 \320\275\320\260 \321\201\320\260\320\271\321\202\320\265</div>\n                    <div className=\"text-xs text-[#A1A1AA]\">\320\236\321\202\320\262\320\265\321\202\320\270\320\274 \320\277\321\200\321\217\320\274\320\276 \320\267\320\264\320\265\321\201\321\214</div>\n                  </div>\n                </div>\n                <span className=\"flex h-9 w-9 items-center justify-center rounded-full bg-white/[0.04] text-[#FDE047] group-hover:bg-[#FDE047] group-hover:text-black transition-all\">\n                  <ArrowUpRight className=\"h-4 w-4\" />\n                </span>\n              </SpotlightShell>\n            </motion.button>\n\n            {/* 2. Telegram @anke_support */}\n            <motion.a\n              href={OFFICIAL_LINKS.telegramSupport}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              initial={{ opacity: 0, y: 18 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: false }}\n              transition={{ duration: 0.4, delay: 0.06, ease: [0.16, 1, 0.3, 1] }}\n              whileHover={{ y: -4 }}\n              whileTap={{ scale: 0.98 }}\n              className=\"group block\"\n            >\n              <SpotlightShell\n                className=\"h-full group-hover:border-[#FDE047]/50\"\n                innerClassName=\"p-6 flex items-center justify-between gap-4\"\n              >\n                <div className=\"flex items-center gap-3.5\">\n                  <span className=\"flex h-11 w-11 items-center justify-center rounded-xl border border-[#2A2A2A] bg-[#121212] text-[#FDE047]\">\n                    <Send className=\"h-5 w-5\" />\n                  </span>\n                  <div>\n                    <div className=\"text-base font-bold text-[#FAFAFA]\">Telegram</div>\n                    <div className=\"text-xs text-[#A1A1AA]\">@anke_support</div>\n                  </div>\n                </div>\n                <span className=\"flex h-9 w-9 items-center justify-center rounded-full bg-white/[0.04] text-[#FDE047] group-hover:bg-[#FDE047] group-hover:text-black transition-all\">\n                  <ArrowUpRight className=\"h-4 w-4\" />\n                </span>\n              </SpotlightShell>\n            </motion.a>\n\n            {/* 3. \320\237\320\276\321\207\321\202\320\260 support@anke.dev */}\n            <motion.a\n              href={OFFICIAL_LINKS.emailSupport}\n              initial={{ opacity: 0, y: 18 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: false }}\n              transition={{ duration: 0.4, delay: 0.12, ease: [0.16, 1, 0.3, 1] }}\n              whileHover={{ y: -4 }}\n              whileTap={{ scale: 0.98 }}\n              className=\"group block\"\n            >\n              <SpotlightShell\n                className=\"h-full group-hover:border-[#FDE047]/50\"\n                innerClassName=\"p-6 flex items-center justify-between gap-4\"\n              >\n                <div className=\"flex items-center gap-3.5\">\n                  <span className=\"flex h-11 w-11 items-center justify-center rounded-xl border border-[#2A2A2A] bg-[#121212] text-[#FDE047]\">\n                    <Mail className=\"h-5 w-5\" />\n                  </span>\n                  <div>\n                    <div className=\"text-base font-bold text-[#FAFAFA]\">\320\237\320\276\321\207\321\202\320\260</div>\n                    <div className=\"text-xs text-[#A1A1AA]\">support@anke.dev</div>\n                  </div>\n                </div>\n                <span className=\"flex h-9 w-9 items-center justify-center rounded-full bg-white/[0.04] text-[#FDE047] group-hover:bg-[#FDE047] group-hover:text-black transition-all\">\n                  <ArrowUpRight className=\"h-4 w-4\" />\n                </span>\n              </SpotlightShell>\n            </motion.a>\n          </div>\n        </div>\n      </section>\n    </>\n  );\n};\n"
