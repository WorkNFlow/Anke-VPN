            }
            lines {
              text: "        setActiveStepIndex(2);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        setActiveTab(\'settings\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        targetRotateY = shouldReduceMotion ? 0 : 12 - 12 * localP;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
