  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { motion } from \'motion/react\';\nimport { Check, ArrowRight, ShieldCheck, Server, ChevronDown } from \'lucide-react\';\nimport { FAQ_ITEMS } from \'../data/vpnData\';\n\ninterface PricingSectionProps {\n  onSelectPlan: (\n    planType: \'subscription\' | \'custom\',\n    billingPeriod: \'1m\' | \'6m\' | \'12m\',\n    priceRub: number\n  ) => void;\n}\n\nexport const PricingSection: React.FC<PricingSectionProps> = ({ onSelectPlan }) => {\n  const [billingPeriod, setBillingPeriod] = useState<\'1m\' | \'6m\' | \'12m\'>(\'12m\');\n  const [openFaqIndex, setOpenFaqIndex] = useState<number | null>(0);\n\n  const getSubscriptionPrice = () => {\n    switch (billingPeriod) {\n      case \'1m\':\n        return { monthly: 299, total: 299, label: \'\320\237\321\200\320\270 \320\276\320\277\320\273\320\260\321\202\320\265 \320\277\320\276\320\274\320\265\321\201\321\217\321\207\320\275\320\276\' };\n      case \'6m\':\n        return { monthly: 239, total: 1434, label: \'1 434 \342\202\275 \320\267\320\260 6 \320\274\320\265\321\201\321\217\321\206\320\265\320\262 \302\267 \320\222\321\213\320\263\320\276\320\264\320\260 20%\' };\n      case \'12m\':\n        return { monthly: 179, total: 2148, label: \'2 148 \342\202\275 \320\267\320\260 12 \320\274\320\265\321\201\321\217\321\206\320\265\320\262 \302\267 \320\222\321\213\320\263\320\276\320\264\320\260 40%\' };\n    }\n  };\n\n  const getCustomPrice = () => {\n    switch (billingPeriod) {\n      case \'1m\':\n        return { monthly: 1490, total: 1490, label: \'\320\222\321\213\320\264\320\265\320\273\320\265\320\275\320\275\321\213\320\271 IP \320\270 \321\201\320\265\321\200\320\262\320\265\321\200 \320\277\321\200\320\270 \320\277\320\276\320\274\320\265\321\201\321\217\321\207\320\275\320\276\320\271 \320\276\320\277\320\273\320\260\321\202\320\265\' };\n      case \'6m\':\n        return { monthly: 1190, total: 7140, label: \'7 140 \342\202\275 \320\267\320\260 6 \320\274\320\265\321\201\321\217\321\206\320\265\320\262 \302\267 \320\222\321\213\320\264\320\265\320\273\320\265\320\275\320\275\321\213\320\271 \321\203\320\267\320\265\320\273\' };\n      case \'12m\':\n        return { monthly: 990, total: 11880, label: \'11 880 \342\202\275 \320\267\320\260 12 \320\274\320\265\321\201\321\217\321\206\320\265\320\262 \302\267 \320\237\321\200\320\270\320\276\321\200\320\270\321\202\320\265\321\202\320\275\321\213\320\271 SLA 99.99%\' };\n    }\n  };\n\n  const subPrice = getSubscriptionPrice();\n  const customPrice = getCustomPrice();\n\n  return (\n    <>\n      {/* Pricing Plans Section */}\n      <section id=\"pricing\" className=\"relative py-24 lg:py-32 border-b border-[#2A2A2A]\">\n        <div className=\"mx-auto max-w-[1200px] px-4 sm:px-6\">\n          <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12\">\n            <div>\n              <p className=\"text-xs font-mono text-[#A1A1AA] mb-2\">\n                03. \320\237\321\200\320\276\320\267\321\200\320\260\321\207\320\275\321\213\320\265 \321\202\320\260\321\200\320\270\321\204\321\213 \320\261\320\265\320\267 \321\201\320\272\321\200\321\213\321\202\321\213\321\205 \320\273\320\270\320\274\320\270\321\202\320\276\320\262\n              </p>\n              <h2\n                style={{ fontSize: \'clamp(1.75rem, 3vw, 2.75rem)\' }}\n                className=\"font-bold tracking-tight text-[#FAFAFA] leading-[1.15]\"\n              >\n                \320\222\321\213\320\261\320\265\321\200\320\270\321\202\320\265 \321\204\320\276\321\200\320\274\320\260\321\202 \320\277\320\276\320\264\320\272\320\273\321\216\321\207\320\265\320\275\320\270\321\217\n              </h2>\n            </div>\n\n            {/* Interactive Billing Period Segmented Control */}\n            <div\n              role=\"group\"\n              aria-label=\"\320\237\320\265\321\200\320\270\320\276\320\264 \320\276\320\277\320\273\320\260\321\202\321\213\"\n              className=\"inline-flex items-center gap-1 rounded-xl border border-[#2A2A2A] bg-[#161616] p-1 self-start md:self-auto\"\n            >\n              <button\n                type=\"button\"\n                onClick={() => setBillingPeriod(\'1m\')}\n                className={`tactile-btn rounded-lg px-3.5 py-2 text-xs font-medium cursor-pointer whitespace-nowrap shrink-0 ${\n                  billingPeriod === \'1m\'\n                    ? \'bg-[#2A2A2A] text-[#FAFAFA]\'\n                    : \'text-[#A1A1AA] hover:text-[#FAFAFA]\'\n                }`}\n              >\n                1 \320\274\320\265\321\201\321\217\321\206\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setBillingPeriod(\'6m\')}\n                className={`tactile-btn rounded-lg px-3.5 py-2 text-xs font-medium cursor-pointer whitespace-nowrap shrink-0 ${\n                  billingPeriod === \'6m\'\n                    ? \'bg-[#2A2A2A] text-[#FAFAFA]\'\n                    : \'text-[#A1A1AA] hover:text-[#FAFAFA]\'\n                }`}\n              >\n                6 \320\274\320\265\321\201\321\217\321\206\320\265\320\262 \342\210\22220%\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setBillingPeriod(\'12m\')}\n                className={`tactile-btn rounded-lg px-3.5 py-2 text-xs font-semibold cursor-pointer whitespace-nowrap shrink-0 ${\n                  billingPeriod === \'12m\'\n                    ? \'bg-[#FDE047] text-black\'\n                    : \'text-[#A1A1AA] hover:text-[#FAFAFA]\'\n                }`}\n              >\n                1 \320\263\320\276\320\264 \342\210\22240%\n              </button>\n            </div>\n          </div>\n\n          {/* Two Large Tactile Cards: \"\320\237\320\276\320\264\320\277\320\270\321\201\320\272\320\260\" and \"\320\230\320\275\320\264\320\270\320\262\320\270\320\264\321\203\320\260\320\273\321\214\320\275\320\276\" */}\n          <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch\">\n            {/* Card 1: \320\237\320\276\320\264\320\277\320\270\321\201\320\272\320\260 */}\n            <motion.div\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true, margin: \'-60px\' }}\n              transition={{ duration: 0.45, ease: [0.16, 1, 0.3, 1] }}\n              className=\"double-bezel-shell border-[#FDE047]/45 shadow-[0_0_48px_rgba(253,224,71,0.06)] flex flex-col\"\n            >\n              <div className=\"double-bezel-core flex-1 p-6 sm:p-9 flex flex-col justify-between bg-gradient-to-b from-[#FDE047]/[0.05] to-transparent\">\n                <div>\n                  <div className=\"flex items-center justify-between gap-4\">\n                    <span className=\"text-xs font-mono text-[#FDE047]\">\n                      \320\236\321\201\320\275\320\276\320\262\320\275\320\276\320\271 \321\202\320\260\321\200\320\270\321\204 \302\267 \320\224\320\273\321\217 \320\273\320\270\321\207\320\275\320\276\320\263\320\276 \320\270\321\201\320\277\320\276\320\273\321\214\320\267\320\276\320\262\320\260\320\275\320\270\321\217\n                    </span>\n                    <ShieldCheck className=\"h-5 w-5 text-[#FDE047]\" />\n                  </div>\n\n                  <h3 className=\"mt-3 text-2xl sm:text-3xl font-bold tracking-tight text-[#FAFAFA]\">\n                    \320\237\320\276\320\264\320\277\320\270\321\201\320\272\320\260\n                  </h3>\n                  <p className=\"mt-2 text-sm text-[#A1A1AA] leading-relaxed\">\n                    \320\234\320\263\320\275\320\276\320\262\320\265\320\275\320\275\321\213\320\271 \320\264\320\276\321\201\321\202\321\203\320\277 \320\272\320\276 \320\262\321\201\320\265\320\274 42 \321\201\320\272\320\276\321\200\320\276\321\201\321\202\320\275\321\213\320\274 \320\273\320\276\320\272\320\260\321\206\320\270\321\217\320\274 \320\264\320\276 15 \320\223\320\261\320\270\321\202/\321\201, \320\276\320\261\321\205\320\276\320\264 DPI \321\207\320\265\321\200\320\265\320\267 XTLS-Reality \320\270 \320\267\320\260\321\211\320\270\321\202\320\260 \320\264\320\276 5 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262 \320\276\320\264\320\275\320\276\320\262\321\200\320\265\320\274\320\265\320\275\320\275\320\276.\n                  </p>\n\n                  <div className=\"mt-6 pt-6 border-t border-[#2A2A2A]\">\n                    <div className=\"flex items-baseline gap-2 tabular-nums\">\n                      <span className=\"text-4xl sm:text-5xl font-bold tracking-tight text-[#FAFAFA] font-mono\">\n                        {subPrice.monthly} \342\202\275\n                      </span>\n                      <span className=\"text-sm text-[#A1A1AA]\">/ \320\274\320\265\321\201\321\217\321\206</span>\n                    </div>\n                    <p className=\"mt-1.5 text-xs font-mono text-[#A1A1AA] tabular-nums\">\n                      {subPrice.label}\n                    </p>\n                  </div>\n\n                  <ul className=\"mt-6 space-y-3 text-sm text-[#FAFAFA]/90\">\n                    {[\n                      \'\320\221\320\265\320\267\320\273\320\270\320\274\320\270\321\202\320\275\321\213\320\271 \321\202\321\200\320\260\321\204\320\270\320\272 \320\275\320\260 \320\277\320\276\321\200\321\202\320\260\321\205 \320\264\320\276 15 \320\223\320\261\320\270\321\202/\321\201\',\n                      \'\320\224\320\276 5 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262 \320\276\320\264\320\275\320\276\320\262\321\200\320\265\320\274\320\265\320\275\320\275\320\276 (iOS, Android, Windows, macOS, Linux)\',\n                      \'\320\237\321\200\320\276\321\202\320\276\320\272\320\276\320\273\321\213 VLESS XTLS-Reality, WireGuard \320\270 Shadowsocks-2022\',\n                      \'\320\240\320\260\320\267\320\264\320\265\320\273\321\214\320\275\320\276\320\265 \321\202\321\203\320\275\320\275\320\265\320\273\320\270\321\200\320\276\320\262\320\260\320\275\320\270\320\265 (\321\200\320\276\321\201\321\201\320\270\320\271\321\201\320\272\320\270\320\265 \320\261\320\260\320\275\320\272\320\270 \321\200\320\260\320\261\320\276\321\202\320\260\321\216\321\202 \320\261\320\265\320\267 \320\276\321\202\320\272\320\273\321\216\321\207\320\265\320\275\320\270\321\217)\',\n                      \'\320\220\320\262\321\202\320\276\320\274\320\260\321\202\320\270\321\207\320\265\321\201\320\272\320\260\321\217 \320\262\321\213\320\264\320\260\321\207\320\260 \320\272\320\273\321\216\321\207\320\260 \320\267\320\260 30 \321\201\320\265\320\272\321\203\320\275\320\264 (\320\241\320\221\320\237, \320\272\320\260\321\200\321\202\321\213 \320\240\320\244, Crypto)\',\n                    ].map((item, i) => (\n                      <li key={i} className=\"flex items-start gap-3\">\n                        <Check className=\"h-4 w-4 text-[#FDE047] shrink-0 mt-1\" />\n                        <span>{item}</span>\n                      </li>\n                    ))}\n                  </ul>\n                </div>\n\n                <div className=\"mt-8 pt-6 border-t border-[#2A2A2A]\">\n                  <button\n                    type=\"button\"\n                    onClick={() => onSelectPlan(\'subscription\', billingPeriod, subPrice.total)}\n                    className=\"group tactile-btn w-full flex items-center justify-between rounded-xl bg-[#FDE047] pl-6 pr-2.5 py-3 text-sm font-bold text-black hover:bg-[#FDE047]/95 cursor-pointer\"\n                  >\n                    <span>\320\232\321\203\320\277\320\270\321\202\321\214 \320\277\320\276\320\264\320\277\320\270\321\201\320\272\321\203</span>\n                    <span className=\"flex h-8 w-8 items-center justify-center rounded-lg bg-black/15 text-black transition-transform group-hover:translate-x-0.5\">\n                      <ArrowRight className=\"h-4 w-4\" />\n                    </span>\n                  </button>\n                </div>\n              </div>\n            </motion.div>\n\n            {/* Card 2: \320\230\320\275\320\264\320\270\320\262\320\270\320\264\321\203\320\260\320\273\321\214\320\275\320\276 */}\n            <motion.div\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true, margin: \'-60px\' }}\n              transition={{ duration: 0.45, delay: 0.08, ease: [0.16, 1, 0.3, 1] }}\n              className=\"double-bezel-shell hover:border-[#FAFAFA]/25 flex flex-col\"\n            >\n              <div className=\"double-bezel-core flex-1 p-6 sm:p-9 flex flex-col justify-between\">\n                <div>\n                  <div className=\"flex items-center justify-between gap-4\">\n                    <span className=\"text-xs font-mono text-[#A1A1AA]\">\n                      \320\222\321\213\320\264\320\265\320\273\320\265\320\275\320\275\320\260\321\217 \320\270\320\275\321\204\321\200\320\260\321\201\321\202\321\200\321\203\320\272\321\202\321\203\321\200\320\260 \302\267 \320\224\320\273\321\217 \320\272\320\276\320\274\320\260\320\275\320\264 \320\270 \320\261\320\270\320\267\320\275\320\265\321\201\320\260\n                    </span>\n                    <Server className=\"h-5 w-5 text-[#FAFAFA]\" />\n                  </div>\n\n                  <h3 className=\"mt-3 text-2xl sm:text-3xl font-bold tracking-tight text-[#FAFAFA]\">\n                    \320\230\320\275\320\264\320\270\320\262\320\270\320\264\321\203\320\260\320\273\321\214\320\275\320\276\n                  </h3>\n                  <p className=\"mt-2 text-sm text-[#A1A1AA] leading-relaxed\">\n                    \320\237\320\265\321\200\321\201\320\276\320\275\320\260\320\273\321\214\320\275\321\213\320\271 \321\204\320\270\320\267\320\270\321\207\320\265\321\201\320\272\320\270\320\271 \320\270\320\273\320\270 \320\270\320\267\320\276\320\273\320\270\321\200\320\276\320\262\320\260\320\275\320\275\321\213\320\271 \321\203\320\267\320\265\320\273 \321\201 \320\262\321\213\320\264\320\265\320\273\320\265\320\275\320\275\321\213\320\274 \321\201\321\202\320\260\321\202\320\270\321\207\320\265\321\201\320\272\320\270\320\274 IP-\320\260\320\264\321\200\320\265\321\201\320\276\320\274, \320\272\320\260\321\201\321\202\320\276\320\274\320\275\320\276\320\271 \320\274\320\260\321\200\321\210\321\200\321\203\321\202\320\270\320\267\320\260\321\206\320\270\320\265\320\271 \320\270 \320\277\320\260\320\275\320\265\320\273\321\214\321\216 \321\203\320\277\321\200\320\260\320\262\320\273\320\265\320\275\320\270\321\217.\n                  </p>\n\n                  <div className=\"mt-6 pt-6 border-t border-[#2A2A2A]\">\n                    <div className=\"flex items-baseline gap-2 tabular-nums\">\n                      <span className=\"text-4xl sm:text-5xl font-bold tracking-tight text-[#FAFAFA] font-mono\">\n                        \320\276\321\202 {customPrice.monthly} \342\202\275\n                      </span>\n                      <span className=\"text-sm text-[#A1A1AA]\">/ \320\274\320\265\321\201\321\217\321\206</span>\n                    </div>\n                    <p className=\"mt-1.5 text-xs font-mono text-[#A1A1AA] tabular-nums\">\n                      {customPrice.label}\n                    </p>\n                  </div>\n\n                  <ul className=\"mt-6 space-y-3 text-sm text-[#FAFAFA]/90\">\n                    {[\n                      \'\320\237\320\265\321\200\321\201\320\276\320\275\320\260\320\273\321\214\320\275\321\213\320\271 \320\262\321\213\320\264\320\265\320\273\320\265\320\275\320\275\321\213\320\271 \321\201\321\202\320\260\321\202\320\270\321\207\320\265\321\201\320\272\320\270\320\271 IP (DE, NL, FI, US, SG)\',\n                      \'\320\224\320\276 50 \320\277\320\276\320\264\320\272\320\273\321\216\321\207\320\265\320\275\320\275\321\213\321\205 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262 \320\270\320\273\320\270 \320\270\320\275\321\202\320\265\320\263\321\200\320\260\321\206\320\270\321\217 \320\275\320\260 \321\200\320\276\321\203\321\202\320\265\321\200 (Keenetic / OpenWrt)\',\n                      \'\320\230\320\267\320\276\320\273\320\270\321\200\320\276\320\262\320\260\320\275\320\275\321\213\320\271 \320\272\320\260\320\275\320\260\320\273 \320\261\320\265\320\267 \321\201\320\276\321\201\320\265\320\264\320\265\320\271 \320\270 \320\270\320\275\320\264\320\270\320\262\320\270\320\264\321\203\320\260\320\273\321\214\320\275\321\213\320\271 TLS SNI-\320\264\320\276\320\274\320\265\320\275\',\n                      \'\320\237\320\260\320\275\320\265\320\273\321\214 \321\203\320\277\321\200\320\260\320\262\320\273\320\265\320\275\320\270\321\217 \320\272\320\273\321\216\321\207\320\260\320\274\320\270 \321\201\320\276\321\202\321\200\321\203\320\264\320\275\320\270\320\272\320\276\320\262 \320\270 \320\272\320\276\321\200\320\277\320\276\321\200\320\260\321\202\320\270\320\262\320\275\321\213\320\271 \320\261\320\270\320\273\320\273\320\270\320\275\320\263\',\n                      \'\320\222\321\213\320\264\320\265\320\273\320\265\320\275\320\275\321\213\320\271 \320\270\320\275\320\266\320\265\320\275\320\265\321\200 \320\277\320\276\320\264\320\264\320\265\321\200\320\266\320\272\320\270 24/7 \320\270 SLA 99.99%\',\n                    ].map((item, i) => (\n                      <li key={i} className=\"flex items-start gap-3\">\n                        <Check className=\"h-4 w-4 text-[#FAFAFA] shrink-0 mt-1\" />\n                        <span>{item}</span>\n                      </li>\n                    ))}\n                  </ul>\n                </div>\n\n                <div className=\"mt-8 pt-6 border-t border-[#2A2A2A]\">\n                  <button\n                    type=\"button\"\n                   