7\321\206**.\n   - \320\224\320\273\321\217 **\320\270\320\275\320\276\321\201\321\202\321\200\320\260\320\275\320\275\321\213\321\205 \320\277\320\276\320\273\321\214\320\267\320\276\320\262\320\260\321\202\320\265\320\273\320\265\320\271**: 4 \320\277\320\265\321\200\320\270\320\276\320\264\320\260 \321\201 \320\270\320\275\321\202\320\265\321\200\320\260\320\272\321\202\320\270\320\262\320\275\321\213\320\274 \320\262\321\213\320\261\320\276\321\200\320\276\320\274:\n     - 1 \320\274\320\265\321\201\321\217\321\206 \342\200\224 **$3.49**\n     - 3 \320\274\320\265\321\201\321\217\321\206\320\260 \342\200\224 **$9.99** (\342\210\2223%)\n     - 6 \320\274\320\265\321\201\321\217\321\206\320\265\320\262 \342\200\224 **$18.99** (\342\210\2225%)\n     - 12 \320\274\320\265\321\201\321\217\321\206\320\265\320\262 \342\200\224 **$36.99** (\342\210\22210%)\n5. **\320\244\320\270\320\272\321\201 \320\277\320\265\321\200\320\265\320\275\320\276\321\201\320\260 \320\275\320\276\320\274\320\265\321\200\320\260 \320\272\320\260\321\200\321\202\320\276\321\207\320\272\320\270 Mantle**: \320\264\320\273\321\217 \320\270\320\275\320\264\320\270\320\272\320\260\321\202\320\276\321\200\320\276\320\262 \321\210\320\260\320\263\320\276\320\262 \320\264\320\276\320\261\320\260\320\262\320\273\320\265\320\275 \320\272\320\273\320\260\321\201\321\201 `whitespace-nowrap shrink-0`, \320\277\320\276\321\215\321\202\320\276\320\274\321\203 `02 / 03` \320\262\321\201\320\265\320\263\320\264\320\260 \320\276\321\202\320\276\320\261\321\200\320\260\320\266\320\260\320\265\321\202\321\201\321\217 \320\262 \320\276\320\264\320\275\321\203 \321\201\321\202\321\200\320\276\320\272\321\203 \320\261\320\265\320\267 \320\277\320\265\321\200\320\265\320\275\320\276\321\201\320\276\320\262.\n6. **\320\224\320\270\320\275\320\260\320\274\320\270\321\207\320\265\321\201\320\272\320\260\321\217 \320\277\320\276\320\264\321\201\320\262\320\265\321\202\320\272\320\260 \320\277\321\203\320\275\320\272\321\