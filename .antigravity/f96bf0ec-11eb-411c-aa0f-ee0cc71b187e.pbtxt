73\321\214\320\275\320\265\320\271\321\210\320\265\320\274 \321\201\320\272\321\200\320\276\320\273\320\273\320\265 \321\201\320\260\320\274\320\260 \321\201\320\265\320\272\321\206\320\270\321\217 \320\276\321\201\321\202\320\260\320\265\321\202\321\201\321\217 \320\275\320\265\320\277\320\276\320\264\320\262\320\270\320\266\320\275\320\276\320\271, \320\267\320\260\320\277\320\276\320\273\320\275\321\217\320\265\321\202\321\201\321\217 \320\262\320\265\321\200\321\202\320\270\320\272\320\260\320\273\321\214\320\275\321\213\320\271 \320\270\320\275\320\264\320\270\320\272\320\260\321\202\320\276\321\200 \320\277\321\200\320\276\320\263\321\200\320\265\321\201\321\201\320\260 \320\270 \320\277\320\276\321\201\320\273\320\265\320\264\320\276\320\262\320\260\321\202\320\265\320\273\321\214\320\275\320\276 \320\277\320\265\321\200\320\265\320\272\320\273\321\216\321\207\320\260\321\216\321\202\321\201\321\217 \320\277\321\203\320\275\320\272\321\202\321\213 **01 (\302\253\320\223\320\273\320\260\320\262\320\275\320\260\321\217\302\273)**, **02 (\302\253\320\240\320\265\320\263\320\270\320\276\320\275\321\213 / \320\241\320\277\320\270\321\201\320\276\320\272 \321\201\320\265\321\200\320\262\320\265\321\200\320\276\320\262\302\273)** \320\270 **03 (\302\253\320\235\320\260\321\201\321\202\321\200\320\276\320\271\320\272\320\270\302\273)** \321\201 \321\201\320\270\320\275\321\205\321\200\320\276\320\275\320\275\320\276\320\271 \321\201\320\274\320\265\320\275\320\276\320\271 \320\270\320\275\321\202\320\265\321\200\321\204\320\265\320\271\321\201\320\260 \320\270 \320\273\320\265\320\263\320\272\320\270\320\274 3D-\320\277\320\276\320\262\320\276\321\200\320\276\321\202\320\276\320\274 \321\201\320\274\320\260\321\200\321\202\321\204\320\276\320\275\320\260.\n4. **\320\237\321\200\320\276\320\264\320\276\320\273\320\266\320\265\320\275\320\270\320\265 \320\276\320\261\321\213\321\207\320\275\320\276\320\263\320\276 \321\201\320\272\321\200\320\276\320\273\320\273\320\26