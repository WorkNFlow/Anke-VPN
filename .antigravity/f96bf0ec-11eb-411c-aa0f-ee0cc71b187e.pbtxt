  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useRef } from \'react\';\nimport { motion } from \'motion/react\';\nimport {\n  Gauge,\n  Shield,\n  Globe2,\n  Cpu,\n  Lock,\n  Layers,\n  Image as ImageIcon,\n  Upload,\n} from \'lucide-react\';\nimport { SERVER_NODES, ServerNode } from \'../data/vpnData\';\n\nexport const BentoFeatures: React.FC = () => {\n  const [benchmarkNode, setBenchmarkNode] = useState<ServerNode>(SERVER_NODES[1]); // Frankfurt 15.0 Gbps\n  const [mobileShotUrl, setMobileShotUrl] = useState<string | null>(null);\n  const mobileFileRef = useRef<HTMLInputElement>(null);\n\n  const handleMobileShotUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    setMobileShotUrl(URL.createObjectURL(file));\n  };\n\n  return (\n    <section id=\"features\" className=\"relative py-24 lg:py-32 border-b border-[#2A2A2A]\">\n      <div className=\"mx-auto max-w-[1200px] px-4 sm:px-6\">\n        {/* Section Header */}\n        <div className=\"max-w-2xl mb-14\">\n          <p className=\"text-xs font-mono text-[#A1A1AA] mb-2\">\n            02. \320\220\321\200\321\205\320\270\321\202\320\265\320\272\321\202\321\203\321\200\320\260 \320\261\320\265\320\267 \320\272\320\276\320\274\320\277\321\200\320\276\320\274\320\270\321\201\321\201\320\276\320\262\n          </p>\n          <h2\n            style={{ fontSize: \'clamp(1.75rem, 3vw, 2.75rem)\' }}\n            className=\"font-bold tracking-tight text-[#FAFAFA] leading-[1.12] [text-wrap:balance]\"\n          >\n            \320\230\320\275\320\266\320\265\320\275\320\265\321\200\320\275\320\276\320\265 \320\277\321\200\320\265\320\262\320\276\321\201\321\205\320\276\320\264\321\201\321\202\320\262\320\276 \320\262 \320\272\320\260\320\266\320\264\320\276\320\271 \320\264\320\265\321\202\320\260\320\273\320\270 \321\201\320\276\320\265\320\264\320\270\320\275\320\265\320\275\320\270\321\217\n          </h2>\n          <p className=\"mt-4 text-base text-[#A1A1AA] leading-relaxed\">\n            \320\222\320\274\320\265\321\201\321\202\320\276 \320\260\321\200\320\265\320\275\320\264\321\213 \320\277\320\265\321\200\320\265\320\263\321\200\321\203\320\266\320\265\320\275\320\275\321\213\321\205 \320\262\320\270\321\200\321\202\321\203\320\260\320\273\321\214\320\275\321\213\321\205 \320\272\320\276\320\275\321\202\320\265\320\271\320\275\320\265\321\200\320\276\320\262 \320\274\321\213 \321\201\321\202\321\200\320\276\320\270\320\274 \321\201\320\265\321\202\321\214 \320\275\320\260 \320\262\321\213\320\264\320\265\320\273\320\265\320\275\320\275\321\213\321\205 \321\204\320\270\320\267\320\270\321\207\320\265\321\201\320\272\320\270\321\205 \321\203\320\267\320\273\320\260\321\205 \321\201 \320\277\321\200\321\217\320\274\320\276\320\271 \320\274\320\260\321\200\321\210\321\200\321\203\321\202\320\270\320\267\320\260\321\206\320\270\320\265\320\271 \320\264\320\276 \320\272\321\200\321\203\320\277\320\275\320\265\320\271\321\210\320\270\321\205 \321\202\320\276\321\207\320\265\320\272 \320\276\320\261\320\274\320\265\320\275\320\260 \321\202\321\200\320\260\321\204\320\270\320\272\320\276\320\274 \320\225\320\262\321\200\320\276\320\277\321\213, \320\220\320\267\320\270\320\270 \320\270 \320\241\320\250\320\220.\n          </p>\n        </div>\n\n        {/* Asymmetric Bento Grid */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">\n          {/* Card 1: Speed 15 Gbit/s (Col Span 7) */}\n          <motion.div\n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true, margin: \'-80px\' }}\n            transition={{ duration: 0.5, ease: [0.16, 1, 0.3, 1] }}\n            className=\"double-bezel-shell lg:col-span-7 hover:border-[#FDE047]/35\"\n          >\n            <div className=\"double-bezel-core h-full p-6 sm:p-8 flex flex-col justify-between bg-gradient-to-br from-[#FDE047]/[0.04] via-transparent to-transparent\">\n              <div>\n                <div className=\"flex items-center justify-between gap-4\">\n                  <span className=\"text-xs font-mono text-[#A1A1AA]\">\n                    01. \320\237\321\200\320\276\320\277\321\203\321\201\320\272\320\275\320\260\321\217 \321\201\320\277\320\276\321\201\320\276\320\261\320\275\320\276\321\201\321\202\321\214\n                  </span>\n                  <Gauge className=\"h-5 w-5 text-[#FDE047]\" />\n                </div>\n\n                <h3 className=\"mt-4 text-2xl sm:text-3xl font-bold tracking-tight text-[#FAFAFA]\">\n                  \320\241\320\272\320\276\321\200\320\276\321\201\321\202\321\214 \320\272\320\260\320\275\320\260\320\273\320\260 \320\264\320\276 15 \320\223\320\261\320\270\321\202/\321\201\n                </h3>\n                <p className=\"mt-2.5 text-sm sm:text-base text-[#A1A1AA] leading-relaxed max-w-xl\">\n                  \320\220\320\263\321\200\320\265\320\263\320\270\321\200\320\276\320\262\320\260\320\275\320\275\321\213\320\265 \320\277\320\276\321\200\321\202\321\213 10G \320\270 25G \320\262 \320\264\320\260\321\202\320\260-\321\206\320\265\320\275\321\202\321\200\320\260\321\205 Equinix (\320\244\321\200\320\260\320\275\320\272\321\204\321\203\321\200\321\202, \320\220\320\274\321\201\321\202\320\265\321\200\320\264\320\260\320\274, \320\245\320\265\320\273\321\214\321\201\320\270\320\275\320\272\320\270). \320\241\321\202\321\200\320\270\320\274\320\270\320\275\320\263 \320\262 4K HDR, \320\276\320\261\320\273\320\260\321\207\320\275\321\213\320\271 \320\263\320\265\320\271\320\274\320\270\320\275\320\263 \320\270 \320\267\320\260\320\263\321\200\321\203\320\267\320\272\320\260 \321\202\321\217\320\266\320\265\320\273\321\213\321\205 \321\200\320\265\320\277\320\276\320\267\320\270\321\202\320\276\321\200\320\270\320\265\320\262 \320\261\320\265\320\267 \320\277\321\200\320\276\321\201\320\260\320\264\320\276\320\272 \320\262 \320\262\320\265\321\207\320\265\321\200\320\275\320\270\320\271 \320\277\321\200\320\260\320\271\320\274-\321\202\320\260\320\271\320\274.\n                </p>\n              </div>\n\n              {/* Interactive Node Speed Comparator */}\n              <div className=\"mt-8 rounded-xl border border-[#2A2A2A] bg-[#141414] p-4 sm:p-5\">\n                <div className=\"flex flex-wrap items-center justify-between gap-2 mb-4\">\n                  <span className=\"text-xs font-medium text-[#FAFAFA]\">\n                    \320\242\320\265\321\201\321\202 \320\277\321\200\320\276\320\277\321\203\321\201\320\272\320\275\320\276\320\271 \321\201\320\277\320\276\321\201\320\276\320\261\320\275\320\276\321\201\321\202\320\270 \321\203\320\267\320\273\320\260:\n                  </span>\n                  <div className=\"flex flex-wrap gap-1.5\">\n                    {SERVER_NODES.slice(0, 4).map((node) => (\n                      <button\n                        key={node.id}\n                        type=\"button\"\n                        onClick={() => setBenchmarkNode(node)}\n                        className={`tactile-btn rounded-md px-2.5 py-1 text-xs font-mono cursor-pointer ${\n                          benchmarkNode.id === node.id\n                            ? \'bg-[#FDE047] text-black font-semibold\'\n                            : \'border border-[#2A2A2A] bg-[#1A1A1A] text-[#A1A1AA] hover:text-[#FAFAFA]\'\n                        }`}\n                      >\n                        {node.city}\n                      </button>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Comparison Bars */}\n                <div className=\"space-y-3.5\">\n                  <div>\n                    <div className=\"flex items-center justify-between text-xs mb-1.5 tabular-nums\">\n                      <span className=\"font-semibold text-[#FAFAFA]\">\n                        Anke Bare-Metal ({benchmarkNode.code})\n                      </span>\n                      <span className=\"font-mono font-semibold text-[#FDE047]\">\n                        {benchmarkNode.speedGbps.toFixed(1)} \320\223\320\261\320\270\321\202/\321\201 \302\267 {benchmarkNode.pingMs} \320\274\321\201\n                      </span>\n                    </div>\n                    <div className=\"h-2.5 w-full overflow-hidden rounded-full bg-[#222222]\">\n                      <div\n                        style={{ width: `${(benchmarkNode.speedGbps / 15) * 100}%` }}\n                        className=\"h-full rounded-full bg-[#FDE047] transition-all duration-300\"\n                      />\n                    </div>\n                  </div>\n\n                  <div>\n                    <div className=\"flex items-center justify-between text-xs text-[#A1A1AA] mb-1.5 tabular-nums\">\n                      <span>\320\241\321\202\320\260\320\275\320\264\320\260\321\200\321\202\320\275\321\213\320\271 \320\272\320\276\320\274\320\274\320\265\321\200\321\207\320\265\321\201\320\272\320\270\320\271 VPN (Shared VPS)</span>\n                      <span className=\"font-mono\">0.4 \320\223\320\261\320\270\321\202/\321\201 \302\267 85 \320\274\321\201</span>\n                    </div>\n                    <div className=\"h-2 w-full overflow-hidden rounded-full bg-[#222222]\">\n                      <div className=\"h-full w-[8%] rounded-full bg-[#52525B]\" />\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </motion.div>\n\n          {/* Card 2: Privacy & RAM-Only Architecture (Col Span 5) */}\n          <motion.div\n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true, margin: \'-80px\' }}\n            transition={{ duration: 0.5, delay: 0.08, ease: [0.16, 1, 0.3, 1] }}\n            className=\"double-bezel-shell lg:col-span-5 hover:border-[#FDE047]/35\"\n          >\n            <div className=\"double-bezel-core h-full p-6 sm:p-8 flex flex-col justify-between\">\n              <div>\n                <div className=\"flex items-center justify-between gap-4\">\n                  <span className=\"text-xs font-mono text-[#A1A1AA]\">\n                    02. \320\237\321\200\320\270\320\262\320\260\321\202\320\275\320\276\321\201\321\202\321\214 \320\270 \320\272\321\200\320\270\320\277\321\202\320\276\320\263\321\200\320\260\321\204\320\270\321\217\n                  </span>\n                  <Shield className=\"h-5 w-5 text-[#FDE047]\" />\n                </div>\n\n                <h3 className=\"mt-4 text-2xl font-bold tracking-tight text-[#FAFAFA]\">\n                  \320\220\320\261\321\201\320\276\320\273\321\216\321\202\320\275\320\260\321\217 \320\277\321\200\320\270\320\262\320\260\321\202\320\275\320\276\321\201\321\202\321\214 \320\275\320\260 RAM-\321\201\320\265\321\200\320\262\320\265\321\200\320\260\321\205\n                </h3>\n                <p className=\"mt-2.5 text-sm text-[#A1A1AA] leading-relaxed\">\n                  \320\222\321\201\320\265 \321\203\320\267\320\273\321\213 \321\200\320\260\320\261\320\276\321\202\320\260\321\216\321\202 \320\262 \320\261\320\265\320\267\320\264\320\270\321\201\320\272\320\276\320\262\320\276\320\274 \321\200\320\265\320\266\320\270\320\274\320\265 (RAM-Only): \320\276\320\277\320\265\321\200\320\260\321\206\320\270\320\276\320\275\320\275\320\260\321\217 \321\201\320\270\321\201\321\202\320\265\320\274\320\260 \320\267\320\260\320\263\321\200\321\203\320\266\320\260\320\265\321\202\321\201\321\217 \320\262 \321\215\320\275\320\265\321\200\320\263\320\276\320\267\320\260\320\262\320\270\321\201\320\270\320\274\321\203\321\216 \320\277\320\260\320\274\321\217\321\202\321\214. \320\234\321\213 \321\202\320\265\321\205\320\275\320\270\321\207\320\265\321\201\320\272\320\270 \320\275\320\265 \320\274\320\276\320\266\320\265\320\274 \321\205\321\200\320\260\320\275\320\270\321\202\321\214 \320\270\321\201\321\202\320\276\321\200\320\270\321\216 DNS-\320\267\320\260\320\277\321\200\320\276\321\201\320\276\320\262 \320\270\320\273\320\270 \320\274\320\265\321\202\320\260\320\264\320\260\320\275\320\275\321\213\320\265 \321\201\320\265\321\201\321\201\320\270\320\271.\n                </p>\n              </div>\n\n              <div className=\"mt-8 space-y-2.5\">\n                <div className=\"flex items-center justify-between rounded-lg border border-[#2A2A2A] bg-[#141414] px-4 py-3 text-xs\">\n                  <span className=\"text-[#A1A1AA]\">\320\250\320\270\321\204\321\200\320\276\320\262\320\260\320\275\320\270\320\265 \320\277\320\276\321\202\320\276\320\272\320\260</span>\n                  <span className=\"font-mono text-[#FAFAFA]\">ChaCha20-Poly1305</span>\n                </div>\n                <div className=\"flex items-center justify-between rounded-lg border border-[#2A2A2A] bg-[#141414] px-4 py-3 text-xs\">\n                  <span className=\"text-[#A1A1AA]\">\320\245\321\200\320\260\320\275\320\265\320\275\320\270\320\265 \320\273\320\276\320\263\320\276\320\262 \320\275\320\260 \320\264\320\270\321\201\320\272\320\260\321\205</span>\n                  <span className=\"font-mono text-[#FDE047]\">0 \320\261\320\260\320\271\321\202 (Volatile RAM)</span>\n                </div>\n                <div className=\"flex items-center justify-between rounded-lg border border-[#2A2A2A] bg-[#141414] px-4 py-3 text-xs\">\n                  <span className=\"text-[#A1A1AA]\">\320\227\320\260\321\211\320\270\321\202\320\260 \320\276\321\202 \321\203\321\202\320\265\321\207\320\265\320\272</span>\n                  <span className=\"font-mono text-[#FAFAFA]\">DNS-over-HTTPS + Kill Switch</span>\n                </div>\n              </div>\n            </div>\n          </motion.div>\n\n          {/* Card 3: Stealth Anti-DPI & Split Tunneling (Col Span 5) */}\n          <motion.div\n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{