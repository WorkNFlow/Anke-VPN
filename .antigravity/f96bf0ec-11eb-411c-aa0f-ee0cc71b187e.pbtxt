  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useRef } from \'react\';\nimport {\n  motion,\n  useScroll,\n  useTransform,\n  useMotionValue,\n  useSpring,\n  useReducedMotion,\n} from \'motion/react\';\nimport { Upload } from \'lucide-react\';\nimport { AnkeLogo } from \'./AnkeLogo\';\nimport { IPhone3DModel, IPhoneTab } from \'./IPhone3DModel\';\n\nexport const HeroMockup: React.FC = () => {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n  const shouldReduceMotion = useReducedMotion();\n\n  const [activeTab, setActiveTab] = useState<IPhoneTab>(\'regions\');\n  const [customScreenshotUrl, setCustomScreenshotUrl] = useState<string | null>(null);\n\n  // Scroll parallax\n  const { scrollYProgress } = useScroll({\n    target: containerRef,\n    offset: [\'start end\', \'end start\'],\n  });\n  const yParallax = useTransform(\n    scrollYProgress,\n    [0, 1],\n    shouldReduceMotion ? [0, 0] : [16, -28]\n  );\n\n  // 3D Mouse-tracking spring physics on the Hero iPhone\n  const mouseX = useMotionValue(0);\n  const mouseY = useMotionValue(0);\n\n  const rotateX = useSpring(\n    useTransform(mouseY, [-0.5, 0.5], shouldReduceMotion ? [0, 0] : [9, -9]),\n    { stiffness: 150, damping: 18 }\n  );\n  const rotateY = useSpring(\n    useTransform(mouseX, [-0.5, 0.5], shouldReduceMotion ? [0, 0] : [-12, 12]),\n    { stiffness: 150, damping: 18 }\n  );\n\n  const handleMouseMove = (e: React.MouseEvent<HTMLDivElement>) => {\n    if (!containerRef.current || shouldReduceMotion) return;\n    const rect = containerRef.current.getBoundingClientRect();\n    const xPct = (e.clientX - rect.left) / rect.width - 0.5;\n    const yPct = (e.clientY - rect.top) / rect.height - 0.5;\n    mouseX.set(xPct);\n    mouseY.set(yPct);\n  };\n\n  const handleMouseLeave = () => {\n    mouseX.set(0);\n    mouseY.set(0);\n  };\n\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    setCustomScreenshotUrl(URL.createObjectURL(file));\n  };\n\n  return (\n    <motion.div\n      ref={containerRef}\n      style={{ y: yParallax, perspective: 1200 }}\n      onMouseMove={handleMouseMove}\n      onMouseLeave={handleMouseLeave}\n      className=\"relative w-full flex flex-col items-center lg:items-end\"\n    >\n      {/* Floating Official Anke Logo behind the 3D iPhone */}\n      <motion.div\n        aria-hidden=\"true\"\n        animate={\n          shouldReduceMotion\n            ? {}\n            : {\n                y: [0, -14, 0],\n                rotate: [0, 3, 0],\n              }\n        }\n        transition={{ duration: 6, repeat: Infinity, ease: \'easeInOut\' }}\n        className=\"pointer-events-none absolute -top-8 right-2 sm:right-6 z-0 opacity-25\"\n      >\n        <AnkeLogo className=\"h-44 w-auto\" />\n      </motion.div>\n\n      <div\n        aria-hidden=\"true\"\n        className=\"pointer-events-none absolute inset-0 m-auto h-96 w-80 rounded-full bg-[#FDE047]/[0.1] blur-3xl\"\n      />\n\n      <input\n        ref={fileInputRef}\n        type=\"file\"\n        accept=\"image/*\"\n        onChange={handleFileUpload}\n        className=\"hidden\"\n      />\n\n      {/* Interactive 3D Tilted iPhone in Hero */}\n      <motion.div\n        style={{\n          rotateX,\n          rotateY,\n          transformStyle: \'preserve-3d\',\n        }}\n        className=\"relative z-10 lg:-rotate-[2deg] hover:rotate-0 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]\"\n      >\n        <IPhone3DModel\n          activeTab={activeTab}\n          onTabChange={setActiveTab}\n          customScreenshotUrl={customScreenshotUrl}\n        />\n      </motion.div>\n\n      {/* Subtle Helper Control Below the 3D iPhone */}\n      <div className=\"relative z-10 mt-4 flex items-center gap-3 text-xs text-[#A1A1AA]\">\n        <span>\320\235\320\260\320\266\320\270\320\274\320\260\320\271\321\202\320\265 \320\275\320\260 \320\262\320\272\320\273\320\260\320\264\320\272\320\270 \321\201\320\274\320\260\321\200\321\202\321\204\320\276\320\275\320\260</span>\n        <span aria-hidden=\"true\">\302\267</span>\n        {customScreenshotUrl ? (\n          <button\n            type=\"button\"\n            onClick={() => setCustomScreenshotUrl(null)}\n            className=\"text-[#FDE047] hover:underline cursor-pointer\"\n          >\n            \320\241\320\261\321\200\320\276\321\201\320\270\321\202\321\214 \321\201\320\272\321\200\320\270\320\275\321\210\320\276\321\202\n          </button>\n        ) : (\n          <button\n            type=\"button\"\n            onClick={() => fileInputRef.current?.click()}\n            className=\"inline-flex items-center gap-1 text-[#FDE047] hover:underline cursor-pointer\"\n          >\n            <Upload className=\"h-3 w-3\" />\n            <span>\320\241\320\262\320\276\320\271 \321\201\320\272\321\200\320\270\320\275\321\210\320\276\321\202</span>\n          </button>\n        )}\n      </div>\n    </motion.div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/HeroMockup.tsx"
        }
        overwrite: true
      }
    }
