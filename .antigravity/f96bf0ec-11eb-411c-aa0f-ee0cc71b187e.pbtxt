  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { MessageSquare, X, Send, ArrowUpRight } from \'lucide-react\';\n\ninterface ChatMessage {\n  id: string;\n  sender: \'engineer\' | \'user\';\n  text: string;\n  time: string;\n}\n\nexport const SupportChatWidget: React.FC = () => {\n  const [isOpen, setIsOpen] = useState(false);\n  const [scriptReady, setScriptReady] = useState(false);\n  const [inputValue, setInputValue] = useState(\'\');\n  const [messages, setMessages] = useState<ChatMessage[]>([\n    {\n      id: \'welcome-1\',\n      sender: \'engineer\',\n      text: \'\320\227\320\264\321\200\320\260\320\262\321\201\321\202\320\262\321\203\320\271\321\202\320\265! \320\224\320\265\320\266\321\203\321\200\320\275\321\213\320\271 \321\201\320\265\321\202\320\265\320\262\320\276\320\271 \320\270\320\275\320\266\320\265\320\275\320\265\321\200 Anke VPN \320\275\320\260 \321\201\320\262\321\217\320\267\320\270. \320\237\320\276\320\274\320\276\321\207\321\214 \321\201 \320\262\321\213\320\261\320\276\321\200\320\276\320\274 \320\277\321\200\320\276\321\202\320\276\320\272\320\276\320\273\320\260, \320\275\320\260\321\201\321\202\321\200\320\276\320\271\320\272\320\276\320\271 \321\200\320\276\321\203\321\202\320\265\321\200\320\260 \320\270\320\273\320\270 \320\276\320\277\320\273\320\260\321\202\320\276\320\271?\',\n      time: \'\320\241\320\265\320\271\321\207\320\260\321\201\',\n    },\n  ]);\n\n  // Safe lazyOnload initialization pattern (AGENTS.md Rule #4) so chat never blocks LCP\n  useEffect(() => {\n    const initLazyChat = () => {\n      setScriptReady(true);\n    };\n\n    if (\'requestIdleCallback\' in window) {\n      const id = (window as Window & { requestIdleCallback: (cb: () => void) => number }).requestIdleCallback(\n        initLazyChat\n      );\n      return () => {\n        if (\'cancelIdleCallback\' in window) {\n          (window as Window & { cancelIdleCallback: (id: number) => void }).cancelIdleCallback(id);\n        }\n      };\n    } else {\n      const timer = setTimeout(initLazyChat, 1200);\n      return () => clearTimeout(timer);\n    }\n  }, []);\n\n  const handleSendMessage = (e: React.FormEvent) => {\n    e.preventDefault();\n    const trimmed = inputValue.trim();\n    if (!trimmed) return;\n\n    const userMsg: ChatMessage = {\n      id: `u-${Date.now()}`,\n      sender: \'user\',\n      text: trimmed,\n      time: \'\320\242\320\276\320\273\321\214\320\272\320\276 \321\207\321\202\320\276\',\n    };\n\n    setMessages((prev) => [...prev, userMsg]);\n    setInputValue(\'\');\n\n    setTimeout(() => {\n      setMessages((prev) => [\n        ...prev,\n        {\n          id: `e-${Date.now()}`,\n          sender: \'engineer\',\n          text: \'\320\237\321\200\320\270\320\275\321\217\321\202\320\276! \320\234\321\213 \320\277\321\200\320\276\320\262\320\265\321\200\320\270\320\273\320\270 \320\264\320\276\321\201\321\202\321\203\320\277\320\275\320\276\321\201\321\202\321\214 \321\203\320\267\320\273\320\276\320\262: \320\245\320\265\320\273\321\214\321\201\320\270\320\275\320\272\320\270 (14 \320\274\321\201) \320\270 \320\244\321\200\320\260\320\275\320\272\321\204\321\203\321\200\321\202 (18 \320\274\321\201) \321\200\320\260\320\261\320\276\321\202\320\260\321\216\321\202 \320\262 \321\210\321\202\320\260\321\202\320\275\320\276\320\274 \321\200\320\265\320\266\320\270\320\274\320\265 15 \320\223\320\261\320\270\321\202/\321\201. \320\225\321\201\320\273\320\270 \320\275\321\203\320\266\320\265\320\275 \320\261\321\213\321\201\321\202\321\200\321\213\320\271 \320\270\320\274\320\277\320\276\321\200\321\202 \320\272\320\273\321\216\321\207\320\260 \320\262 Telegram, \320\275\320\260\320\266\320\274\320\270\321\202\320\265 \320\272\320\275\320\276\320\277\320\272\321\203 \320\275\320\270\320\266\320\265.\',\n          time: \'\320\242\320\276\320\273\321\214\320\272\320\276 \321\207\321\202\320\276\',\n        },\n      ]);\n    }, 600);\n  };\n\n  if (!scriptReady) return null;\n\n  return (\n    <div className=\"fixed bottom-5 right-5 z-40\">\n      <AnimatePresence>\n        {isOpen && (\n          <motion.div\n            initial={{ opacity: 0, scale: 0.95, y: 12 }}\n            animate={{ opacity: 1, scale: 1, y: 0 }}\n            exit={{ opacity: 0, scale: 0.95, y: 10 }}\n            transition={{ duration: 0.18, ease: [0.16, 1, 0.3, 1] }}\n            style={{ transformOrigin: \'bottom right\' }}\n            className=\"mb-3 w-[340px] sm:w-[370px] double-bezel-shell shadow-[0_20px_50px_rgba(0,0,0,0.85)]\"\n          >\n            <div className=\"double-bezel-core overflow-hidden\">\n              {/* Chat Header */}\n              <div className=\"flex items-center justify-between border-b border-[#2A2A2A] bg-[#141414] px-4 py-3\">\n                <div>\n                  <div className=\"text-xs font-bold text-[#FAFAFA]\">\n                    \320\230\320\275\320\266\320\265\320\275\320\265\321\200\320\275\320\260\321\217 \320\277\320\276\320\264\320\264\320\265\321\200\320\266\320\272\320\260 Anke 24/7\n                  </div>\n                  <div className=\"text-[11px] font-mono text-[#A1A1AA]\">\n                    \320\241\321\200\320\265\320\264\320\275\320\265\320\265 \320\262\321\200\320\265\320\274\321\217 \320\276\321\202\320\262\320\265\321\202\320\260: &lt; 3 \320\274\320\270\320\275\n                  </div>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => setIsOpen(false)}\n                  aria-label=\"\320\241\320\262\320\265\321\200\320\275\321\203\321\202\321\214 \321\207\320\260\321\202 \320\277\320\276\320\264\320\264\320\265\321\200\320\266\320\272\320\270\"\n                  className=\"tactile-btn rounded-lg border border-[#2A2A2A] bg-[#1A1A1A] p-1.5 text-[#A1A1AA] hover:text-[#FAFAFA] cursor-pointer\"\n                >\n                  <X className=\"h-4 w-4\" />\n                </button>\n              </div>\n\n              {/* Messages Container */}\n              <div className=\"max-h-64 overflow-y-auto p-4 space-y-3 bg-[#1A1A1A]\">\n                {messages.map((msg) => (\n                  <div\n                    key={msg.id}\n                    className={`flex flex-col ${\n                      msg.sender === \'user\' ? \'items-end\' : \'items-start\'\n                    }`}\n                  >\n                    <div\n                      className={`max-w-[85%] rounded-xl px-3.5 py-2.5 text-xs leading-relaxed ${\n                        msg.sender === \'user\'\n                          ? \'bg-[#FDE047] text-black font-medium\'\n                          : \'border border-[#2A2A2A] bg-[#141414] text-[#FAFAFA]\'\n                      }`}\n                    >\n                      {msg.text}\n                    </div>\n                    <span className=\"mt-1 text-[10px] font-mono text-[#A1A1AA]\">\n                      {msg.time}\n                    </span>\n                  </div>\n                ))}\n              </div>\n\n              {/* Quick Telegram Link + Input */}\n              <div className=\"border-t border-[#2A2A2A] bg-[#141414] p-3\">\n                <form onSubmit={handleSendMessage} className=\"flex items-center gap-2\">\n                  <input\n                    type=\"text\"\n                    value={inputValue}\n                    onChange={(e) => setInputValue(e.target.value)}\n                    placeholder=\"\320\235\320\260\320\277\320\270\321\210\320\270\321\202\320\265 \320\262\320\276\320\277\321\200\320\276\321\201 \320\270\320\275\320\266\320\265\320\275\320\265\321\200\321\203...\"\n                    className=\"flex-1 rounded-lg border border-[#2A2A2A] bg-[#111111] px-3 py-2 text-xs text-[#FAFAFA] placeholder:text-[#A1A1AA]/60 focus:border-[#FDE047] focus:outline-none\"\n                  />\n                  <button\n                    type=\"submit\"\n                    aria-label=\"\320\236\321\202\320\277\321\200\320\260\320\262\320\270\321\202\321\214 \321\201\320\276\320\276\320\261\321\211\320\265\320\275\320\270\320\265\"\n                    className=\"tactile-btn flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#FDE047] text-black hover:bg-[#FDE047]/90 cursor-pointer\"\n                  >\n                    <Send className=\"h-3.5 w-3.5\" />\n                  </button>\n                </form>\n                <div className=\"mt-2 flex items-center justify-between text-[11px] text-[#A1A1AA] px-1\">\n                  <span>\320\237\321\200\320\265\320\264\320\277\320\276\321\207\320\270\321\202\320\260\320\265\321\202\320\265 \320\274\320\265\321\201\321\201\320\265\320\275\320\264\320\266\320\265\321\200?</span>\n                  <a\n                    href=\"https://anke.dev/vnp/ru/\"\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    className=\"inline-flex items-center gap-1 font-medium text-[#FDE047] hover:underline\"\n                  >\n                    <span>Telegram-\320\261\320\276\321\202</span>\n                    <ArrowUpRight className=\"h-3 w-3\" />\n                  </a>\n                </div>\n              </div>\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      {/* Floating Launcher Button */}\n      <button\n        type=\"button\"\n        onClick={() => setIsOpen((prev) => !prev)}\n        aria-label=\"\320\236\321\202\320\272\321\200\321\213\321\202\321\214 \321\207\320\260\321\202 \320\277\320\276\320\264\320\264\320\265\321\200\320\266\320\272\320\270\"\n        className=\"tactile-btn flex items-center gap-2.5 rounded-full border border-[#2A2A2A] bg-[#1A1A1A] hover:border-[#FDE047]/60 px-4 py-3 text-xs font-semibold text-[#FAFAFA] shadow-[0_12px_32px_rgba(0,0,0,0.75)] cursor-pointer\"\n      >\n        <span className=\"flex h-7 w-7 items-center justify-center rounded-full bg-[#FDE047] text-black\">\n          <MessageSquare className=\"h-3.5 w-3.5\" />\n        </span>\n        <span className=\"pr-1\">\320\237\320\276\320\264\320\264\320\265\321\200\320\266\320\272\320\260 24/7</span>\n      </button>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/SupportChatWidget.tsx"
        }
        overwrite: true
      }
    }
