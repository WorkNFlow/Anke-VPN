              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        targetRotateY = shouldReduceMotion ? 0 : -12 + 12 * localP;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        targetRotateX = shouldReduceMotion ? 0 : 6 - 4 * localP;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        targetRotateZ = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        targetRotateY = shouldReduceMotion ? 0 : -22 + 38 * localP;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        targetRotateX = shouldReduceMotion ? 0 : 10 - 6 * localP;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        targetRotateZ = shouldReduceMotion ? 0 : -2 + 4 * localP;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      } else if (rawP < 0.68) {"
