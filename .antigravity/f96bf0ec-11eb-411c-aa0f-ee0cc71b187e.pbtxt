      thinking_signature: "\022\221\t\n\216\t\001i\024}\023\335\021\005D\301\240n\345\331 \225[c\202\016\260\271`\251\316\305\031\341\210\243\223\027\274\354\345\241\277\335\026\246J\245\266\a\242,e8\236\304b0\'\032\n\256{\267N\267\341\231\206\222\274\343\366\317\223\016\225\202M\267{w}\360\207S\351\334\320\004,j\241\253\217\337%\206\370\245\347y\242]\224\352U2\304\t*^\330\320w\331\207\266t*j6Y?\025w\361\326@6\245\177\224i\377\267]\034\334\201w\2270\270J\344Vp\026\026\322\214\234\333\200\326\v\2000_\224\003\337\354Ch\323\207\200_\370\240\023\270+\006\322\314\f\020zp5\210\242\213V\254I\332\001mB\344\3245\0325&+Uv`\345\367\371\322\256|\351E\233\242\204-\004\206\n\365S\\\\U\006b\224\266\343\005\222$\020\214;-\371\202\344\025\275\304\354\241\266\237ye\246(\203\302 \301\334J\273\331W\a\271\337\243\323\025\326\200=\372^\\\022#hZ\n\354)\004F\001P\233\002n+\320\3750l\301H\312\322\036\0010\361\213\225\017!\224\324\t\313\367:\247Y\242\336\230M\322\325t\220\r\242\330\244\207\n\b8\300\376\246\234\262\002\262\276\321\260\342\242e\351+\213\3230K\377 {\026\335\313!\235(v\255ESeD\005\216\273\203\305\334\'\230\274\f\305\257u\337\240*2)\001\263\254\005o\nS\326\201\341\025^D\275\232\377a\230\371\364[\3141F\345\376\353\207:\000\233Y#\232\247g1\324r\314\357\364W\'\235\256\026T\371\267z\236\363\373\277\323\246\245\315\353FC\005\264\321\226\222\240c\375\307|\225\255\363\317\240`\336\b\270\366\231\302h+\270Ye\025\005@\203&\304\251\002^^\3419\370\204$Ub\002\224\212\025\337\035\350\235+\341\244\224\250\356\204\302\202\217\243\002\301\223\376\327Y|K[\0164\340,\245=\264S\210p\312\323\377o\252w\311\370\3177\005\2752\260\317/3\213\r\314:\375#\336\367\332\235\304p?4X\263}\277\2328\256\006\330\0161\360j\315\003hSX5`\362r\207\036\247k\272\f$\3225GE7\334\341Q.\301\236Q7\351<\341\324\t\205\257\247Z\035\345\235\275&$S*\3269N\212j<\021_\264\255]\315\004\234~/;O\026i\334\002t\036\026D\266z\v\313\360\373\036\241A\377zwo\367\263\t\376\036W\237\'\314\360\273\027\315\377\"O\376\337/\276\262\000\001\nd\335+B\215\017y\341Z\266\334\202\357@{\035\306\324\004\271\224/\245\232F:\3314uj=l\021\250\345\n\"5\265\267A6\0374\324\v\030X:Hl\266\225\3268\035\362\242\244@\017\246\b\350\262\216\030\255\025\324~\253f0m\326\354\325\002\000\323X\365r\243aW\253\337\263\213n\026\037\335\333*\250\225\b\"\266\2024{!l\2762E1\272\230!\233\023w\233rdM\316\202KeS\325\345J\306\300\235%\304\245\324\305,\217]\214oE\204\326\343\244\225\r\330 s\375\211\353r\264\376W\342a\214\252\b\366\237o\031i\227\376\a\353\241p,\005\3420nL\243xy\274\rx\032\0053\232\027\300\326\276I5\034\021\377\200\323\bC\363\360O\201\307f{\020\376 \306<\253\240\374#\270\377\336G\250\242\222\356\231\246\027\237Ht\236ztv/\334Z,h\240r\214\232WL\354\211\017zm\347\370a\275\243n\270v\352\305P\313\334<\231\255\347].\t\005\212_U<\235\3329s\373\227\223=\217\226 \204HXh\nE\252i\3505 \335\004\353\334\251\377\205\320\260\212\367T \017\310\362\321\025\312\207\231\r\211\345\327\363@(\304\255\201\230\210?e\3112\206\306<\325\241\347\274\335\321OQk{6aXO\365#\bU\353\362OBR\021\333S\274(\316\370\020\026<\246\021b\301c\354\241^h\231\241\233\316\304\250\363\233\227\343\265\027)\310\032\334\315\203i@\224\270\266Z:ps,(\222\277?\t\206\360\226\026\036u\244D*\325\362.\357\3112\233N\a\320\034<\237^\373\341\r\261n\223=z\034\265\375 \336\245\375,\241\202W9\354\3270F\301\367X\320\227B\002\227\2537iU\322\3657\377%Us\265\353\202\326\335WK\275`\236\b91\207\rc"
