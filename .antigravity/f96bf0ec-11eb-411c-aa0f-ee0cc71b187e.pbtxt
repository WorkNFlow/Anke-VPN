\320\276\320\262\320\260\320\275\320\270\321\217 \320\242\320\241\320\237\320\243 \320\262\320\260\321\210 \321\202\321\200\320\260\321\204\320\270\320\272 \320\262\321\213\320\263\320\273\321\217\320\264\320\270\321\202 \320\272\320\260\320\272 \320\276\320\261\321\213\321\207\320\275\320\276\320\265 \320\277\320\276\321\201\320\265\321\211\320\265\320\275\320\270\320\265 \320\267\320\260\321\200\321\203\320\261\320\265\320\266\320\275\321\213\321\205 \320\272\320\276\321\200\320\277\320\276\321\200\320\260\321\202\320\270\320\262\320\275\321\213\321\205 \321\201\320\260\320\271\321\202\320\276\320\262 \320\277\320\276 HTTPS, \320\277\320\276\321\215\321\202\320\276\320\274\321\203 \321\201\320\276\320\265\320\264\320\270\320\275\320\265\320\275\320\270\320\265 \320\275\320\265 \320\261\320\273\320\276\320\272\320\270\321\200\321\203\320\265\321\202\321\201\321\217 \320\270 \320\275\320\265 \320\277\320\276\320\264\320\262\320\265\321\200\320\263\320\260\320\265\321\202\321\201\321\217 \320\270\321\201\320\272\321\203\321\201\321\201\321\202\320\262\320\265\320\275\320\275\320\276\320\274\321\203 \321\210\320\265\320\271\320\277\320\270\320\275\320\263\321\203 \321\201\320\272\320\276\321\200\320\276\321\201\321\202\320\270.\',\n  },\n  {\n    question: \'\320\235\321\203\320\266\320\275\320\276 \320\273\320\270 \320\276\321\202\320\272\320\273\321\216\321\207\320\260\321\202\321\214 VPN \320\264\320\273\321\217 \320\262\321\205\320\276\320\264\320\260 \320\262 \321\200\320\276\321\201\321\201\320\270\320\271\321\201\320\272\320\270\320\265 \320\261\320\260\320\275\320\272\320\270 \320\270 \320\223\320\276\321\201\321\203\321\201\320\273\321\203\320\263\320\270?\',\n    answer:\n      \'\320\235\320\265\321\202. \320\222 \320\277\321\200\320\270\320\273\320\276\320\266\320\265\320\275\320\270\320\270 \320\275\320\260\321\201\321\202\321\200\320\276\320\265\320\275\320\260 \320\274\320\260\321\200\321\210\321\200\321\203\321\202\320\270\320\267\320\260\321\206\320\2