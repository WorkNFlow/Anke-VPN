20\270\321\217\320\274\320\270 \320\262 28 \321\201\321\202\321\200\320\260\320\275\320\260\321\205 \320\274\320\270\321\200\320\260 \320\262 \320\276\320\264\320\270\320\275 \320\272\320\273\320\270\320\272. \320\240\320\265\320\267\320\270\320\264\320\265\320\275\321\206\320\270\320\260\320\273\321\214\320\275\321\213\320\265 \320\270 \320\264\320\260\321\202\320\260-\321\206\320\265\320\275\321\202\321\200 IP-\320\260\320\264\321\200\320\265\321\201\320\260 \320\276\320\261\320\265\321\201\320\277\320\265\321\207\320\270\320\262\320\260\321\216\321\202 \320\261\320\265\321\201\320\277\320\265\321\200\320\265\320\261\320\276\320\271\320\275\321\203\321\216 \321\200\320\260\320\261\320\276\321\202\321\203 \321\201\321\202\321\200\320\270\320\274\320\270\320\275\320\263\320\276\320\262\321\213\321\205 \320\277\320\273\320\260\321\202\321\204\320\276\321\200\320\274, \321\200\320\260\320\261\320\276\321\207\320\270\321\205 \320\270\320\275\321\201\321\202\321\200\321\203\320\274\320\265\320\275\321\202\320\276\320\262, \320\276\320\261\320\273\320\260\321\207\320\275\321\213\321\205 IDE \320\270 \320\270\320\263\321\200\320\276\320\262\321\213\321\205 \321\201\320\265\321\200\320\262\320\265\321\200\320\276\320\262.\n                  </p>\n\n                  <div className=\"mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-[#FAFAFA] font-mono tabular-nums\">\n                    <span>\320\225\320\262\321\200\320\276\320\277\320\260: 14\342\200\22325 \320\274\321\201</span>\n                    <span aria-hidden=\"true\" className=\"text-[#A1A1AA]\">\302\267</span>\n                    <span>\320\241\320\250\320\220: 74 \320\274\321\201</span>\n                    <span aria-hidden=\"true\" className=\"text-[#A1A1AA]\">\302\267</span>\n                    <span>\320\220\320\267\320\270\321\217: 89 \320\274\321\201</span>\n                  </div>\n                </div>\n\n                {/* Dedicated Mobile Screenshot Placeholder Slot */}\n          