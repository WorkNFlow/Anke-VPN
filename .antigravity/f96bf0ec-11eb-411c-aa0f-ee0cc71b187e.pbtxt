            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // Phase 1 progress: t in [0, 1] from Hero (0) to Mantle Lock (1)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const rawT = Math.min(1, Math.max(0, scrollY / arrivalScrollY));"
