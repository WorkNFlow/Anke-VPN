            }
            lines {
              text: "        targetRotateX = shouldReduceMotion ? 0 : 4 * (1 - localP);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        targetRotateZ = shouldReduceMotion ? 0 : -2 * (1 - localP);"
