        instruction: "import React from \'react\';\nimport { Shield } from \'lucide-react\';\n\ninterface NavbarProps {\n  onOpenCheckout: (plan: \'subscription\' | \'custom\') => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({ onOpenCheckout }) => {\n  return (\n    <header className=\"sticky top-0 z-40 w-full border-b border-[#2A2A2A] bg-[#111111]/85 backdrop-blur-xl\">\n      <div className=\"mx-auto flex max-w-[1200px] items-center justify-between gap-8 px-4 py-4 sm:px-6\">\n        {/* Zone 1: Single-line Brand Wordmark */}\n        <a\n          href=\"#\"\n          className=\"flex items-center gap-2.5 text-lg font-bold tracking-tight text-[#FAFAFA] whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-[#FDE047]\"\n        >\n          <span className=\"flex h-7 w-7 items-center justify-center rounded-lg bg-[#FDE047] text-black\">\n            <Shield className=\"h-4 w-4 stroke-[2.2]\" />\n          </span>\n          <span>Anke VPN</span>\n        </a>\n\n        {/* Zone 2: 4\342\200\2235 single-line navigation links */}\n        <nav aria-label=\"\320\236\321\201\320\275\320\276\320\262\320\275\320\260\321\217 \320\275\320\260\320\262\320\270\320\263\320\260\321\206\320\270\321\217\" className=\"hidden md:flex items-center gap-7 text-sm font-medium text-[#A1A1AA]\">\n          <a\n            href=\"#platforms\"\n            className=\"hover:text-[#FAFAFA] transition-colors duration-150 whitespace-nowrap shrink-0 underline-offset-4 hover:underline\"\n          >\n            \320\237\320\273\320\260\321\202\321\204\320\276\321\200\320\274\321\213\n          </a>\n          <a\n            href=\"#features\"\n            className=\"hover:text-[#FAFAFA] transition-colors duration-150 whitespace-nowrap shrink-0 underline-offset-4 hover:underline\"\n          >\n            \320\237\321\200\320\265\320\270\320\274\321\203\321\211\320\265\321\201\321\202\320\262\320\260\n          </a>\n          <a\n            href=\"#benchmarks\"\n            className=\"hover:text-[#FAFAFA] transition-colors duration-150 whitespace-nowrap shrink-0 underline-offset-4 hover:underline\"\n          >\n            \320\230\320\275\321\204\321\200\320\260\321\201\321\202\321\200\321\203\320\272\321\202\321\203\321\200\320\260\n          </a>\n          <a\n            href=\"#pricing\"\n            className=\"hover:text-[#FAFAFA] transition-colors duration-150 whitespace-nowrap shrink-0 underline-offset-4 hover:underline\"\n          >\n            \320\242\320\260\321\200\320\270\321\204\321\213\n          </a>\n          <a\n            href=\"#guarantee\"\n            className=\"hover:text-[#FAFAFA] transition-colors duration-150 whitespace-nowrap shrink-0 underline-offset-4 hover:underline\"\n          >\n            \320\223\320\260\321\200\320\260\320\275\321\202\320\270\321\217\n          </a>\n        </nav>\n\n        {/* Zone 3: 1 Primary Action */}\n        <div className=\"flex items-center shrink-0\">\n          <button\n            type=\"button\"\n            onClick={() => onOpenCheckout(\'subscription\')}\n            className=\"tactile-btn rounded-lg bg-[#FDE047] px-4 py-2 text-xs sm:text-sm font-semibold text-black hover:bg-[#FDE047]/90 whitespace-nowrap shrink-0 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FDE047]\"\n          >\n            \320\232\321\203\320\277\320\270\321\202\321\214 \320\277\320\276\320\264\320\277\320\270\321\201\320\272\321\203\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/Navbar.tsx"
        }
        overwrite: true
      }
    }
