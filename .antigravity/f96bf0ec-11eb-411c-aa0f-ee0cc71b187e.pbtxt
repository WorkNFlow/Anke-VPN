              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (rawT < 1) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      // In Hero or flying along the parabola behind \"\320\224\320\276\321\201\321\202\321\203\320\277\320\275\320\276 \320\275\320\260 \320\262\321\201\320\265\321\205 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262\320\260\321\205\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
