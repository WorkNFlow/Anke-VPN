  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState } from \'react\';\nimport { motion } from \'motion/react\';\nimport { ArrowUpRight } from \'lucide-react\';\nimport { Navbar } from \'./components/Navbar\';\nimport { HeroMockup } from \'./components/HeroMockup\';\nimport { PlatformCards } from \'./components/PlatformCards\';\nimport { BentoFeatures } from \'./components/BentoFeatures\';\nimport { PricingSection } from \'./components/PricingSection\';\nimport { SupportChatWidget } from \'./components/SupportChatWidget\';\nimport { OFFICIAL_LINKS } from \'./data/vpnData\';\nimport { AnkeLogo } from \'./components/AnkeLogo\';\n\nexport default function App() {\n  const [chatOpenFromSupport, setChatOpenFromSupport] = useState(false);\n\n  return (\n    <div\n      id=\"top\"\n      className=\"min-h-[100dvh] bg-[#111111] text-[#FAFAFA] flex flex-col selection:bg-[#FDE047] selection:text-black\"\n    >\n      {/* Official 3-Zone Top Bar */}\n      <Navbar />\n\n      {/* Main Content */}\n      <main className=\"flex-1\">\n        {/* HERO SECTION \342\200\224 Exact Official Text & Choreographed Staggered Animations */}\n        <section className=\"relative overflow-hidden border-b border-[#2A2A2A] bg-structural-grid py-20 sm:py-28 lg:py-36\">\n          {/* Ambient radial yellow glow */}\n          <motion.div\n            aria-hidden=\"true\"\n            animate={{\n              opacity: [0.04, 0.08, 0.04],\n              scale: [1, 1.08, 1],\n            }}\n            transition={{ duration: 8, repeat: Infinity, ease: \'easeInOut\' }}\n            className=\"pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 h-[480px] w-[920px] rounded-full bg-[#FDE047] blur-[130px]\"\n          />\n\n          <div className=\"relative mx-auto max-w-[1200px] px-4 sm:px-6\">\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center\">\n              {/* Left Column: Staggered Reveal of Exact Official Hero Text */}\n              <div className=\"lg:col-span-6\">\n                <motion.h1\n                  initial={{ opacity: 0, y: 24, filter: \'blur(8px)\' }}\n                  animate={{ opacity: 1, y: 0, filter: \'blur(0px)\' }}\n                  transition={{\n                    duration: 0.65,\n                    ease: [0.16, 1, 0.3, 1],\n                  }}\n                  style={{ fontSize: \'clamp(2.5rem, 4.8vw, 4.25rem)\' }}\n                  className=\"font-bold tracking-tight text-[#FAFAFA] leading-[1.06] [text-wrap:balance]\"\n                >\n                  \320\221\321\213\321\201\321\202\321\200\320\276\320\265 \320\270{\' \'}\n                  <span className=\"text-[#FDE047]\">\320\277\321\200\320\270\320\262\320\260\321\202\320\275\320\276\320\265</span>\n                  <br />\n                  \321\201\320\276\320\265\320\264\320\270\320\275\320\265\320\275\320\270\320\265\n                </motion.h1>\n\n                <motion.p\n                  initial={{ opacity: 0, y: 20, filter: \'blur(6px)\' }}\n                  animate={{ opacity: 1, y: 0, filter: \'blur(0px)\' }}\n                  transition={{\n                    duration: 0.65,\n                    delay: 0.1,\n                    ease: [0.16, 1, 0.3, 1],\n                  }}\n                  className=\"mt-6 text-lg sm:text-xl text-[#A1A1AA] leading-relaxed\"\n                >\n                  \320\241\321\202\320\260\320\261\320\270\320\273\321\214\320\275\320\260\321\217 \321\200\320\260\320\261\320\276\321\202\320\260, \320\274\320\276\320\274\320\265\320\275\321\202\320\260\320\273\321\214\320\275\320\276\320\265\n                  <br className=\"hidden sm:inline\" /> \320\277\320\276\320\264\320\272\320\273\321\216\321\207\320\265\320\275\320\270\320\265\n                </motion.p>\n\n                {/* Primary Tactile CTA (\"\320\232\321\203\320\277\320\270\321\202\321\214 \320\277\320\276\320\264\320\277\320\270\321\201\320\272\321\203\") */}\n                <motion.div\n                  initial={{ opacity: 0, y: 20 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  transition={{\n                    duration: 0.6,\n                    delay: 0.2,\n                    ease: [0.16, 1, 0.3, 1],\n                  }}\n                  className=\"mt-9 flex flex-wrap items-center gap-4\"\n                >\n                  <motion.a\n                    href={OFFICIAL_LINKS.appLogin}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    whileHover={{ scale: 1.03 }}\n                    whileTap={{ scale: 0.97 }}\n                    className=\"group inline-flex items-center gap-3.5 rounded-full bg-[#FDE047] pl-7 pr-3 py-3.5 text-base font-bold text-black shadow-[0_0_35px_rgba(253,224,71,0.25)] transition-shadow hover:shadow-[0_0_50px_rgba(253,224,71,0.4)] whitespace-nowrap shrink-0\"\n                  >\n                    <span>\320\232\321\203\320\277\320\270\321\202\321\214 \320\277\320\276\320\264\320\277\320\270\321\201\320\272\321\203</span>\n                    <span className=\"flex h-9 w-9 items-center justify-center rounded-full bg-black/15 text-black transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5\">\n                      <ArrowUpRight className=\"h-5 w-5\" />\n                    </span>\n                  </motion.a>\n                </motion.div>\n              </div>\n\n              {/* Right Column: 3D Interactive Tilted Mockup & Official Anke Logo */}\n              <motion.div\n                initial={{ opacity: 0, y: 32, scale: 0.95 }}\n                animate={{ opacity: 1, y: 0, scale: 1 }}\n                transition={{\n                  duration: 0.75,\n                  delay: 0.15,\n                  ease: [0.16, 1, 0.3, 1],\n                }}\n                className=\"lg:col-span-6\"\n              >\n                <HeroMockup />\n              </motion.div>\n            </div>\n          </div>\n        </section>\n\n        {/* CROSS-PLATFORM DOWNLOAD SECTION (\"\320\224\320\276\321\201\321\202\321\203\320\277\320\275\320\276 \320\275\320\260 \320\262\321\201\320\265\321\205 \321\203\321\201\321\202\321\200\320\276\320\271\321\201\321\202\320\262\320\260\321\205\") */}\n        <PlatformCards />\n\n        {/* BENTO GRID FEATURES & OFFICIAL SERVER LIST */}\n        <BentoFeatures />\n\n        {/* PRICING PLANS, 15-DAY REFUND BANNER & SUPPORT */}\n        <PricingSection onOpenChat={() => setChatOpenFromSupport(true)} />\n      </main>\n\n      {/* OFFICIAL FOOTER */}\n      <footer className=\"bg-[#111111] py-12 text-xs text-[#A1A1AA]\">\n        <div className=\"mx-auto max-w-[1200px] px-4 sm:px-6\">\n          <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 pb-8 border-b border-[#2A2A2A]\">\n            <div className=\"flex items-center gap-3 text-sm font-bold text-[#FAFAFA]\">\n              <AnkeLogo className=\"h-6 w-auto\" />\n              <span>Anke</span>\n            </div>\n\n            <div className=\"flex flex-wrap items-center gap-6 text-xs sm:text-sm\">\n              <a\n                href={OFFICIAL_LINKS.pricingPage}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"hover:text-[#FAFAFA] transition-colors\"\n              >\n                \320\246\320\265\320\275\321\213\n              </a>\n              <a\n                href={OFFICIAL_LINKS.privacyPage}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"hover:text-[#FAFAFA] transition-colors\"\n              >\n                \320\237\320\276\320\273\320\270\321\202\320\270\320\272\320\260 \320\272\320\276\320\275\321\204\320\270\320\264\320\265\320\275\321\206\320\270\320\260\320\273\321\214\320\275\320\276\321\201\321\202\320\270\n     