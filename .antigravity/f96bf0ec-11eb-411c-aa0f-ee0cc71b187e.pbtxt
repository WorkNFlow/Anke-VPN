    command_line: "for f in se.png sweden.png es.png spain.png jp.png japan.png gb.png uk.png sg.png singapore.png; do code=$(curl -sL -w \"%{http_code}\" \"https://anke.dev/vpn/countries_icons/$f\" -o \"/tmp/flag_$f\"); if [ \"$code\" = \"200\" ]; then cp \"/tmp/flag_$f\" \"public/countries/$f\"; echo \"Downloaded $f\"; fi; done"
